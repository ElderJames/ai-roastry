@page "/prompt-edit"
@page "/prompt-edit/{Id}"
@using LY.LlmPool.Web.Services
@using LY.LlmPool.Web.Services.Tools
@using LY.LlmPool.Web.Services.Agents
@using LY.LlmPool.Web.Data.Entities
@using LY.LlmPool.Web.Models
@using LY.LlmPool.Web.Models.Tools
@using LY.LlmPool.Web.Components
@using LY.LlmPool.Web.Components.ChatHelpers
@using AntDesign
@using AntDesign.TableModels
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.AI
@using Microsoft.JSInterop
@using System.Text.RegularExpressions
@using AIChatMessage = Microsoft.Extensions.AI.ChatMessage
@using System.Text.Json
@inject LlmPoolService LlmPoolService
@inject IChatClientService ChatClientService
@inject PromptService PromptService
@inject ToolMetadataService ToolMetadataService
@inject ToolProviderService ToolProviderService
@inject PromptEnvironmentService PromptEnvironmentService
@inject MessageService _message
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<PromptEdit> Logger

<PageTitle>@(_editingPrompt.Id == null ? "New Prompt" : "Edit Prompt")</PageTitle>

<Row Gutter="16">
    <AntDesign.Col Span="12">
        <div class="prompt-edit-section">
            <Card>
                <TitleTemplate>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>Prompt Editor</div>
                        <div>
                            <Space>
                                <SpaceItem>
                                    <Button OnClick="GoBack">
                                        <Icon Type="arrow-left" />
                                        Back
                                    </Button>
                                </SpaceItem>
                                @if (!string.IsNullOrEmpty(_editingPrompt.Id))
                                {
                                    <SpaceItem>
                                        <Button OnClick="ShowHistory">
                                            <Icon Type="history" />
                                            History
                                        </Button>
                                    </SpaceItem>
                                }
                                <SpaceItem>
                                    <Button Type="@ButtonType.Primary" OnClick="SavePrompt">
                                        <Icon Type="save" />
                                        Save
                                    </Button>
                                </SpaceItem>
                            </Space>
                        </div>
                    </div>
                </TitleTemplate>
                <ChildContent>
                    <Form Model="@_editingPrompt"
                          LabelCol="new ColLayoutParam { Span = 4 }"
                          WrapperCol="new ColLayoutParam { Span = 20 }">
                        <FormItem Label="Name" Required>
                            <Input @bind-Value="@_editingPrompt.Name" />
                        </FormItem>
                        <FormItem Label="Description">
                            <TextArea @bind-Value="@_editingPrompt.Description" />
                        </FormItem>
                        <FormItem Label="Content" Required>
                            <TextArea @bind-Value="@_editingPrompt.Content" Rows="15" OnChange="OnPromptContentChanged" />
                            <div style="margin-top: 8px;">
                                <Collapse>
                                    <Panel Header="💡 环境变量支持" Key="env-vars">
                                        <div style="color: #8c8c8c; font-size: 12px; line-height: 1.8;">
                                            <Text Strong>支持的环境变量:</Text>
                                            <ul style="margin: 8px 0; padding-left: 20px;">
                                                <li><Text Code>@@datetime</Text> - 完整日期时间 (2024-10-13 15:30:45 星期日 UTC+08:00)</li>
                                                <li><Text Code>@@date</Text> - 当前日期 (2024-10-13)</li>
                                                <li><Text Code>@@time</Text> - 当前时间 (15:30:45)</li>
                                                <li><Text Code>@@weekday</Text> - 星期几 (星期日)</li>
                                                <li><Text Code>@@timezone</Text> - 时区 (+08:00)</li>
                                                <li><Text Code>@@user</Text> - 当前用户名</li>
                                                <li><Text Code>@@guid</Text> - 生成新的 GUID</li>
                                                <li><Text Code>@@random</Text> - 随机数 (0-100)</li>
                                            </ul>
                                            <Text Strong>自定义格式:</Text>
                                            <ul style="margin: 8px 0; padding-left: 20px;">
                                                <li><Text Code>@@datetime:yyyy/MM/dd</Text> - 自定义日期格式</li>
                                                <li><Text Code>@@weekday:en</Text> - 英文星期 (Sunday)</li>
                                                <li><Text Code>@@random:1000</Text> - 0-1000 的随机数</li>
                                            </ul>
                                        </div>
                                    </Panel>
                                </Collapse>
                            </div>
                        </FormItem>
                        <FormItem Label="Model Parameters">
                            <Input @bind-Value="@_editingPrompt.ModelParameters" 
                                   Placeholder="temp=0.7,tokens=100"
                                   Style="width: 100%;">
                                <Prefix>⚙️</Prefix>
                            </Input>
                            <div style="margin-top: 4px; color: #8c8c8c; font-size: 12px;">
                                <Icon Type="info-circle" Style="margin-right: 4px;" />
                                支持参数: <Text Code>temp/temperature</Text>, <Text Code>tokens/max_tokens</Text>. 
                                示例: <Text Code>temp=0,tokens=500</Text> (确定性输出)
                            </div>
                        </FormItem>
                        <FormItem Label="Tools">
                            <TreeSelect TItemValue="string" TItem="string"
                                        @bind-Values="@_selectedToolIds"
                                        Multiple
                                        TreeCheckable
                                        Placeholder="选择要绑定的工具"
                                        AllowClear
                                        EnableSearch
                                        TreeDefaultExpandAll
                                        Style="width: 100%;">
                                <ChildContent>
                                    @foreach (var node in _toolTreeData)
                                    {
                                        <TreeNode TItem="string"
                                                  Key="@node.Key" 
                                                  Title="@node.Title" 
                                                  Selectable="false"
                                                  Checkable="true">
                                            @foreach (var child in node.Children)
                                            {
                                                <TreeNode TItem="string"
                                                          Key="@child.Key" 
                                                          Title="@child.Title"
                                                          Selectable="true"
                                                          Checkable="true" />
                                            }
                                        </TreeNode>
                                    }
                                </ChildContent>
                            </TreeSelect>
                            <div style="margin-top: 4px; color: #8c8c8c; font-size: 12px;">
                                <Icon Type="info-circle" Style="margin-right: 4px;" />
                                选择此 Prompt 可以调用的工具（按分类展示：App Tools 或 MCP Servers）
                            </div>
                        </FormItem>
                        @if (_promptParameters.Any())
                        {
                            <FormItem Label="Parameters">
                                 <Collapse DefaultActiveKey="@(new[] { "1" })"  Animation>
                                    <Panel Header="参数设置" Key="1">
                                        @foreach (var param in _promptParameters)
                                        {
                                            <div style="margin-bottom: 8px;display: flex; flex-direction: column; gap: 4px;">
                                                <div style="display: flex; align-items: center;">
                                                    <Text Strong="true" style="margin-right: 8px;">@(param.Name):</Text>
                                                    @if (param.IsRequired)
                                                    {
                                                        <Tag Color="@("red")" Style="margin-right: 8px;">必填</Tag>
                                                    }
                                                    @if (!string.IsNullOrEmpty(param.Description))
                                                    {
                                                        <span style="font-size: 12px; color: rgba(0, 0, 0, 0.45);">(@param.Description)</span>
                                                    }
                                                </div>
                                                <TextArea Rows=1 
                                                          AutoSize=true 
                                                          Value="@(_parameterValues.TryGetValue(param.Name, out var val) ? val : "")"
                                                          ValueChanged="@(newValue => OnParameterValueChanged(param.Name, newValue))"
                                                          Placeholder="@($"请输入{param.Name}的值" + (param.IsRequired ? " (必填)" : ""))" />
                                            </div>
                                        }
                                    </Panel>
                                 </Collapse>
                            </FormItem>
                        }                 
                        @if (_editingPrompt.Version > 0)
                        {
                            <FormItem Label="Version">
                                <Text>@_editingPrompt.Version</Text>
                            </FormItem>
                        }
                    </Form>
                </ChildContent>
            </Card>

            <Card Class="mt-3">
                <TitleTemplate>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <Icon Type="message" />
                            <span style="margin-left: 8px;">Test Input</span>
                        </div>
                        <div>
                            <Space>
                                @if (_testConfigs.Any(c => c.ChatHistory.Any()))
                                {
                                    <SpaceItem>
                                        <Popconfirm Title="确定要清空所有配置的聊天历史吗？"
                                                   OkText="确定"
                                                   CancelText="取消"
                                                   OnConfirm="ClearAllChatHistory">
                                            <Button Danger Size="@ButtonSize.Small" Icon="delete">
                                                清空所有历史
                                            </Button>
                                        </Popconfirm>
                                    </SpaceItem>
                                }
                                <SpaceItem>
                                    @if (_testLoading)
                                    {
                                        <Button Type="@ButtonType.Default" 
                                                Danger
                                                OnClick="StopTests" 
                                                Icon="stop">
                                            Stop Tests
                                        </Button>
                                    }
                                    else
                                    {
                                        <Button Type="@ButtonType.Primary" 
                                                OnClick="RunTests" 
                                                Icon="play-circle">
                                            Run Tests (Ctrl+Enter)
                                        </Button>
                                    }
                                </SpaceItem>
                            </Space>
                        </div>
                    </div>
                </TitleTemplate>
                <ChildContent>
                    <TextArea @bind-Value="@_testContent" 
                             @ref="_testInputRef"
                             Rows="5" 
                             Placeholder="输入测试消息... (Ctrl+Enter 发送, Esc 清空)"
                             Disabled="@_testLoading" 
                             ShowCount
                             MaxLength="2000"
                             @onkeydown="HandleTestInputKeyDown" />
                </ChildContent>
            </Card>
        </div>
    </AntDesign.Col>
    <AntDesign.Col Span="12">
        <Card>
            <TitleTemplate>
                <div class="d-flex justify-content-between align-items-center">
                    <div>Test Configurations</div>
                    <div>
                        <Button Type="@ButtonType.Primary" OnClick="AddTestConfig">
                            <Icon Type="plus" />
                            Add Configuration
                        </Button>
                    </div>
                </div>
            </TitleTemplate>
            <ChildContent>
                <div class="test-configs-list @(_testConfigs.Count == 1 ? "single-config" : "")">
                    @foreach (var config in _testConfigs)
                    {
                        <Card Size="@CardSize.Small" Class="mb-2">
                            <TitleTemplate>
                                <Space Size="@SpaceSize.Small" Wrap>
                                    <SpaceItem>
                                        <Icon Type="@(config.Type == "Model" ? "robot" : "api")" />
                                    </SpaceItem>
                                    <SpaceItem>
                                        <Select TItem="string"
                                                TItemValue="string"
                                                @bind-Value="@config.Type"
                                                Style="width: 100px;"
                                                Size="@InputSize.Small"
                                                Disabled="@_testLoading">
                                            <SelectOptions>
                                                <SelectOption Value="@("Model")" Label="Model" />
                                                <SelectOption Value="@("Endpoint")" Label="Endpoint" />
                                            </SelectOptions>
                                        </Select>
                                    </SpaceItem>
                                    <SpaceItem>
                                        @if (config.Type == "Model")
                                        {
                                            <Select TItem="LlmConfig"
                                                    TItemValue="string"
                                                    DataSource="@_availableConfigs"
                                                    @bind-Value="@config.ConfigId"
                                                    ValueName="@nameof(LlmConfig.Id)"
                                                    LabelName="@nameof(LlmConfig.Name)"
                                                    Style="width: 180px;"
                                                    Size="@InputSize.Small"
                                                    Disabled="@_testLoading" />
                                        }
                                        else
                                        {
                                            <Select TItem="LlmEndpoint"
                                                    TItemValue="string"
                                                    DataSource="@_availableEndpoints"
                                                    @bind-Value="@config.ConfigId"
                                                    ValueName="@nameof(LlmEndpoint.Id)"
                                                    LabelName="@nameof(LlmEndpoint.Name)"
                                                    Style="width: 180px;"
                                                    Size="@InputSize.Small"
                                                    Disabled="@_testLoading" />
                                        }
                                    </SpaceItem>
                                    <SpaceItem>
                                        @if (config.ChatHistory.Any())
                                        {
                                            <Badge Count="@config.ChatHistory.Count" ShowZero="false">
                                                <Button Size="@ButtonSize.Small" 
                                                        OnClick="() => ShowChatHistory(config)" 
                                                        Disabled="@_testLoading">
                                                    <Icon Type="history" /> 查看历史
                                                </Button>
                                            </Badge>
                                        }
                                        else
                                        {
                                            <Button Size="@ButtonSize.Small" 
                                                    OnClick="() => ShowChatHistory(config)" 
                                                    Disabled="@_testLoading">
                                                <Icon Type="history" /> 查看历史
                                            </Button>
                                        }
                                    </SpaceItem>
                                    @if (config.ChatHistory.Any())
                                    {
                                        <SpaceItem>
                                            <Popconfirm Title="确定要清空该配置的聊天历史吗？"
                                                       OkText="确定"
                                                       CancelText="取消"
                                                       OnConfirm="() => ClearChatHistory(config)">
                                                <Button Size="@ButtonSize.Small" 
                                                        Danger
                                                        Icon="clear"
                                                        Disabled="@_testLoading">
                                                    清空历史
                                                </Button>
                                            </Popconfirm>
                                        </SpaceItem>
                                    }
                                    <SpaceItem>
                                        <Button Danger 
                                                Size="@ButtonSize.Small" 
                                                OnClick="() => RemoveTestConfig(config)" 
                                                Disabled="@_testLoading">
                                            <Icon Type="delete" /> 删除配置
                                        </Button>
                                    </SpaceItem>
                                </Space>
                            </TitleTemplate>
                            <ChildContent>
                                @* 展示历史记录 *@
                                @if (config.ChatHistory.Any())
                                {
                                    <div class="chat-history-section" id="chat-history-@(config.ConfigId)">
                                        <div class="chat-history-header-inline">
                                            <Tag Color="TagColor.Blue">
                                                <Icon Type="history" /> 对话历史 (@config.ChatHistory.Count 条消息)
                                            </Tag>
                                        </div>
                                        
                                        @{
                                            var messageIndex = 0;
                                            var userMessageCount = 0;
                                        }
                                        @foreach (var msg in config.ChatHistory)
                                        {
                                            messageIndex++;
                                            var roleValue = msg.Role.Value;
                                            if (roleValue == "user")
                                            {
                                                userMessageCount++;
                                            }
                                            
                                            <div class="chat-message-compact @roleValue">
                                                <div class="message-meta">
                                                    <Tag Color="@(roleValue == "user" ? "blue" : roleValue == "system" ? "purple" : roleValue == "tool" ? "orange" : "green")" >
                                                        @if (roleValue == "user")
                                                        {
                                                            <span>👤 用户 #@userMessageCount</span>
                                                        }
                                                        else if (roleValue == "system")
                                                        {
                                                            <span>⚙️ 系统</span>
                                                        }
                                                        else if (roleValue == "tool")
                                                        {
                                                            <span>🔧 工具</span>
                                                        }
                                                        else
                                                        {
                                                            <span>🤖 助手</span>
                                                        }
                                                    </Tag>
                                                </div>
                                                
                                                <div class="message-body-compact">
                                                    @if (msg.Contents != null && msg.Contents.Any())
                                                    {
                                                        var isLastMessage = msg == config.ChatHistory.LastOrDefault();
                                                        var isAssistantStreaming = isLastMessage && config.IsStreaming && roleValue == "assistant";
                                                        
                                                        // 🔑 收集工具调用和结果，按 CallId 配对
                                                        var toolCalls = msg.Contents.OfType<Microsoft.Extensions.AI.FunctionCallContent>().ToList();
                                                        var toolResults = msg.Contents.OfType<Microsoft.Extensions.AI.FunctionResultContent>().ToDictionary(r => r.CallId);
                                                        var processedCallIds = new HashSet<string>();
                                                       
                                                        @foreach (var content in msg.Contents)
                                                        {
                                                            @if (content is Microsoft.Extensions.AI.TextContent textContent)
                                                            {
                                                                <div class="text-content-compact">
                                                                    <pre>
                                                                        @textContent.Text
                                                                        @if (isAssistantStreaming && content == msg.Contents.LastOrDefault())
                                                                        {
                                                                            <span class="cursor-effect"></span>
                                                                        }
                                                                    </pre>
                                                                </div>
                                                            }
                                                            else if (content is Microsoft.Extensions.AI.FunctionCallContent functionCall)
                                                            {
                                                                // 避免重复处理
                                                                if (processedCallIds.Contains(functionCall.CallId))
                                                                {
                                                                    continue;
                                                                }
                                                                processedCallIds.Add(functionCall.CallId);
                                                                
                                                                // 查找对应的结果
                                                                var hasResult = toolResults.TryGetValue(functionCall.CallId, out var functionResult);
                                                                
                                                                <div class="tool-call-card">
                                                                    @* 工具调用头部 *@
                                                                    <div class="tool-call-header">
                                                                        <Tag Color="TagColor.Orange">🔧 @functionCall.Name</Tag>
                                                                        @if (hasResult)
                                                                        {
                                                                            @if (functionResult!.Exception == null)
                                                                            {
                                                                                <Tag Color="TagColor.Green">✓ 成功</Tag>
                                                                            }
                                                                            else
                                                                            {
                                                                                <Tag Color="TagColor.Red">✗ 失败</Tag>
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            <Tag Color="TagColor.Blue">⏳ 执行中...</Tag>
                                                                        }
                                                                    </div>
                                                                    
                                                                    @* 工具参数 *@
                                                                    <div class="tool-section">
                                                                        <div class="tool-section-title">📥 参数</div>
                                                                        <div class="tool-section-content">
                                                                            <pre>@(functionCall.Arguments != null && functionCall.Arguments.Any() ? ToJson(functionCall.Arguments) : "{}")</pre>
                                                                        </div>
                                                                    </div>
                                                                    
                                                                    @* 工具结果 *@
                                                                    @if (hasResult)
                                                                    {
                                                                        @if (functionResult!.Exception == null && functionResult.Result != null)
                                                                        {
                                                                            <div class="tool-section">
                                                                                <div class="tool-section-title">📤 返回结果</div>
                                                                                <div class="tool-section-content tool-result-success">
                                                                                    <pre>@functionResult.Result.ToString()</pre>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                        else if (functionResult!.Exception != null)
                                                                        {
                                                                            <div class="tool-section">
                                                                                <div class="tool-section-title">❌ 执行错误</div>
                                                                                <div class="tool-section-content tool-result-error">
                                                                                    <pre>@functionResult.Exception.Message</pre>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                            else if (content is Microsoft.Extensions.AI.FunctionResultContent resultOnly)
                                                            {
                                                                // 如果结果没有对应的调用（不应该发生，但作为后备）
                                                                if (!processedCallIds.Contains(resultOnly.CallId))
                                                                {
                                                                    <div class="tool-call-card">
                                                                        <div class="tool-call-header">
                                                                            <Tag Color="TagColor.Green">✓ 工具结果: @resultOnly.CallId</Tag>
                                                                        </div>
                                                                        @if (resultOnly.Result != null)
                                                                        {
                                                                            <div class="tool-section">
                                                                                <div class="tool-section-content tool-result-success">
                                                                                    <pre>@resultOnly.Result.ToString()</pre>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            }
                                                        }
                                                    }
                                                    else if (!string.IsNullOrEmpty(msg.Text))
                                                    {
                                                        <div class="text-content-compact">
                                                            <pre>@msg.Text</pre>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            
                                @* 错误信息 *@
                                @if (config.TestResult != null && !config.TestResult.Success)
                                {
                                    <Alert Type="@AlertType.Error" Message="@config.TestResult.Error" />
                                }
                                
                                @* 空状态：没有历史记录且没有正在流式传输 *@
                                @if (!config.ChatHistory.Any() && !config.IsStreaming)
                                {
                                    <Empty Description="@("暂无对话记录")" Simple />
                                }
                            </ChildContent>
                        </Card>
                    }
                </div>
            </ChildContent>
        </Card>
    </AntDesign.Col>
</Row>

<Drawer Title="@("Prompt History")"
        Visible="@_showHistoryDrawer"
        Width="800"
        OnClose="CloseHistoryDrawer">
    <Table TItem="LlmPromptHistory"
           DataSource="@_promptHistory"
           Loading="@_historyLoading"
           ExpandIconColumnIndex="1">
        <ChildContent>
            <PropertyColumn Property="c=>c.Version" Title="Version" />
            <PropertyColumn Property="c=>c.BasedOnVersion" Title="Based On Version" />
            <PropertyColumn Property="c=>c.CreateTime" Title="Create Time" Format="yyyy-MM-dd HH:mm:ss" />
            <Column Title="Content" TData="string">
                <div style="max-height: 100px; overflow: hidden; text-overflow: ellipsis;">
                    @context.Content
                </div>
            </Column>
            <ActionColumn>
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="() => LoadHistoryVersion(context)">
                            Load
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="Are you sure to delete this history record?"
                                   OkText="Yes"
                                   CancelText="No"
                                   OnConfirm="() => DeleteHistoryRecord(context)">
                            <Button Danger>
                                <Icon Type="delete" />
                                Delete
                            </Button>
                        </Popconfirm>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </ChildContent>
        <ExpandTemplate Context="expandedContext">
            <div class="history-test-configs">
                <Divider Orientation="DividerOrientation.Left">Test Configurations</Divider>
                @if (expandedContext.Data.TestConfigs?.Any() == true)
                {
                    <Table TItem="TestConfigRecord"
                           DataSource="@expandedContext.Data.TestConfigs"
                           Size="TableSize.Small"
                           Bordered>
                        <ChildContent>
                            <PropertyColumn Property="c=>c.Type" Title="Type" />
                            <PropertyColumn Property="c=>c.ConfigName" Title="Config Name" />
                            <PropertyColumn Property="c=>c.ModelType" Title="Model Type" />
                            <PropertyColumn Property="c=>c.Parameters" Title="Parameters" />
                            <Column Title="Test Input" TData="string">
                                @if (!string.IsNullOrEmpty(context.TestInput))
                                {
                                    <div class="history-response">
                                        <pre>@context.TestInput</pre>
                                    </div>
                                }
                            </Column>
                            <Column Title="Result" TData="TestConfigRecord">
                                <div>
                                    @if (context.Success)
                                    {
                                        @* 优先显示 ResponseSegments，如果没有则显示 Response *@
                                        @if (context.ResponseSegments?.Any() == true)
                                        {
                                            <div class="history-response-segments">
                                                @foreach (var segment in context.ResponseSegments)
                                                {
                                                    @if (segment.Type == ResponseSegmentType.Text)
                                                    {
                                                        <div class="history-text-segment">
                                                            <pre>@segment.Text</pre>
                                                        </div>
                                                    }
                                                    else if (segment.Type == ResponseSegmentType.ToolCalls && segment.ToolCalls != null)
                                                    {
                                                        @foreach (var toolCall in segment.ToolCalls)
                                                        {
                                                            <div class="history-tool-call-compact">
                                                                <div style="display: flex; align-items: center; gap: 8px; padding: 4px 8px; background: #f0f0f0; border-radius: 3px; margin: 4px 0;">
                                                                    <span style="color: #1890ff;">🔧</span>
                                                                    <strong>@toolCall.ToolName</strong>
                                                                    <span style="color: @(toolCall.Success ? "#52c41a" : "#ff4d4f");">
                                                                        @(toolCall.Success ? "✓" : "✗")
                                                                    </span>
                                                                </div>
                                                                <details style="margin-left: 20px;">
                                                                    <summary style="cursor: pointer; color: #1890ff;">查看详情</summary>
                                                                    <div style="margin-top: 4px; padding: 8px; background: #fafafa; border-radius: 3px;">
                                                                        <div style="margin-bottom: 8px;">
                                                                            <strong>Input:</strong>
                                                                            <pre style="margin: 4px 0; font-size: 12px;">@(string.IsNullOrEmpty(toolCall.Arguments) ? "{}" : toolCall.Arguments)</pre>
                                                                        </div>
                                                                        @if (!string.IsNullOrEmpty(toolCall.Result))
                                                                        {
                                                                            <div style="margin-bottom: 8px;">
                                                                                <strong>Output:</strong>
                                                                                <pre style="margin: 4px 0; font-size: 12px;">@toolCall.Result</pre>
                                                                            </div>
                                                                        }
                                                                        @if (!string.IsNullOrEmpty(toolCall.Error))
                                                                        {
                                                                            <div>
                                                                                <strong style="color: #ff4d4f;">Error:</strong>
                                                                                <pre style="margin: 4px 0; font-size: 12px; color: #ff4d4f;">@toolCall.Error</pre>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </details>
                                                            </div>
                                                        }
                                                    }
                                                }
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(context.Response))
                                        {
                                            <div class="history-response">
                                                <pre>@context.Response</pre>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <Tag Color="TagColor.Red">@context.Error</Tag>
                                    }
                                </div>
                            </Column>
                        </ChildContent>
                    </Table>
                }
                else
                {
                    <Empty Description="@("No test configurations")" />
                }
            </div>
        </ExpandTemplate>
    </Table>
</Drawer>

<Drawer Title="@(_selectedConfigForHistory != null ? GetConfigName(_selectedConfigForHistory) + " - 聊天历史" : "聊天历史")"
        Visible="@_showChatHistoryDrawer"
        Width="700"
        OnClose="CloseChatHistoryDrawer">
    @if (_selectedConfigForHistory != null)
    {
        <div class="chat-history-drawer-content">
            @if (_selectedConfigForHistory.ChatHistory.Any())
            {
                <div class="chat-history-header">
                    <div style="margin-bottom: 16px;">
                        <Space>
                            <SpaceItem>
                                <Statistic Title="总消息数" Value="@_selectedConfigForHistory.ChatHistory.Count" />
                            </SpaceItem>
                            <SpaceItem>
                                <Statistic Title="用户消息" Value="@_selectedConfigForHistory.ChatHistory.Count(m => m.Role.Value == "user")" ValueStyle="color: #1890ff;" />
                            </SpaceItem>
                            <SpaceItem>
                                <Statistic Title="助手回复" Value="@_selectedConfigForHistory.ChatHistory.Count(m => m.Role.Value == "assistant")" ValueStyle="color: #52c41a;" />
                            </SpaceItem>
                            <SpaceItem>
                                <Statistic Title="工具调用" 
                                          Value="@_selectedConfigForHistory.ChatHistory.Count(m => m.Contents != null && m.Contents.Any(c => c is Microsoft.Extensions.AI.FunctionCallContent))" 
                                          ValueStyle="color: #fa8c16;" />
                            </SpaceItem>
                        </Space>
                    </div>
                    <Alert Type="@AlertType.Info" 
                           Message="多轮对话模式" 
                           Description="当前配置已启用历史消息保留，所有消息将在下次测试时继续使用。"
                           ShowIcon="true"
                           Closable />
                </div>
                <div class="chat-history-messages">
                    @{
                        var messageIndex = 0;
                        var userMessageCount = 0;
                    }
                    @foreach (var msg in _selectedConfigForHistory.ChatHistory)
                    {
                        messageIndex++;
                        var roleValue = msg.Role.Value;
                        if (roleValue == "user")
                        {
                            userMessageCount++;
                        }
                        
                        <div class="chat-message-item @roleValue">
                            <div class="message-header">
                                <Space Size="@SpaceSize.Small">
                                    <SpaceItem>
                                        <Tag Color="@(roleValue == "user" ? "blue" : roleValue == "system" ? "purple" : roleValue == "tool" ? "orange" : "green")">
                                            @if (roleValue == "user")
                                            {
                                                <span>👤 用户 #@userMessageCount</span>
                                            }
                                            else if (roleValue == "system")
                                            {
                                                <span>⚙️ 系统</span>
                                            }
                                            else if (roleValue == "tool")
                                            {
                                                <span>🔧 工具结果</span>
                                            }
                                            else
                                            {
                                                <span>🤖 助手</span>
                                            }
                                        </Tag>
                                    </SpaceItem>
                                    <SpaceItem>
                                        <Text Type="@TextElementType.Secondary" Style="font-size: 12px;">
                                            #@messageIndex
                                        </Text>
                                    </SpaceItem>
                                    @* 显示工具调用标记 *@
                                    @if (msg.Contents != null && msg.Contents.Any(c => c is Microsoft.Extensions.AI.FunctionCallContent))
                                    {
                                        var toolCallsCount = msg.Contents.Count(c => c is Microsoft.Extensions.AI.FunctionCallContent);
                                        <SpaceItem>
                                            <Tag Color="@("orange")" Style="font-size: 11px;">
                                                🔧 @toolCallsCount 个工具
                                            </Tag>
                                        </SpaceItem>
                                    }
                                    @if (msg.Contents != null && msg.Contents.Any(c => c is Microsoft.Extensions.AI.FunctionResultContent))
                                    {
                                        var resultsCount = msg.Contents.Count(c => c is Microsoft.Extensions.AI.FunctionResultContent);
                                        <SpaceItem>
                                            <Tag Color="@("green")" Style="font-size: 11px;">
                                                ✓ @resultsCount 个结果
                                            </Tag>
                                        </SpaceItem>
                                    }
                                </Space>
                            </div>
                            <div class="message-content">
                                @* 优先显示 Contents 中的所有段落 *@
                                @if (msg.Contents != null && msg.Contents.Any())
                                {
                                    var segmentIndex = 0;
                                    @foreach (var content in msg.Contents)
                                    {
                                        segmentIndex++;
                                        <div class="message-segment">
                                            <div style="font-size: 11px; color: #999; margin-bottom: 4px;">
                                                Segment #@segmentIndex
                                            </div>
                                            
                                            @if (content is Microsoft.Extensions.AI.TextContent textContent)
                                            {
                                                <div class="segment-text">
                                                    <div style="color: #666; font-size: 12px; margin-bottom: 4px;">
                                                        <Icon Type="file-text" /> 文本内容
                                                    </div>
                                                    <pre>@textContent.Text</pre>
                                                </div>
                                            }
                                            else if (content is Microsoft.Extensions.AI.FunctionCallContent functionCall)
                                            {
                                                <div class="history-tool-call">
                                                    <div class="tool-call-header">
                                                        <Icon Type="api" />
                                                        <strong>工具调用: @functionCall.Name</strong>
                                                        @if (!string.IsNullOrEmpty(functionCall.CallId))
                                                        {
                                                            <span style="font-size: 12px; margin-left: 8px; color: #999;">
                                                                ID: @functionCall.CallId
                                                            </span>
                                                        }
                                                    </div>
                                                    <div class="tool-call-section">
                                                        <div style="color: #999; font-size: 12px; margin-bottom: 4px;">参数 (INPUT)</div>
                                                        <pre>@(functionCall.Arguments != null && functionCall.Arguments.Any() ? ToJson(functionCall.Arguments) : "{}")</pre>
                                                    </div>
                                                </div>
                                            }
                                            else if (content is Microsoft.Extensions.AI.FunctionResultContent functionResult)
                                            {
                                                <div class="history-tool-result">
                                                    <div class="tool-result-header">
                                                        <Icon Type="check-circle" />
                                                        <strong>工具结果</strong>
                                                        @if (!string.IsNullOrEmpty(functionResult.CallId))
                                                        {
                                                            <span style="font-size: 12px; margin-left: 8px; color: #999;">
                                                                ID: @functionResult.CallId
                                                            </span>
                                                        }
                                                    </div>
                                                    @if (functionResult.Result != null)
                                                    {
                                                        <div class="tool-result-section">
                                                            <div style="color: #999; font-size: 12px; margin-bottom: 4px;">返回值 (OUTPUT)</div>
                                                            <pre>@functionResult.Result.ToString()</pre>
                                                        </div>
                                                    }
                                                    @if (functionResult.Exception != null)
                                                    {
                                                        <div class="tool-error-section">
                                                            <div style="color: #ff4d4f; font-size: 12px; margin-bottom: 4px;">
                                                                <Icon Type="exclamation-circle" /> 错误 (ERROR)
                                                            </div>
                                                            <pre>@functionResult.Exception.Message</pre>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else if (content is Microsoft.Extensions.AI.DataContent dataContent)
                                            {
                                                <div class="segment-data">
                                                    <div style="color: #666; font-size: 12px; margin-bottom: 4px;">
                                                        <Icon Type="file" /> 数据内容
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(dataContent.Uri))
                                                    {
                                                        <div>URI: @dataContent.Uri</div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(dataContent.MediaType))
                                                    {
                                                        <div style="color: #999; font-size: 11px;">
                                                            MediaType: @dataContent.MediaType
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="segment-unknown">
                                                    <div style="color: #999; font-size: 12px;">
                                                        <Icon Type="question-circle" /> 
                                                        未知内容类型: @content.GetType().Name
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else if (!string.IsNullOrEmpty(msg.Text))
                                {
                                    @* 如果没有 Contents,显示 Text (兼容旧格式) *@
                                    <div class="message-segment">
                                        <div style="color: #666; font-size: 12px; margin-bottom: 4px;">
                                            <Icon Type="file-text" /> 文本内容
                                        </div>
                                        <pre>@msg.Text</pre>
                                    </div>
                                }
                                else
                                {
                                    <div style="color: #999; font-style: italic;">
                                        (空消息)
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <Empty Description="@("暂无聊天历史")" />
            }
        </div>
    }
</Drawer>

