    private async Task SavePrompt()
    {
        if (string.IsNullOrWhiteSpace(_editingPrompt.Name) || string.IsNullOrWhiteSpace(_editingPrompt.Content))
        {
            _message.Error("Please fill in all required fields");
            return;
        }

        try
        {
            if (_editingPrompt.Id == null)
            {
                await PromptService.CreatePromptAsync(_editingPrompt);
                _message.Success("Prompt created successfully");
            }
            else
            {
                await PromptService.UpdatePromptAsync(_editingPrompt);
                _message.Success("Prompt updated successfully");
            }

            // Save current state to history
            var history = new LlmPromptHistory
            {
                PromptId = _editingPrompt.Id ?? throw new Exception("Prompt ID is null"),
                Content = _editingPrompt.Content,
                BasedOnVersion = _editingPrompt.Version,
                ModelParameters = _editingPrompt.ModelParameters,
                TestConfigs = _testConfigs.Select(c => new TestConfigRecord
                {
                    Type = c.Type,
                    ConfigId = c.ConfigId,
                    Parameters = c.Parameters,
                    Success = c.TestResult?.Success ?? false,
                    // 从 Segments 中提取所有文本内容
                    Response = c.TestResult?.Segments
                        .Where(s => s.Type == ResponseSegmentType.Text)
                        .Select(s => s.Text)
                        .Where(t => !string.IsNullOrEmpty(t))
                        .DefaultIfEmpty(string.Empty)
                        .Aggregate((a, b) => a + b),
                    Error = c.TestResult?.Error,
                    ConfigName = c.Type == "Model" 
                        ? _availableConfigs.FirstOrDefault(m => m.Id == c.ConfigId)?.Name 
                        : _availableEndpoints.FirstOrDefault(e => e.Id == c.ConfigId)?.Name,
                    ModelType = c.Type == "Model"
                        ? _availableConfigs.FirstOrDefault(m => m.Id == c.ConfigId)?.ModelType?.Name
                        : null,
                    ParameterValues = new Dictionary<string, string>(_parameterValues)
                }).ToList()
            };

            await PromptService.SavePromptHistoryAsync(history);
            _message.Success("History saved successfully");

            // Save tool bindings
            await SavePromptToolsAsync();

            // 清除草稿
            await ClearDraftAsync();

            NavigationManager.NavigateTo("/prompt-list");
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to save prompt: {ex.Message}");
        }
    }

    private async Task SavePromptToolsAsync()
    {
        if (string.IsNullOrEmpty(_editingPrompt.Id))
            return;

        try
        {
            Logger.LogInformation("Saving {Count} selected tools for Prompt {PromptId}: {Tools}", 
                _selectedToolIds.Count(), _editingPrompt.Id, string.Join(", ", _selectedToolIds));

            var promptTools = _selectedToolIds.Select(toolId =>
            {
                // toolId 格式: "App:appId" 或 "MCP:serverId:toolName"
                var parts = toolId.Split(':', 2);
                if (parts.Length != 2)
                {
                    Logger.LogWarning("Invalid tool ID format: {ToolId}", toolId);
                    return null;
                }

                // Parse ToolType: "App" -> Internal, "MCP" -> Mcp
                var toolTypeStr = parts[0];
                var toolType = toolTypeStr.Equals("App", StringComparison.OrdinalIgnoreCase) 
                    ? ToolType.Internal 
                    : ToolType.Mcp;

                // parts[1] 对于 App 是 appId, 对于 MCP 是 "serverId:toolName"
                var promptTool = new PromptTool
                {
                    PromptId = _editingPrompt.Id,
                    ToolId = parts[1], // 直接使用 parts[1],对于 MCP 是 "serverId:toolName"
                    ToolType = toolType
                };

                return promptTool;
            })
            .Where(pt => pt != null)
            .Cast<PromptTool>()
            .ToList();

            await PromptService.SetPromptToolsAsync(_editingPrompt.Id, promptTools);
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to save prompt tools: {ex.Message}");
            Logger.LogError(ex, "Error saving prompt tools for {PromptId}", _editingPrompt.Id);
        }
    }

