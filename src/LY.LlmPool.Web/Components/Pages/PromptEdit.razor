<Drawer Title="@("Prompt History")"
        Visible="@_showHistoryDrawer"
        Width="800"
        OnClose="CloseHistoryDrawer">
    <Table TItem="LlmPromptHistory"
           DataSource="@_promptHistory"
           Loading="@_historyLoading"
           ExpandIconColumnIndex="1">
        <ChildContent>
            <PropertyColumn Property="c=>c.Version" Title="Version" />
            <PropertyColumn Property="c=>c.BasedOnVersion" Title="Based On Version" />
            <PropertyColumn Property="c=>c.CreateTime" Title="Create Time" Format="yyyy-MM-dd HH:mm:ss" />
            <Column Title="Content" TData="string">
                <div style="max-height: 100px; overflow: hidden; text-overflow: ellipsis;">
                    @context.Content
                </div>
            </Column>
            <ActionColumn>
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="() => LoadHistoryVersion(context)">
                            Load
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="Are you sure to delete this history record?"
                                   OkText="Yes"
                                   CancelText="No"
                                   OnConfirm="() => DeleteHistoryRecord(context)">
                            <Button Danger>
                                <Icon Type="delete" />
                                Delete
                            </Button>
                        </Popconfirm>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </ChildContent>
        <ExpandTemplate Context="expandedContext">
            <div class="history-test-configs">
                <Divider Orientation="DividerOrientation.Left">Test Configurations</Divider>
                @if (expandedContext.Data.TestConfigs?.Any() == true)
                {
                    <Table TItem="TestConfigRecord"
                           DataSource="@expandedContext.Data.TestConfigs"
                           Size="TableSize.Small"
                           Bordered>
                        <ChildContent>
                            <PropertyColumn Property="c=>c.Type" Title="Type" />
                            <PropertyColumn Property="c=>c.ConfigName" Title="Config Name" />
                            <PropertyColumn Property="c=>c.ModelType" Title="Model Type" />
                            <PropertyColumn Property="c=>c.Parameters" Title="Parameters" />
                            <Column Title="Test Input" TData="string">
                                @if (!string.IsNullOrEmpty(context.TestInput))
                                {
                                    <div class="history-response">
                                        <pre>@context.TestInput</pre>
                                    </div>
                                }
                            </Column>
                            <Column Title="Result" TData="TestConfigRecord">
                                <div>
                                    @if (context.Success)
                                    {
                                        @* 优先显示 ResponseSegments，如果没有则显示 Response *@
                                        @if (context.ResponseSegments?.Any() == true)
                                        {
                                            <div class="history-response-segments">
                                                @foreach (var segment in context.ResponseSegments)
                                                {
                                                    @if (segment.Type == ResponseSegmentType.Text)
                                                    {
                                                        <div class="history-text-segment">
                                                            <pre>@segment.Text</pre>
                                                        </div>
                                                    }
                                                    else if (segment.Type == ResponseSegmentType.ToolCalls && segment.ToolCalls != null)
                                                    {
                                                        @* 🔥 并行工具调用展示 - 使用网格布局 *@
                                                        <div class="tool-calls-parallel-container">
                                                            @foreach (var toolCall in segment.ToolCalls)
                                                            {
                                                                <div class="history-tool-call-card">
                                                                    @* 工具头部 *@
                                                                    <div class="tool-card-header">
                                                                        <span class="tool-icon">🔧</span>
                                                                        <strong class="tool-name">@toolCall.ToolName</strong>
                                                                        <span class="tool-status" style="color: @(toolCall.Success ? "#52c41a" : "#ff4d4f");">
                                                                            @(toolCall.Success ? "✓" : "✗")
                                                                        </span>
                                                                    </div>
                                                                    
                                                                    @* 工具类型和耗时标签 *@
                                                                    <div class="tool-card-meta">
                                                                        <Tag Color="@(toolCall.ToolType == "App" ? "blue" : "purple")" Style="font-size: 11px;">
                                                                            @toolCall.ToolType
                                                                        </Tag>
                                                                        @if (toolCall.DurationMs > 0)
                                                                        {
                                                                            <Tag Color="default" Style="font-size: 11px;">
                                                                                ⏱ @toolCall.DurationMs ms
                                                                            </Tag>
                                                                        }
                                                                    </div>
                                                                    
                                                                    @* 折叠详情 *@
                                                                    <details class="tool-details">
                                                                        <summary class="tool-details-summary">查看详情</summary>
                                                                        <div class="tool-details-content">
                                                                            <div class="tool-param-section">
                                                                                <strong>📥 输入参数:</strong>
                                                                                <pre>@(string.IsNullOrEmpty(toolCall.Arguments) ? "{}" : toolCall.Arguments)</pre>
                                                                            </div>
                                                                            @if (!string.IsNullOrEmpty(toolCall.Result))
                                                                            {
                                                                                <div class="tool-result-section">
                                                                                    <strong>📤 返回结果:</strong>
                                                                                    <pre class="result-success">@toolCall.Result</pre>
                                                                                </div>
                                                                            }
                                                                            @if (!string.IsNullOrEmpty(toolCall.Error))
                                                                            {
                                                                                <div class="tool-error-section">
                                                                                    <strong style="color: #ff4d4f;">❌ 执行错误:</strong>
                                                                                    <pre class="result-error">@toolCall.Error</pre>
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    </details>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(context.Response))
                                        {
                                            <div class="history-response">
                                                <pre>@context.Response</pre>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <Tag Color="TagColor.Red">@context.Error</Tag>
                                    }
                                </div>
                            </Column>
                        </ChildContent>
                    </Table>
                }
                else
                {
                    <Empty Description="@("No test configurations")" />
                }
            </div>
        </ExpandTemplate>
    </Table>
</Drawer>

<Modal Title="优化Prompt"
       Visible="@_showOptimizeModal"
       Width="900"
       Footer="null"
       OnCancel="CloseOptimizeModal">
    <div class="optimize-modal-content">
        <Form TModel="object" Layout="@FormLayout.Vertical">
            <FormItem Label="选择模型配置">
                @if (_availableConfigs?.Any() == true)
                {
                    <Select TItemValue="string" TItem="LlmConfig"
                            @bind-Value="@_optimizeConfigId"
                            ValueName="Id"
                            LabelName="Name"
                            Placeholder="请选择一个LLM配置"
                            Style="width: 100%;"
                            DataSource="_availableConfigs">
                    </Select>
                }
                else
                {
                    <Alert Type="@AlertType.Warning" Message="没有可用的模型配置，请先配置LLM" ShowIcon="true" />
                }
            </FormItem>
            <FormItem Label="额外要求（可选）">
                <TextArea @bind-Value="@_optimizeRequirement"
                         Placeholder="如果有特殊要求，可以在此说明..."
                         Rows="3"
                         MaxLength="500" />
            </FormItem>
        </Form>

        <Divider>优化结果</Divider>

        <div class="optimize-result-container" id="optimize-result-container">
            @if (_optimizing)
            {
                <div class="optimize-loading">
                    <Spin Tip="正在优化中，请稍候..."></Spin>
                </div>
            }
            else if (!string.IsNullOrEmpty(_optimizedContent))
            {
                <div class="optimize-result-text">
                    <pre>@_optimizedContent</pre>
                    @if (_optimizing)
                    {
                        <span class="cursor-effect"></span>
                    }
                </div>
            }
            else
            {
                <Empty Description="@("选择模型后点击生成优化按钮开始优化")" ImageStyle="height: 80px;" />
            }
        </div>

        <div class="optimize-actions">
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary"
                            OnClick="StartOptimize"
                            Disabled="@(string.IsNullOrWhiteSpace(_optimizeConfigId) || _optimizing)"
                            Loading="@_optimizing">
                        @(_optimizing ? "优化中..." : (string.IsNullOrEmpty(_optimizedContent) ? "生成优化" : "重新生成"))
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Default"
                            OnClick="ApplyOptimizedPrompt"
                            Disabled="@(string.IsNullOrWhiteSpace(_optimizedContent) || _optimizing)">
                        <Icon Type="check" /> 应用到编辑器
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Default"
                            OnClick="StopOptimize"
                            Disabled="@(!_optimizing)">
                        <Icon Type="stop" /> 停止
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Default" OnClick="CloseOptimizeModal">
                        <Icon Type="close" /> 关闭
                    </Button>
                </SpaceItem>
            </Space>
        </div>
    </div>
</Modal>

