    #region Prompt优化功能

    private void ShowOptimizeModal()
    {
        // 先检查是否有可用配置
        if (_availableConfigs == null || !_availableConfigs.Any())
        {
            _message.Warning("没有可用的模型配置，请先配置LLM");
            return;
        }

        _showOptimizeModal = true;
        _optimizedContent = string.Empty;
        _optimizeRequirement = string.Empty;

        // 默认选择一个有效的配置（如果当前选择无效或为空则选择第一个）
        if (string.IsNullOrEmpty(_optimizeConfigId) || !_availableConfigs.Any(c => c.Id == _optimizeConfigId))
        {
            _optimizeConfigId = _availableConfigs.FirstOrDefault()?.Id;
        }
    }

    private void CloseOptimizeModal()
    {
        _showOptimizeModal = false;
        _optimizing = false;
        _optimizeCancellationTokenSource?.Cancel();
        _optimizeCancellationTokenSource?.Dispose();
        _optimizeCancellationTokenSource = null;
    }

    private async Task StartOptimize()
    {
        if (string.IsNullOrWhiteSpace(_editingPrompt.Content))
        {
            _message.Error("请先填写Prompt内容");
            return;
        }

        if (string.IsNullOrWhiteSpace(_optimizeConfigId))
        {
            _message.Error("请选择一个模型配置");
            return;
        }

        try
        {
            // 创建新的取消令牌
            _optimizeCancellationTokenSource?.Cancel();
            _optimizeCancellationTokenSource?.Dispose();
            _optimizeCancellationTokenSource = new CancellationTokenSource();

            _optimizing = true;
            _optimizedContent = string.Empty;
            StateHasChanged();

            // 读取优化Prompt模板
            var templatePath = Path.Combine(AppContext.BaseDirectory, "PromptTemplates", "OptimizePrompt.txt");
            if (!File.Exists(templatePath))
            {
                _message.Error("优化模板文件不存在");
                _optimizing = false;
                return;
            }

            var template = await File.ReadAllTextAsync(templatePath);

            // 替换模板中的占位符
            var systemPrompt = template
                .Replace("{{$prompt}}", _editingPrompt.Content)
                .Replace("{{$requirement}}", _optimizeRequirement ?? "无特殊要求");

            // 构建消息列表
            var messages = new List<AIChatMessage>
            {
                new AIChatMessage(ChatRole.System, systemPrompt),
                new AIChatMessage(ChatRole.User, "请开始优化这个提示词")
            };

            var chatOptions = new ChatOptions
            {
                Temperature = 0.7f,
                MaxOutputTokens = 4000
            };

            // 获取LlmConfig对象
            var config = _availableConfigs.FirstOrDefault(c => c.Id == _optimizeConfigId);
            if (config == null)
            {
                _message.Error("未找到指定的模型配置");
                _optimizing = false;
                return;
            }

            // 流式调用LLM，加入 429 专门处理与重试
            var chatClient = _chatClientFactory.CreateClientWithHttpClient(config);

            var maxRetries = 3;
            var attempt = 0;
            var fullResponse = new System.Text.StringBuilder();

            for (; attempt <= maxRetries; attempt++)
            {
                try
                {
                    var streamingResponse = chatClient.GetStreamingResponseAsync(
                        messages,
                        chatOptions,
                        _optimizeCancellationTokenSource.Token
                    );

                    await foreach (var update in streamingResponse)
                    {
                        if (_optimizeCancellationTokenSource.Token.IsCancellationRequested)
                        {
                            break;
                        }

                        if (update.Text != null)
                        {
                            fullResponse.Append(update.Text);
                            _optimizedContent = fullResponse.ToString();
                            StateHasChanged();

                            // 自动滚动到底部
                            try
                            {
                                await JSRuntime.InvokeVoidAsync("scrollToBottom", "optimize-result-container");
                            }
                            catch { /* 静默失败 */ }
                        }
                    }

                    // 如果执行成功，跳出重试循环
                    break;
                }
                catch (Exception ex) when (
                    (ex is System.Net.Http.HttpRequestException httpEx && httpEx.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
                    || (ex.Message != null && ex.Message.Contains("429"))
                    || (ex.InnerException != null && ex.InnerException.Message?.Contains("429") == true)
                )
                {
                    // 处理 429 限流
                    Logger.LogWarning(ex, "Optimize prompt attempt {Attempt} received 429 Too Many Requests", attempt);
                    _message.Warning($"上游服务返回 429（请求过多），正在重试 ({attempt}/{maxRetries})...");

                    if (attempt >= maxRetries || _optimizeCancellationTokenSource.Token.IsCancellationRequested)
                    {
                        _message.Error("优化失败：上游服务限流，请稍后重试或选择其他模型配置。");
                        throw; // 让外层 catch 处理清理
                    }

                    // 指数退避
                    var delayMs = (int)(Math.Pow(2, attempt) * 1000);
                    await Task.Delay(delayMs, _optimizeCancellationTokenSource.Token);
                    continue;
                }
            }

            _message.Success("Prompt优化完成！");
        }
        catch (OperationCanceledException)
        {
            _message.Info("优化已停止");
        }
        catch (Exception ex)
        {
            _message.Error($"优化失败: {ex.Message}");
            Logger.LogError(ex, "Failed to optimize prompt");
        }
        finally
        {
            _optimizing = false;
            StateHasChanged();
        }
    }

    private void StopOptimize()
    {
        _optimizeCancellationTokenSource?.Cancel();
        _message.Info("正在停止优化...");
    }

    private async Task ApplyOptimizedPrompt()
    {
        if (string.IsNullOrWhiteSpace(_optimizedContent))
        {
            _message.Warning("没有可应用的优化内容");
            return;
        }

        var result = await _confirm.Show(
            "确定要用优化后的内容替换当前Prompt吗？此操作将覆盖编辑器中的内容。",
            "确认应用",
            ConfirmButtons.YesNo,
            ConfirmIcon.Question
        );

        if (result == ConfirmResult.Yes)
        {
            _editingPrompt.Content = _optimizedContent;
            UpdatePromptParameters(_optimizedContent);
            TriggerAutoSave();
            _message.Success("已应用优化后的Prompt");
            CloseOptimizeModal();
        }
    }

