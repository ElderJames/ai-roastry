@code {
    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Version { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public bool Restore { get; set; }

    private List<LlmConfig> _availableConfigs = new();
    private List<LlmEndpoint> _availableEndpoints = new();
    private bool _testLoading;
    private string _selectedTestType = "Model";
    private string? _selectedConfigId;
    private string? _selectedEndpointId;
    private LlmPrompt _editingPrompt = new();
    private List<PromptTestConfig> _testConfigs = new();
    private bool _showHistoryDrawer;
    private bool _historyLoading;
    private List<LlmPromptHistory> _promptHistory = new();
    private HashSet<string> _promptParameters = new();
    private Dictionary<string, string> _parameterValues = new();

    // Tool selection
    private List<ToolSelectionItem> _availableTools = new();
    private IEnumerable<string> _selectedToolIds = Array.Empty<string>();

    private string _testContent = string.Empty;
    private bool _showChatHistoryDrawer = false;
    private PromptTestConfig? _selectedConfigForHistory = null;
    private bool _keepChatHistory = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        if (!string.IsNullOrEmpty(Id))
        {
            if (!string.IsNullOrEmpty(Version))
            {
                await LoadHistoryVersion();
            }
            else
            {
                await LoadPrompt();
            }

            if (!string.IsNullOrEmpty(_editingPrompt.Content))
            {
                UpdatePromptParameters(_editingPrompt.Content);
            }
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _availableConfigs = await LlmPoolService.GetConfigsAsync();
            _availableEndpoints = await LlmPoolService.GetEndpointsAsync();
            await LoadAvailableToolsAsync();
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to load data: {ex.Message}");
        }
    }

    private async Task LoadAvailableToolsAsync()
    {
        try
        {
            var tools = await ToolMetadataService.GetAllToolsAsync();
            _availableTools = tools.Select(t => new ToolSelectionItem
            {
                Value = $"{t.Source}:{t.SourceId}",
                Label = t.Name,
                ToolType = t.Source.ToString(), // "App" or "Mcp"
                ToolId = t.SourceId // SourceId 现在已经是 string 类型
            }).ToList();
            
            Logger.LogInformation("=== LoadAvailableToolsAsync ===");
            Logger.LogInformation("Loaded {Count} available tools", _availableTools.Count);
            foreach (var tool in _availableTools)
            {
                Logger.LogInformation("  Available Tool:");
                Logger.LogInformation("    Value: {Value}", tool.Value);
                Logger.LogInformation("    Label: {Label}", tool.Label);
                Logger.LogInformation("    Type: {Type}", tool.ToolType);
                Logger.LogInformation("    ToolId: {ToolId}", tool.ToolId);
            }
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to load tools: {ex.Message}");
        }
    }

    private async Task LoadPromptToolsAsync()
    {
        if (string.IsNullOrEmpty(_editingPrompt.Id))
            return;

        try
        {
            Logger.LogInformation("=== LoadPromptToolsAsync ===");
            Logger.LogInformation("Loading tools for Prompt ID: {PromptId}", _editingPrompt.Id);
            
            var promptTools = await PromptService.GetPromptToolsAsync(_editingPrompt.Id);
            
            Logger.LogInformation("Retrieved {Count} PromptTools from database", promptTools.Count);
            
            foreach (var pt in promptTools)
            {
                Logger.LogInformation("  PromptTool from DB:");
                Logger.LogInformation("    ToolId: {ToolId}", pt.ToolId);
                Logger.LogInformation("    ToolType: {ToolType}", pt.ToolType);
            }
            
            // 映射 ToolType 到 ToolSource 格式
            _selectedToolIds = promptTools.Select(pt => 
            {
                var sourceType = pt.ToolType == ToolType.Internal ? "App" : "MCP";
                var value = $"{sourceType}:{pt.ToolId}";
                Logger.LogInformation("  Mapping: {ToolType} + {ToolId} -> {Value}", 
                    pt.ToolType, pt.ToolId, value);
                return value;
            }).ToArray();
            
            Logger.LogInformation("Final _selectedToolIds ({Count} items):", _selectedToolIds.Count());
            foreach (var id in _selectedToolIds)
            {
                Logger.LogInformation("  - {Id}", id);
            }
            
            Logger.LogInformation("Available tools in _availableTools ({Count} items):", _availableTools.Count);
            foreach (var tool in _availableTools)
            {
                Logger.LogInformation("  - {Value} (Label: {Label})", tool.Value, tool.Label);
            }
            
            Logger.LogInformation("Checking if selected tools exist in available tools:");
            foreach (var selectedId in _selectedToolIds)
            {
                var exists = _availableTools.Any(t => t.Value == selectedId);
                Logger.LogInformation("  {SelectedId}: {Exists}", selectedId, exists ? "FOUND ✓" : "NOT FOUND ✗");
            }
            
            // 通知 Blazor 组件状态已更改
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to load prompt tools: {ex.Message}");
            Logger.LogError(ex, "Error loading prompt tools for {PromptId}", _editingPrompt.Id);
        }
    }

    private void LoadTestConfigsAndParameters(List<TestConfigRecord>? testConfigs)
    {
        if (testConfigs?.Any() == true)
        {
            _testConfigs = testConfigs.Select(c => new PromptTestConfig
            {
                Type = c.Type,
                ConfigId = c.ConfigId ?? string.Empty,
                Parameters = c.Parameters,
                TestResult = new PromptTestResult
                {
                    Success = c.Success,
                    Error = c.Error,
                    // 🔥 优先使用 ResponseSegments，如果没有则从 Response 创建
                    Segments = c.ResponseSegments?.Any() == true
                        ? c.ResponseSegments.ToList()
                        : !string.IsNullOrEmpty(c.Response)
                            ? new List<ResponseSegment>
                            {
                                new ResponseSegment
                                {
                                    Type = ResponseSegmentType.Text,
                                    Text = c.Response
                                }
                            }
                            : new List<ResponseSegment>()
                }
            }).ToList();

            // 🔥 回显测试输入（如果存在）
            if (!string.IsNullOrEmpty(testConfigs.First().TestInput))
            {
                _testContent = testConfigs.First().TestInput!;
            }

            // Restore parameter values if they exist
            if (testConfigs.First().ParameterValues?.Any() == true)
            {
                _parameterValues = new Dictionary<string, string>(testConfigs.First().ParameterValues);
            }
        }
        else
        {
            // Add a default test configuration if none exists
            _testConfigs = new List<PromptTestConfig>
            {
                new PromptTestConfig { Type = "Model" }
            };
        }
    }

    private async Task LoadPrompt()
    {
        try
        {
            var prompt = await LlmPoolService.GetPromptByIdAsync(Id!);
            if (prompt == null)
            {
                _message.Error("Prompt not found");
                NavigationManager.NavigateTo("/prompt-list");
                return;
            }

            _editingPrompt = prompt;

            // Load the latest history record
            var history = await LlmPoolService.GetPromptHistoryAsync(Id);
            var latestHistory = history.OrderByDescending(h => h.CreateTime).FirstOrDefault();
            
            if (latestHistory != null)
            {
                // Update prompt content from latest history
                _editingPrompt.Content = latestHistory.Content;
                _editingPrompt.Version = latestHistory.Version;
            }

            LoadTestConfigsAndParameters(latestHistory?.TestConfigs);

            // Load associated tools
            await LoadPromptToolsAsync();

            // Update parameters based on the loaded content
            if (!string.IsNullOrEmpty(_editingPrompt.Content))
            {
                UpdatePromptParameters(_editingPrompt.Content);
            }
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to load prompt: {ex.Message}");
            NavigationManager.NavigateTo("/prompt-list");
        }
    }

    private async Task LoadHistoryVersion()
    {
        try
        {
            var history = await LlmPoolService.GetPromptHistoryAsync(Id);
            var version = history.FirstOrDefault(h => h.Version.ToString() == Version);
            if (version == null)
            {
                _message.Error("Version not found");
                NavigationManager.NavigateTo("/prompt-list");
                return;
            }

            _editingPrompt = new LlmPrompt
            {
                Id = Restore ? version.PromptId : null,
                Name = _editingPrompt.Name, // Keep the current name
                Description = _editingPrompt.Description, // Keep the current description
                Content = version.Content,
                Version = version.Version
            };

            LoadTestConfigsAndParameters(version.TestConfigs);

            // Update parameters based on the loaded content
            if (!string.IsNullOrEmpty(_editingPrompt.Content))
            {
                UpdatePromptParameters(_editingPrompt.Content);
            }
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to load history version: {ex.Message}");
            NavigationManager.NavigateTo("/prompt-list");
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/prompt-list");
    }

    private async Task SavePrompt()
    {
        if (string.IsNullOrWhiteSpace(_editingPrompt.Name) || string.IsNullOrWhiteSpace(_editingPrompt.Content))
        {
            _message.Error("Please fill in all required fields");
            return;
        }

        try
        {
            if (_editingPrompt.Id == null)
            {
                await LlmPoolService.CreatePromptAsync(_editingPrompt);
                _message.Success("Prompt created successfully");
            }
            else
            {
                await LlmPoolService.UpdatePromptAsync(_editingPrompt);
                _message.Success("Prompt updated successfully");
            }

            // Save current state to history
            var history = new LlmPromptHistory
            {
                PromptId = _editingPrompt.Id ?? throw new Exception("Prompt ID is null"),
                Content = _editingPrompt.Content,
                BasedOnVersion = _editingPrompt.Version,
                ModelParameters = _editingPrompt.ModelParameters,
                TestConfigs = _testConfigs.Select(c => new TestConfigRecord
                {
                    Type = c.Type,
                    ConfigId = c.ConfigId,
                    Parameters = c.Parameters,
                    Success = c.TestResult?.Success ?? false,
                    // 从 Segments 中提取所有文本内容
                    Response = c.TestResult?.Segments
                        .Where(s => s.Type == ResponseSegmentType.Text)
                        .Select(s => s.Text)
                        .Where(t => !string.IsNullOrEmpty(t))
                        .DefaultIfEmpty(string.Empty)
                        .Aggregate((a, b) => a + b),
                    Error = c.TestResult?.Error,
                    ConfigName = c.Type == "Model" 
                        ? _availableConfigs.FirstOrDefault(m => m.Id == c.ConfigId)?.Name 
                        : _availableEndpoints.FirstOrDefault(e => e.Id == c.ConfigId)?.Name,
                    ModelType = c.Type == "Model"
                        ? _availableConfigs.FirstOrDefault(m => m.Id == c.ConfigId)?.ModelType?.Name
                        : null,
                    ParameterValues = new Dictionary<string, string>(_parameterValues)
                }).ToList()
            };

            await LlmPoolService.SavePromptHistoryAsync(history);
            _message.Success("History saved successfully");

            // Save tool bindings
            await SavePromptToolsAsync();

            NavigationManager.NavigateTo("/prompt-list");
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to save prompt: {ex.Message}");
        }
    }

    private async Task SavePromptToolsAsync()
    {
        if (string.IsNullOrEmpty(_editingPrompt.Id))
            return;

        try
        {
            Logger.LogInformation("Saving {Count} selected tools for Prompt {PromptId}: {Tools}", 
                _selectedToolIds.Count(), _editingPrompt.Id, string.Join(", ", _selectedToolIds));
            
            var promptTools = _selectedToolIds.Select(toolId =>
            {
                var parts = toolId.Split(':', 2);
                if (parts.Length != 2)
                {
                    Logger.LogWarning("Invalid tool ID format: {ToolId}", toolId);
                    return null;
                }

                // Parse ToolType: "App" -> Internal, "MCP" -> Mcp
                var toolTypeStr = parts[0];
                var toolType = toolTypeStr.Equals("App", StringComparison.OrdinalIgnoreCase) 
                    ? ToolType.Internal 
                    : ToolType.Mcp;

                var promptTool = new PromptTool
                {
                    PromptId = _editingPrompt.Id,
                    ToolId = parts[1],
                    ToolType = toolType
                };
                
                Logger.LogDebug("  Creating PromptTool: ToolId={ToolId}, ToolType={ToolType}", 
                    promptTool.ToolId, promptTool.ToolType);
                
                return promptTool;
            })
            .Where(pt => pt != null)
            .Cast<PromptTool>()
            .ToList();

            await PromptService.SetPromptToolsAsync(_editingPrompt.Id, promptTools);
            Logger.LogInformation("Successfully saved {Count} PromptTools", promptTools.Count);
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to save prompt tools: {ex.Message}");
            Logger.LogError(ex, "Error saving prompt tools for {PromptId}", _editingPrompt.Id);
        }
    }

    private void AddTestConfig()
    {
        _testConfigs.Add(new PromptTestConfig { Type = "Model" });
    }

    private void RemoveTestConfig(PromptTestConfig config)
    {
        _testConfigs.Remove(config);
    }

    private void OnPromptContentChanged(string content)
    {
        UpdatePromptParameters(content);
    }

    private void UpdatePromptParameters(string content)
    {
        var oldParameters = new HashSet<string>(_promptParameters);
        _promptParameters.Clear();

        // Find all {{param_name}} patterns
        var matches = Regex.Matches(content, @"\{\{(\w+)\}\}");
        foreach (Match match in matches)
        {
            var paramName = match.Groups[1].Value;
            _promptParameters.Add(paramName);

            // Keep existing parameter values
            if (!_parameterValues.ContainsKey(paramName))
            {
                _parameterValues[paramName] = string.Empty;
            }
        }

        // Remove values for parameters that no longer exist
        foreach (var oldParam in oldParameters)
        {
            if (!_promptParameters.Contains(oldParam))
            {
                _parameterValues.Remove(oldParam);
            }
        }

        StateHasChanged();
    }

    private async Task RunTests()
    {
        if (string.IsNullOrWhiteSpace(_editingPrompt.Content))
        {
            _message.Error("Please enter prompt content before testing");
            return;
        }

        @* if (string.IsNullOrWhiteSpace(_testContent))
        {
            _message.Error("Please enter test content before testing");
            return;
        } *@

        _testLoading = true;

        try
        {
            // Process the prompt content with parameter values
            var processedPromptContent = _editingPrompt.Content;
            foreach (var param in _parameterValues)
            {
                processedPromptContent = processedPromptContent.Replace($"{{{{{param.Key}}}}}", param.Value);
            }

            // 创建取消令牌，设置2分钟超时
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(2));

            // 准备所有测试任务
            var tasks = _testConfigs.Select(async config =>
            {
                try
                {
                    config.IsStreaming = true;
                    config.TestResult = new PromptTestResult { Success = true };
                    StateHasChanged();

                    // 构建消息列表 - 每个配置独立的聊天历史
                    var messages = new List<AIChatMessage>();
                    
                    // 如果全局保留聊天历史并且该配置有历史，添加历史消息
                    if (_keepChatHistory && config.ChatHistory.Any())
                    {
                        messages.AddRange(config.ChatHistory);
                    }
                    else
                    {
                        // 否则只添加系统消息
                        messages.Add(new AIChatMessage(Microsoft.Extensions.AI.ChatRole.System, processedPromptContent));
                    }
                    
                    // 添加用户当前输入
                    if (!string.IsNullOrWhiteSpace(_testContent))
                    {
                        messages.Add(new AIChatMessage(Microsoft.Extensions.AI.ChatRole.User, _testContent));
                    }

                    // 获取 Prompt 关联的工具 - 使用 Microsoft.Extensions.AI
                    List<Microsoft.Extensions.AI.AITool>? tools = null;
                    if (_selectedToolIds.Any())
                    {
                        try
                        {
                            // 从 _availableTools 中筛选出选中的工具元数据
                            var selectedMetadata = _availableTools
                                .Where(t => _selectedToolIds.Contains(t.Value))
                                .Select(t => new ToolMetadata
                                {
                                    Name = t.Label,
                                    Description = t.Label, // 使用 Label 作为描述
                                    Source = t.ToolType.Equals("App", StringComparison.OrdinalIgnoreCase) 
                                        ? ToolSource.App 
                                        : ToolSource.MCP,
                                    SourceId = t.ToolId,
                                    ParametersSchema = "{}" // Schema 在 CreateAITool 时会重新加载
                                })
                                .ToList();

                            if (selectedMetadata.Any())
                            {
                                tools = await ToolProviderService.GetToolsFromMetadataAsync(selectedMetadata);
                                Logger.LogInformation("Loaded {Count} AI tools for testing", tools?.Count ?? 0);
                            }
                        }
                        catch (Exception ex)
                        {
                            Logger.LogError(ex, "Failed to load tools for testing");
                            // 工具加载失败不影响测试继续
                        }
                    }

                    // 流式调用 - 统一使用 ChatClientService
                    IAsyncEnumerable<ChatStreamingUpdate> streamingResponse;
                    if (config.Type == "Model")
                    {
                        var llmConfig = await LlmPoolService.GetConfigByIdAsync(config.ConfigId!);
                        if (llmConfig == null)
                        {
                            throw new Exception("Selected model configuration not found.");
                        }

                        // 解析 Prompt 的模型参数
                        Dictionary<string, object>? parameters = null;
                        if (!string.IsNullOrWhiteSpace(_editingPrompt.ModelParameters))
                        {
                            parameters = ParseParametersToDict(_editingPrompt.ModelParameters);
                        }

                        Logger.LogInformation("Starting streaming with {MessageCount} messages, {ToolCount} tools", 
                            messages.Count, tools?.Count ?? 0);

                        // 使用新的 SendStreamingMessageWithDetailsAsync API 以获取工具调用详情
                        streamingResponse = ChatClientService.SendStreamingMessageWithDetailsAsync(
                            llmConfig,
                            messages,
                            parameters,
                            tools);
                    }
                    else
                    {
                        var endpoint = await LlmPoolService.GetEndpointByIdAsync(config.ConfigId!);
                        if (endpoint == null)
                        {
                            throw new Exception("Selected endpoint not found.");
                        }

                        streamingResponse = ChatClientService.SendStreamingMessageWithDetailsAsync(
                            endpoint,
                            messages,
                            tools);
                    }

                    // 流式接收响应
                    try
                    {
                        Logger.LogInformation("Starting to receive streaming chunks...");
                        
                        // 🔥 使用 ChatClientService 的流式方法处理片段拼接
                        await foreach (var segments in LY.LlmPool.Web.Services.ChatClientService.ConvertToSegmentsStreamAsync(streamingResponse))
                        {
                            config.TestResult.Segments = segments;
                            StateHasChanged();
                            await Task.Delay(10, cts.Token); // 保持打字效果的流畅性
                        }
                        
                        // 计算总文本长度和工具调用数量
                        var totalTextLength = config.TestResult.Segments
                            .Where(s => s.Type == ResponseSegmentType.Text)
                            .Sum(s => s.Text?.Length ?? 0);
                        var totalToolCalls = config.TestResult.Segments
                            .Where(s => s.Type == ResponseSegmentType.ToolCalls)
                            .Sum(s => s.ToolCalls?.Count ?? 0);
                        
                        Logger.LogInformation("Streaming completed. Text length: {Length}, Segments: {Segments}, Tool calls: {ToolCalls}", 
                            totalTextLength, config.TestResult.Segments.Count, totalToolCalls);

                        // 🔑 如果全局启用了保留聊天历史，使用完整的 messages 列表（包含工具调用）
                        if (_keepChatHistory)
                        {
                            Logger.LogInformation("更新聊天历史：messages 列表有 {Count} 条消息", messages.Count);
                            
                            // 🎯 关键：直接替换为完整的 messages 列表
                            // messages 已经被 FunctionInvokingChatClient 自动更新，包含：
                            // - 系统消息
                            // - 用户消息
                            // - 助手消息（带 FunctionCallContent）
                            // - 工具结果消息（带 FunctionResultContent）
                            // - 最终助手响应
                            config.ChatHistory.Clear();
                            config.ChatHistory.AddRange(messages);
                            
                            Logger.LogInformation("聊天历史已更新，共 {Count} 条消息", config.ChatHistory.Count);
                        }
                    }
                    catch (Exception ex)
                    {
                        config.TestResult.Success = false;
                        config.TestResult.Error = ex.Message;
                        StateHasChanged();
                    }
                }
                catch (Exception ex)
                {
                    config.TestResult = new PromptTestResult
                    {
                        Success = false,
                        Error = ex is TaskCanceledException or OperationCanceledException 
                            ? "Request timed out or was cancelled." 
                            : ex.Message
                    };
                }
                finally
                {
                    config.IsStreaming = false;
                    StateHasChanged();
                }
            }).ToList();

            try
            {
                // 并行执行所有测试，添加超时处理
                await Task.WhenAll(tasks);
            }
            catch (TaskCanceledException)
            {
                _message.Warning("Some requests timed out.");
            }
            catch (OperationCanceledException)
            {
                _message.Warning("Some requests were cancelled.");
            }

            // 如果全局启用了保留历史并且有任何成功的测试，清空输入框
            if (_keepChatHistory && _testConfigs.Any(c => c.TestResult?.Success == true))
            {
                _testContent = string.Empty;
            }

            // 保存测试结果到历史记录
            await SaveTestHistory();
            _message.Success("Test configurations saved to history");
        }
        finally
        {
            _testLoading = false;
        }
    }

    private void ShowChatHistory(PromptTestConfig config)
    {
        _selectedConfigForHistory = config;
        _showChatHistoryDrawer = true;
    }

    private void CloseChatHistoryDrawer()
    {
        _showChatHistoryDrawer = false;
        _selectedConfigForHistory = null;
    }

    private void ClearAllChatHistory()
    {
        foreach (var config in _testConfigs)
        {
            config.ChatHistory.Clear();
        }
        _message.Success("所有聊天历史已清空");
        CloseChatHistoryDrawer();
        StateHasChanged();
    }

    private string GetConfigName(PromptTestConfig config)
    {
        if (config.Type == "Model")
        {
            var model = _availableConfigs.FirstOrDefault(c => c.Id == config.ConfigId);
            return model != null ? $"{model.Name} ({model.Model})" : config.ConfigId ?? "Unknown";
        }
        else if (config.Type == "Endpoint")
        {
            var endpoint = _availableEndpoints.FirstOrDefault(e => e.Id == config.ConfigId);
            return endpoint?.Name ?? config.ConfigId ?? "Unknown";
        }
        else
        {
            return config.ConfigId ?? "Unknown";
        }
    }

    private async Task SaveTestHistory()
    {
        if (_editingPrompt.Id == null)
        {
            // Save the prompt first if it's new
            await SavePrompt();
        }

        if (_editingPrompt.Id != null)
        {
            var history = new LlmPromptHistory
            {
                PromptId = _editingPrompt.Id,
                Content = _editingPrompt.Content,  // Use current content
                BasedOnVersion = _editingPrompt.Version,
                ModelParameters = _editingPrompt.ModelParameters,
                TestConfigs = _testConfigs.Select(c => new TestConfigRecord
                {
                    Type = c.Type,
                    ConfigId = c.ConfigId,
                    Parameters = c.Parameters,
                    Success = c.TestResult?.Success ?? false,
                    // 🔥 保存测试输入
                    TestInput = _testContent,
                    // 从 Segments 中提取所有文本内容（向后兼容）
                    Response = c.TestResult?.Segments
                        .Where(s => s.Type == ResponseSegmentType.Text)
                        .Select(s => s.Text)
                        .Where(t => !string.IsNullOrEmpty(t))
                        .DefaultIfEmpty(string.Empty)
                        .Aggregate((a, b) => a + b),
                    // 🔥 保存完整的响应片段（包含工具调用）
                    ResponseSegments = c.TestResult?.Segments.ToList(),
                    Error = c.TestResult?.Error,
                    // Add model/endpoint information
                    ConfigName = c.Type == "Model" 
                        ? _availableConfigs.FirstOrDefault(m => m.Id == c.ConfigId)?.Name 
                        : _availableEndpoints.FirstOrDefault(e => e.Id == c.ConfigId)?.Name,
                    ModelType = c.Type == "Model"
                        ? _availableConfigs.FirstOrDefault(m => m.Id == c.ConfigId)?.ModelType?.Name
                        : null,
                    // Save parameter values
                    ParameterValues = new Dictionary<string, string>(_parameterValues)
                }).ToList()
            };

            await LlmPoolService.SavePromptHistoryAsync(history);
        }
    }

    private async Task ShowHistory()
    {
        if (string.IsNullOrEmpty(_editingPrompt.Id))
        {
            return;
        }

        _showHistoryDrawer = true;
        _historyLoading = true;

        try
        {
            _promptHistory = await LlmPoolService.GetPromptHistoryAsync(_editingPrompt.Id);
        }
        finally
        {
            _historyLoading = false;
        }
    }

    private void CloseHistoryDrawer()
    {
        _showHistoryDrawer = false;
        _promptHistory.Clear();
    }

    private async Task LoadHistoryVersion(LlmPromptHistory history)
    {
        // Create a new prompt based on the history version
        _editingPrompt = new LlmPrompt
        {
            Id = history.PromptId,
            Name = _editingPrompt.Name, // Keep the current name
            Description = _editingPrompt.Description, // Keep the current description
            Content = history.Content,
            Version = history.Version,
            ModelParameters = history.ModelParameters,
            CreateTime = _editingPrompt.CreateTime,
            UpdateTime = DateTime.UtcNow
        };

        LoadTestConfigsAndParameters(history.TestConfigs);

        // Update parameters based on the loaded content
        if (!string.IsNullOrEmpty(_editingPrompt.Content))
        {
            UpdatePromptParameters(_editingPrompt.Content);
        }

        // Close the drawer
        CloseHistoryDrawer();

        // Show success message
        _message.Success($"Loaded version {history.Version}");
        await Task.CompletedTask; // 避免警告
    }

    private async Task DeleteHistoryRecord(LlmPromptHistory history)
    {
        try
        {
            await LlmPoolService.DeletePromptHistoryAsync(history.Id);
            _message.Success("History record deleted successfully");
            
            // Refresh the history list
            if (_showHistoryDrawer)
            {
                await ShowHistory();
            }
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to delete history record: {ex.Message}");
        }
    }

    /// <summary>
    /// 解析参数字符串为 Dictionary<string, object>: "temp=0.7,tokens=100" -> {"temp": 0.7, "tokens": 100}
    /// </summary>
    private Dictionary<string, object> ParseParametersToDict(string parametersString)
    {
        var result = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);

        if (string.IsNullOrWhiteSpace(parametersString))
        {
            return result;
        }

        // 支持逗号或分号分隔
        var pairs = parametersString.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries);

        foreach (var pair in pairs)
        {
            var parts = pair.Split(new[] { '=', ':' }, 2, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 2)
            {
                var key = parts[0].Trim().ToLowerInvariant();
                var value = parts[1].Trim();
                
                // 尝试转换为适当的类型
                if (key == "temp" || key == "temperature" || key == "top_p" || key == "topp")
                {
                    if (double.TryParse(value, out var doubleValue))
                    {
                        result[key] = doubleValue;
                    }
                }
                else if (key == "tokens" || key == "max_tokens" || key == "maxtokens")
                {
                    if (int.TryParse(value, out var intValue))
                    {
                        result[key] = intValue;
                    }
                }
                else
                {
                    // 未知参数保持为字符串
                    result[key] = value;
                }
            }
        }

        return result;
    }

