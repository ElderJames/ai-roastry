    private void UpdatePromptParameters(string content)
    {
        var parameterService = new PromptParameterService();
        var oldParameterNames = new HashSet<string>(_promptParameters.Select(p => p.Name));

        // 使用新的提取方法,支持带描述的参数
        _promptParameters = parameterService.ExtractParameters(content);

        // 更新参数值字典
        foreach (var param in _promptParameters)
        {
            // Keep existing parameter values
            if (!_parameterValues.ContainsKey(param.Name))
            {
                _parameterValues[param.Name] = string.Empty;
            }
        }

        // Remove values for parameters that no longer exist
        var currentParameterNames = new HashSet<string>(_promptParameters.Select(p => p.Name));
        foreach (var oldParam in oldParameterNames)
        {
            if (!currentParameterNames.Contains(oldParam))
            {
                _parameterValues.Remove(oldParam);
            }
        }

        StateHasChanged();
    }

    private async Task RunTests()
    {
        if (string.IsNullOrWhiteSpace(_editingPrompt.Content))
        {
            _message.Error("Please enter prompt content before testing");
            return;
        }

        // 验证必传参数
        var missingRequiredParams = _promptParameters
            .Where(p => p.IsRequired && (!_parameterValues.ContainsKey(p.Name) || string.IsNullOrWhiteSpace(_parameterValues[p.Name])))
            .Select(p => p.Name)
            .ToList();

        if (missingRequiredParams.Any())
        {
            _message.Error($"必填参数未填写: {string.Join(", ", missingRequiredParams)}");
            return;
        }

        // 创建新的取消令牌
        _testCancellationTokenSource?.Cancel();
        _testCancellationTokenSource?.Dispose();
        _testCancellationTokenSource = new CancellationTokenSource();

        _testLoading = true;

        try
        {
            // Process the prompt content with parameter values
            var processedPromptContent = _editingPrompt.Content;
            foreach (var param in _parameterValues)
            {
                // 替换参数时需要考虑带 * 的情况
                processedPromptContent = processedPromptContent.Replace($"{{{{{param.Key}}}}}", param.Value);
                processedPromptContent = processedPromptContent.Replace($"{{{{*{param.Key}}}}}", param.Value);
            }

            // 🔥 替换环境变量 (如 @datetime, @user 等)
            processedPromptContent = PromptEnvironmentService.ReplaceEnvironmentVariables(processedPromptContent);

            // 使用实例级别的取消令牌
            var cancellationToken = _testCancellationTokenSource.Token;

            // 准备所有测试任务
            var tasks = _testConfigs.Select(async config =>
            {
                try
                {
                    config.IsStreaming = true;
                    config.TestResult = new PromptTestResult { Success = true };
                    StateHasChanged();

                    // 构建消息列表 - 每个配置独立的聊天历史
                    var messages = new List<AIChatMessage>();

                    // 如果该配置有历史,添加历史消息
                    if (config.ChatHistory.Any())
                    {
                        // 🔥 更新第一条 system prompt 为最新的 prompt 内容和参数
                        var firstMessage = config.ChatHistory.FirstOrDefault();
                        if (firstMessage != null && firstMessage.Role.Value == "system")
                        {
                            // 更新现有的 system prompt
                            config.ChatHistory[0] = new AIChatMessage(Microsoft.Extensions.AI.ChatRole.System, processedPromptContent);
                            Logger.LogInformation("更新了 system prompt 为最新内容");
                        }
                        else if (firstMessage?.Role.Value != "system")
                        {
                            // 如果第一条不是 system 消息,在开头插入
                            config.ChatHistory.Insert(0, new AIChatMessage(Microsoft.Extensions.AI.ChatRole.System, processedPromptContent));
                            Logger.LogInformation("在历史记录开头插入了 system prompt");
                        }
                        
                        messages.AddRange(config.ChatHistory);
                        Logger.LogInformation("加载了 {Count} 条历史消息用于多轮对话", config.ChatHistory.Count);
                    }
                    else
                    {
                        // 首次对话:添加系统消息
                        messages.Add(new AIChatMessage(Microsoft.Extensions.AI.ChatRole.System, processedPromptContent));
                        Logger.LogInformation("首次对话，添加系统消息");
                    }

                    // 记录发送前的历史消息数量
                    var historyCountBeforeSending = config.ChatHistory.Count;

                    // 添加用户当前输入（如果有）
                    if (!string.IsNullOrWhiteSpace(_testContent))
                    {
                        var userMessage = new AIChatMessage(Microsoft.Extensions.AI.ChatRole.User, _testContent);
                        messages.Add(userMessage);
                        Logger.LogInformation("添加用户消息: {Message}", _testContent.Length > 50 ? _testContent.Substring(0, 50) + "..." : _testContent);

                        // 🎯 立即将用户消息添加到历史记录中并刷新UI，让用户看到已发送的消息
                        if (config.ChatHistory.Any())
                        {
                            // 如果已有历史记录，只添加新的用户消息
                            config.ChatHistory.Add(userMessage);
                        }
                        else
                        {
                            // 首次对话，添加系统消息和用户消息到历史
                            config.ChatHistory.Add(new AIChatMessage(Microsoft.Extensions.AI.ChatRole.System, processedPromptContent));
                            config.ChatHistory.Add(userMessage);
                        }
                        StateHasChanged(); // 立即刷新UI显示用户消息
                    }
                    else
                    {
                        // 没有用户输入 - 直接使用 Prompt Content 作为测试
                        Logger.LogInformation("没有用户输入，直接使用 Prompt Content 进行测试");

                        // 如果是首次对话且没有用户输入，将 system message 也添加到历史记录
                        if (!config.ChatHistory.Any())
                        {
                            config.ChatHistory.Add(new AIChatMessage(Microsoft.Extensions.AI.ChatRole.System, processedPromptContent));
                            StateHasChanged();
                        }
                    }

                    // 获取 Prompt 关联的工具 - 使用 Microsoft.Extensions.AI
                    List<Microsoft.Extensions.AI.AITool>? tools = null;
                    if (_selectedToolIds.Any())
                    {
                        try
                        {
                            // 从 ToolMetadataService 获取所有工具的完整元数据
                            var allToolsMetadata = await ToolMetadataService.GetAllToolsAsync();

                            // 根据选中的 toolId 筛选出对应的工具元数据
                            var selectedMetadata = _selectedToolIds
                                .Select(selectedId =>
                                {
                                    // selectedId 格式: "App:appId" 或 "MCP:serverId:toolName"
                                    var tool = allToolsMetadata.FirstOrDefault(t =>
                                    {
                                        var toolValue = $"{t.Source}:{t.SourceId}";
                                        return toolValue == selectedId;
                                    });

                                    if (tool == null)
                                    {
                                        Logger.LogWarning("Selected tool not found in metadata: {SelectedId}", selectedId);
                                    }

                                    return tool;
                                })
                                .Where(t => t != null)
                                .Cast<ToolMetadata>()
                                .ToList();

                            if (selectedMetadata.Any())
                            {
                                tools = await ToolProviderService.GetToolsFromMetadataAsync(selectedMetadata);
                                Logger.LogInformation("Loaded {Count} AI tools for testing", tools?.Count ?? 0);
                            }
                        }
                        catch (Exception ex)
                        {
                            Logger.LogError(ex, "Failed to load tools for testing");
                            // 工具加载失败不影响测试继续
                        }
                    }

                    // 流式调用 - 统一使用 ChatClientService
                    IAsyncEnumerable<ChatStreamingUpdate> streamingResponse;
                    if (config.Type == "Model")
                    {
                        var llmConfig = await LlmPoolService.GetConfigByIdAsync(config.ConfigId!);
                        if (llmConfig == null)
                        {
                            throw new Exception("Selected model configuration not found.");
                        }

                        // 解析 Prompt 的模型参数
                        Dictionary<string, object>? parameters = null;
                        if (!string.IsNullOrWhiteSpace(_editingPrompt.ModelParameters))
                        {
                            parameters = ParameterUtils.ParseParametersToDict(_editingPrompt.ModelParameters);
                        }

                        Logger.LogInformation("Starting streaming with {MessageCount} messages, {ToolCount} tools", 
                            messages.Count, tools?.Count ?? 0);

                        // 使用新的 SendStreamingMessageWithDetailsAsync API 以获取工具调用详情
                        streamingResponse = ChatClientService.SendStreamingMessageWithDetailsAsync(
                            llmConfig,
                            messages,
                            parameters,
                            tools);
                    }
                    else
                    {
                        var endpoint = await LlmPoolService.GetEndpointByIdAsync(config.ConfigId!);
                        if (endpoint == null)
                        {
                            throw new Exception("Selected endpoint not found.");
                        }

                        streamingResponse = ChatClientService.SendStreamingMessageWithDetailsAsync(
                            endpoint,
                            messages,
                            tools);
                    }

                    // 流式接收响应
                    try
                    {
                        Logger.LogInformation("Starting to receive streaming chunks...");

                        // 🎯 立即创建一个空的助手消息并添加到历史记录
                        var assistantMessage = new AIChatMessage(Microsoft.Extensions.AI.ChatRole.Assistant, "");
                        config.ChatHistory.Add(assistantMessage);
                        StateHasChanged(); // 刷新UI，显示助手消息占位

                        Logger.LogInformation("创建了空的助手消息，当前历史记录: {Count} 条", config.ChatHistory.Count);

                        // 🔥 使用 ChatClientService 的流式方法处理片段拼接
                        await foreach (var segments in LY.LlmPool.Web.Services.ChatClientService.ConvertToSegmentsStreamAsync(streamingResponse))
                        {
                            // 检查取消请求
                            cancellationToken.ThrowIfCancellationRequested();

                            // 🎯 根据 segments 更新助手消息的 Contents
                            var contents = new List<Microsoft.Extensions.AI.AIContent>();

                            foreach (var segment in segments)
                            {
                                if (segment.Type == ResponseSegmentType.Text && !string.IsNullOrEmpty(segment.Text))
                                {
                                    contents.Add(new Microsoft.Extensions.AI.TextContent(segment.Text));
                                }
                                else if (segment.Type == ResponseSegmentType.ToolCalls && segment.ToolCalls != null)
                                {
                                    foreach (var toolCall in segment.ToolCalls)
                                    {
                                        if (!string.IsNullOrEmpty(toolCall.CallId))
                                        {
                                            // 🔑 添加工具调用内容（FunctionCallContent）
                                            var args = new Dictionary<string, object?>();
                                            if (!string.IsNullOrEmpty(toolCall.Arguments))
                                            {
                                                try
                                                {
                                                    args = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object?>>(toolCall.Arguments)
                                                        ?? new Dictionary<string, object?>();
                                                }
                                                catch
                                                {
                                                    // 解析失败，使用空字典
                                                }
                                            }

                                            contents.Add(new Microsoft.Extensions.AI.FunctionCallContent(
                                                toolCall.CallId,
                                                toolCall.ToolName,
                                                args
                                            ));

                                            // 🔑 如果工具调用有结果，添加工具结果内容（FunctionResultContent）
                                            if (!string.IsNullOrEmpty(toolCall.Result))
                                            {
                                                object? resultValue = toolCall.Result;
                                                try
                                                {
                                                    // 尝试解析为 JSON 对象
                                                    resultValue = ToJson(toolCall.Result);
                                                }
                                                catch
                                                {
                                                    // 解析失败，使用原始字符串
                                                }

                                                contents.Add(new Microsoft.Extensions.AI.FunctionResultContent(
                                                    toolCall.CallId,
                                                    resultValue
                                                ));

                                                Logger.LogInformation("🔧 添加工具结果: {CallId} -> {ToolName}, Success: {Success}",
                                                    toolCall.CallId, toolCall.ToolName, toolCall.Success);
                                            }
                                        }
                                    }
                                }
                            }

                            // 🔑 创建新的助手消息替换旧的（因为 Contents 是只读的）
                            if (contents.Any())
                            {
                                // 获取文本内容
                                var textContent = contents.OfType<Microsoft.Extensions.AI.TextContent>().FirstOrDefault();
                                var textValue = textContent?.Text ?? "";

                                // 创建新消息（带 Contents）
                                var newAssistantMessage = new AIChatMessage(
                                    Microsoft.Extensions.AI.ChatRole.Assistant,
                                    contents
                                );

                                // 替换历史记录中的最后一条消息（助手消息）
                                var lastIndex = config.ChatHistory.Count - 1;
                                if (lastIndex >= 0 && config.ChatHistory[lastIndex] == assistantMessage)
                                {
                                    config.ChatHistory[lastIndex] = newAssistantMessage;
                                    assistantMessage = newAssistantMessage; // 更新引用
                                }
                            }

                            StateHasChanged();

                            // 🎯 自动滚动到流式响应底部 - 等待 DOM 渲染完成
                            await Task.Delay(50, cancellationToken); // 等待 DOM 更新
                            await ScrollToStreamingBottom(config.ConfigId);

                            await Task.Delay(10, cancellationToken); // 保持打字效果的流畅性
                        }
                        
                        Logger.LogInformation("流式接收完成，助手消息已更新");
                        
                        // � 调试：打印流式完成后的 messages 列表（FunctionInvokingChatClient 可能添加了额外的消息）
                        Logger.LogInformation("🔍 流式循环结束，检查 FunctionInvokingChatClient 是否添加了额外消息");
                        Logger.LogInformation("  messages 列表: {Count} 条", messages.Count);
                        Logger.LogInformation("  ChatHistory: {Count} 条", config.ChatHistory.Count);
                        
                        // 🔑 将最终的助手消息添加到 messages 列表（如果 messages 还没有）
                        // 这样 FunctionInvokingChatClient 的后续处理才能正确工作
                        if (!messages.Contains(assistantMessage))
                        {
                            messages.Add(assistantMessage);
                            Logger.LogInformation("将助手消息添加到 messages 列表");
                        }
                        
                        // 🔑 同步 FunctionInvokingChatClient 添加的额外消息到 ChatHistory
                        // 这些消息包括工具结果等
                        var currentHistoryCount = config.ChatHistory.Count;
                        if (messages.Count > currentHistoryCount)
                        {
                            var newMessages = messages.Skip(currentHistoryCount).ToList();
                            Logger.LogInformation("同步 {Count} 条新消息到 ChatHistory（工具结果等）", newMessages.Count);
                            config.ChatHistory.AddRange(newMessages);
                        }
                        
                        // 计算总文本长度和工具调用数量（用于日志）
                        var totalTextLength = assistantMessage.Text?.Length ?? 0;
                        var totalToolCalls = assistantMessage.Contents?.OfType<Microsoft.Extensions.AI.FunctionCallContent>().Count() ?? 0;
                        
                        Logger.LogInformation("Streaming completed. Text length: {Length}, Tool calls: {ToolCalls}", 
                            totalTextLength, totalToolCalls);
                        
                        // 🔑 最终刷新UI，确保历史记录显示
                        StateHasChanged();
                        
                        // 🔥 等待一小段时间，让 FunctionInvokingChatClient 完成工具结果的添加
                        await Task.Delay(50);
                        
                        // 🔑 再次检查并同步工具结果（FunctionInvokingChatClient 可能在流式完成后才添加）
                        var finalHistoryCount = config.ChatHistory.Count;
                        if (messages.Count > finalHistoryCount)
                        {
                            var additionalMessages = messages.Skip(finalHistoryCount).ToList();
                            Logger.LogInformation("🔧 流式完成后同步额外的 {Count} 条消息", additionalMessages.Count);
                            foreach (var msg in additionalMessages)
                            {
                                Logger.LogInformation("  - 消息类型: {Role}, Contents: {Count}", msg.Role, msg.Contents?.Count ?? 0);
                                if (msg.Contents != null)
                                {
                                    foreach (var content in msg.Contents)
                                    {
                                        Logger.LogInformation("    - Content 类型: {Type}", content.GetType().Name);
                                    }
                                }
                            }
                            config.ChatHistory.AddRange(additionalMessages);
                            StateHasChanged(); // 刷新UI显示工具结果
                        }
                    }
                    catch (OperationCanceledException)
                    {
                        config.TestResult.Success = false;
                        config.TestResult.Error = "Test was stopped by user.";
                        StateHasChanged();
                    }
                    catch (Exception ex)
                    {
                        config.TestResult.Success = false;
                        config.TestResult.Error = ex.Message;
                        StateHasChanged();
                    }
                }
                catch (OperationCanceledException)
                {
                    config.TestResult = new PromptTestResult
                    {
                        Success = false,
                        Error = "Test was stopped by user."
                    };
                }
                catch (Exception ex)
                {
                    config.TestResult = new PromptTestResult
                    {
                        Success = false,
                        Error = ex is TaskCanceledException 
                            ? "Request timed out or was cancelled." 
                            : ex.Message
                    };
                }
                finally
                {
                    config.IsStreaming = false;
                    StateHasChanged();
                }
            }).ToList();

            try
            {
                // 并行执行所有测试
                await Task.WhenAll(tasks);
            }
            catch (OperationCanceledException)
            {
                _message.Warning("Tests stopped by user.");
            }

            // 🔑 不再清空输入框，让用户可以继续修改和发送
            // 如果需要清空，用户可以手动清空或使用快捷键
            
            // 自动对焦输入框，支持连续提问
            if (_testInputRef != null)
            {
                await InvokeAsync(async () =>
                {
                    await Task.Delay(100); // 等待流式响应完成和UI更新
                    await _testInputRef.Focus();
                });
            }

            // 保存测试结果到历史记录(只有未取消的情况下保存)
            if (!cancellationToken.IsCancellationRequested)
            {
                await SaveTestHistory();
                _message.Success("Test configurations saved to history");
            }
        }
        finally
        {
            _testLoading = false;
            _testCancellationTokenSource?.Dispose();
            _testCancellationTokenSource = null;
        }
    }

    private void StopTests()
    {
        _testCancellationTokenSource?.Cancel();
        _message.Info("Stopping tests...");
    }    private void ShowChatHistory(PromptTestConfig config)
    {
        _selectedConfigForHistory = config;
        _showChatHistoryDrawer = true;
    }

    private void CloseChatHistoryDrawer()
    {
        _showChatHistoryDrawer = false;
        _selectedConfigForHistory = null;
    }

    private void ClearAllChatHistory()
    {
        foreach (var config in _testConfigs)
        {
            config.ChatHistory.Clear();
        }
        _message.Success("所有聊天历史已清空");
        CloseChatHistoryDrawer();
        StateHasChanged();
    }

    private void ClearChatHistory(PromptTestConfig config)
    {
        config.ChatHistory.Clear();
        _message.Success($"{GetConfigName(config)} 的聊天历史已清空");
        StateHasChanged();
    }

    private async Task HandleTestInputKeyDown(KeyboardEventArgs e)
    {
        // Ctrl+Enter 发送消息
        if (e.CtrlKey && e.Key == "Enter" && !_testLoading)
        {
            await RunTests();
        }
        // Esc 清空输入框
        else if (e.Key == "Escape")
        {
            _testContent = string.Empty;
            StateHasChanged();
        }
    }

    private string GetConfigName(PromptTestConfig config)
    {
        if (config.Type == "Model")
        {
            var model = _availableConfigs.FirstOrDefault(c => c.Id == config.ConfigId);
            return model != null ? $"{model.Name} ({model.Model})" : config.ConfigId ?? "Unknown";
        }
        else if (config.Type == "Endpoint")
        {
            var endpoint = _availableEndpoints.FirstOrDefault(e => e.Id == config.ConfigId);
            return endpoint?.Name ?? config.ConfigId ?? "Unknown";
        }
        else
        {
            return config.ConfigId ?? "Unknown";
        }
    }

    private async Task SaveTestHistory()
    {
        if (_editingPrompt.Id == null)
        {
            // Save the prompt first if it's new
            await SavePrompt();
        }

        if (_editingPrompt.Id != null)
        {
            var history = new LlmPromptHistory
            {
                PromptId = _editingPrompt.Id,
                Content = _editingPrompt.Content,  // Use current content
                BasedOnVersion = _editingPrompt.Version,
                ModelParameters = _editingPrompt.ModelParameters,
                TestConfigs = _testConfigs.Select(c => new TestConfigRecord
                {
                    Type = c.Type,
                    ConfigId = c.ConfigId,
                    Parameters = c.Parameters,
                    Success = true, // 现在总是成功（因为历史记录中有内容）
                    // 🔥 保存测试输入
                    TestInput = _testContent,
                    // 🔥 从 ChatHistory 构建响应文本（向后兼容）
                    Response = string.Join("\n", c.ChatHistory
                        .Where(m => m.Role.Value == "assistant")
                        .Select(m => m.Text ?? string.Empty)
                        .Where(t => !string.IsNullOrEmpty(t))),
                    // 🔥 保存 ChatHistory（新格式）
                    ChatHistory = c.ChatHistory.ToList(),
                    Error = null,
                    // Add model/endpoint information
                    ConfigName = c.Type == "Model" 
                        ? _availableConfigs.FirstOrDefault(m => m.Id == c.ConfigId)?.Name 
                        : _availableEndpoints.FirstOrDefault(e => e.Id == c.ConfigId)?.Name,
                    ModelType = c.Type == "Model"
                        ? _availableConfigs.FirstOrDefault(m => m.Id == c.ConfigId)?.ModelType?.Name
                        : null,
                    // Save parameter values
                    ParameterValues = new Dictionary<string, string>(_parameterValues)
                }).ToList()
            };

            await LlmPoolService.SavePromptHistoryAsync(history);
        }
    }

    private async Task ShowHistory()
    {
        if (string.IsNullOrEmpty(_editingPrompt.Id))
        {
            return;
        }

        _showHistoryDrawer = true;
        _historyLoading = true;

        try
        {
            _promptHistory = await LlmPoolService.GetPromptHistoryAsync(_editingPrompt.Id);
        }
        finally
        {
            _historyLoading = false;
        }
    }

    private void CloseHistoryDrawer()
    {
        _showHistoryDrawer = false;
        _promptHistory.Clear();
    }

    private async Task LoadHistoryVersion(LlmPromptHistory history)
    {
        // Create a new prompt based on the history version
        _editingPrompt = new LlmPrompt
        {
            Id = history.PromptId,
            Name = _editingPrompt.Name, // Keep the current name
            Description = _editingPrompt.Description, // Keep the current description
            Content = history.Content,
            Version = history.Version,
            ModelParameters = history.ModelParameters,
            CreateTime = _editingPrompt.CreateTime,
            UpdateTime = DateTime.UtcNow
        };

        await LoadTestConfigsAndParameters(history.TestConfigs);

        // Update parameters based on the loaded content
        if (!string.IsNullOrEmpty(_editingPrompt.Content))
        {
            UpdatePromptParameters(_editingPrompt.Content);
        }

        // Close the drawer
        CloseHistoryDrawer();

        // Show success message
        _message.Success($"Loaded version {history.Version}");
    }

    private async Task DeleteHistoryRecord(LlmPromptHistory history)
    {
        try
        {
            await LlmPoolService.DeletePromptHistoryAsync(history.Id);
            _message.Success("History record deleted successfully");
            
            // Refresh the history list
            if (_showHistoryDrawer)
            {
                await ShowHistory();
            }
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to delete history record: {ex.Message}");
        }
    }

    // Tool selection helper class
    private class ToolSelectionItem
    {
        public string Value { get; set; } = string.Empty; // Format: "{ToolType}:{ToolId}"
        public string Label { get; set; } = string.Empty; // Tool name
        public string ToolType { get; set; } = string.Empty; // "Internal" or "Mcp"
        public string ToolId { get; set; } = string.Empty; // Actual tool ID
    }

    // Tree node for TreeSelect component
    private class ToolTreeNode
    {
        public ToolTreeNode(string title, string key, bool isCategory = false)
        {
            Title = title;
            Key = key;
            IsCategory = isCategory;
            Disabled = isCategory; // 类别节点不可选
            Children = new List<ToolTreeNode>();
        }

        public string Title { get; set; }
        public string Key { get; set; }
        public bool Disabled { get; set; }
        public string? ToolType { get; set; } // "App" or "Mcp"
        public bool IsCategory { get; set; } // true for category nodes
        public List<ToolTreeNode> Children { get; set; }
    }

    // 滚动到流式响应底部
    private async Task ScrollToStreamingBottom(string configId)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom", $"chat-history-{configId}");
        }
        catch (Exception ex)
        {
            // 静默失败，滚动不是关键功能
            Logger.LogDebug(ex, "Failed to scroll to streaming response bottom");
        }
    }

    private string ToJson<T>(T obj)
    {
        return JsonSerializer.Serialize(obj, new JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
    }
}
