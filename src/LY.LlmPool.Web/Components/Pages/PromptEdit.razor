<script>
    window.scrollToBottom = function (elementId) {
        try {
            var element = document.getElementById(elementId);
            if (element) {
                // 使用 scrollTo 实现平滑滚动
                element.scrollTo({
                    top: element.scrollHeight,
                    behavior: 'smooth'
                });
                console.log('Scrolled to bottom:', elementId, 'scrollHeight:', element.scrollHeight);
            } else {
                console.warn('Element not found:', elementId);
            }
        } catch (e) {
            console.error('Scroll error:', e);
        }
    };

    // 草稿自动保存功能
    window.promptDraft = {
        save: function (promptId, data) {
            try {
                const key = `prompt_draft_${promptId || 'new'}`;
                localStorage.setItem(key, JSON.stringify(data));
                console.log('Draft saved:', key);
            } catch (e) {
                console.error('Failed to save draft:', e);
            }
        },
        load: function (promptId) {
            try {
                const key = `prompt_draft_${promptId || 'new'}`;
                const data = localStorage.getItem(key);
                console.log('Draft loaded:', key, data ? 'found' : 'not found');
                return data ? JSON.parse(data) : null;
            } catch (e) {
                console.error('Failed to load draft:', e);
                return null;
            }
        },
        clear: function (promptId) {
            try {
                const key = `prompt_draft_${promptId || 'new'}`;
                localStorage.removeItem(key);
                console.log('Draft cleared:', key);
            } catch (e) {
                console.error('Failed to clear draft:', e);
            }
        }
    };
</script>

@code {
    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Version { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public bool Restore { get; set; }

    private List<LlmConfig> _availableConfigs = new();
    private List<LlmEndpoint> _availableEndpoints = new();
    private bool _testLoading;
    private CancellationTokenSource? _testCancellationTokenSource;

    // Prompt优化相关
    private bool _showOptimizeModal = false;
    private bool _optimizing = false;
    private string? _optimizeConfigId;
    private string? _optimizeRequirement = string.Empty;
    private string _optimizedContent = string.Empty;
    private CancellationTokenSource? _optimizeCancellationTokenSource;
    private string _selectedTestType = "Model";
    private string? _selectedConfigId;
    private string? _selectedEndpointId;
    private LlmPrompt _editingPrompt = new();
    private List<PromptTestConfig> _testConfigs = new();
    // 记录正在评分的配置Id，用于在 UI 中显示“评分中”状态
    private HashSet<string> _scoringInProgressIds = new();
    private bool _showHistoryDrawer;
    private bool _historyLoading;
    private List<LlmPromptHistory> _promptHistory = new();
    private List<ParameterInfo> _promptParameters = new(); // 改为存储完整参数信息
    private Dictionary<string, string> _parameterValues = new();

    // Tool selection
    private List<ToolSelectionItem> _availableTools = new();
    private IEnumerable<string> _selectedToolIds = Array.Empty<string>();
    private List<ToolTreeNode> _toolTreeData = new(); // 树形结构数据

    private string _testContent = string.Empty;
    private TextArea? _testInputRef;
    private bool _showChatHistoryDrawer = false;
    private PromptTestConfig? _selectedConfigForHistory = null;

    // 草稿自动保存
    private System.Threading.Timer? _autoSaveTimer;
    private bool _hasPendingChanges = false;
    private const int AutoSaveDelayMs = 2000; // 2秒延迟

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        if (!string.IsNullOrEmpty(Id))
        {
            if (!string.IsNullOrEmpty(Version))
            {
                await LoadHistoryVersion();
            }
            else
            {
                await LoadPrompt();
            }

            if (!string.IsNullOrEmpty(_editingPrompt.Content))
            {
                UpdatePromptParameters(_editingPrompt.Content);
            }
        }

        // 尝试加载草稿
        await LoadDraftAsync();
    }

    public void Dispose()
    {
        _autoSaveTimer?.Dispose();
        _testCancellationTokenSource?.Dispose();
        _optimizeCancellationTokenSource?.Dispose();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _availableConfigs = await LlmPoolService.GetConfigsAsync();
            _availableEndpoints = await LlmPoolService.GetEndpointsAsync();
            await LoadAvailableToolsAsync();
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to load data: {ex.Message}");
        }
    }

    private async Task LoadAvailableToolsAsync()
    {
        try
        {
            var tools = await ToolMetadataService.GetAllToolsAsync();
            _availableTools = tools.Select(t => new ToolSelectionItem
            {
                Value = $"{t.Source}:{t.SourceId}",
                Label = t.Name,
                ToolType = t.Source.ToString(), // "App" or "Mcp"
                ToolId = t.SourceId // SourceId 现在已经是 string 类型
            }).ToList();

            // 构建树形数据结构
            await BuildToolTreeData(tools);

            Logger.LogInformation("=== LoadAvailableToolsAsync ===");
            Logger.LogInformation("Loaded {Count} available tools", _availableTools.Count);
            foreach (var tool in _availableTools)
            {
                Logger.LogInformation("  Available Tool:");
                Logger.LogInformation("    Value: {Value}", tool.Value);
                Logger.LogInformation("    Label: {Label}", tool.Label);
                Logger.LogInformation("    Type: {Type}", tool.ToolType);
                Logger.LogInformation("    ToolId: {ToolId}", tool.ToolId);
            }
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to load tools: {ex.Message}");
        }
    }

    private async Task BuildToolTreeData(List<ToolMetadata> tools)
    {
        _toolTreeData = new List<ToolTreeNode>();

        // 分组：App Tools 和 MCP Tools
        var appTools = tools.Where(t => t.Source == ToolSource.App).ToList();
        var mcpTools = tools.Where(t => t.Source == ToolSource.MCP).ToList();

        // 添加 App Tools 分类
        if (appTools.Any())
        {
            var appCategoryNode = new ToolTreeNode("📱 App Tools", "category_app", isCategory: true)
            {
                ToolType = "App"
            };

            // 添加子节点
            foreach (var tool in appTools)
            {
                var displayTitle = string.IsNullOrWhiteSpace(tool.Description) 
                    ? tool.Name 
                    : $"{tool.Name} - {tool.Description}";

                appCategoryNode.Children.Add(new ToolTreeNode(displayTitle, $"App:{tool.SourceId}")
                {
                    ToolType = "App"
                });
            }

            _toolTreeData.Add(appCategoryNode);
        }

        // 添加 MCP Tools 分类（按 MCP Server 分组）
        if (mcpTools.Any())
        {
            // 按 McpServerId 分组
            var mcpServerGroups = mcpTools.GroupBy(t => t.SourceId.Split(':')[0]).ToList();

            // 获取 MCP Server 配置以获取服务器名称
            var mcpServers = await LlmPoolService.GetMcpServerConfigsAsync();
            var mcpServerDict = mcpServers.ToDictionary(s => s.Id, s => s.Name);

            foreach (var serverGroup in mcpServerGroups)
            {
                var serverId = serverGroup.Key;
                var serverName = mcpServerDict.TryGetValue(serverId, out var name) ? name : serverId;

                var mcpServerNode = new ToolTreeNode($"🔌MCP Server: {serverName}", $"category_mcp_{serverId}", isCategory: true)
                {
                    ToolType = "Mcp"
                };

                // 添加子节点
                foreach (var tool in serverGroup)
                {
                    var displayTitle = string.IsNullOrWhiteSpace(tool.Description) 
                        ? tool.Name 
                        : $"{tool.Name} - {tool.Description}";

                    mcpServerNode.Children.Add(new ToolTreeNode(displayTitle, $"MCP:{tool.SourceId}")
                    {
                        ToolType = "Mcp"
                    });
                }

                _toolTreeData.Add(mcpServerNode);
            }
        }

        Logger.LogInformation("Built tree data with {Count} top-level nodes", _toolTreeData.Count);
    }

    private async Task LoadPromptToolsAsync()
    {
        if (string.IsNullOrEmpty(_editingPrompt.Id))
            return;

        try
        {
            var promptTools = await PromptService.GetPromptToolsAsync(_editingPrompt.Id);

            // 映射 ToolType 到 ToolSource 格式
            _selectedToolIds = promptTools.Select(pt => 
            {
                var sourceType = pt.ToolType == ToolType.Internal ? "App" : "MCP";
                var value = $"{sourceType}:{pt.ToolId}";

                return value;
            }).ToArray();

            // 通知 Blazor 组件状态已更改
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to load prompt tools: {ex.Message}");
            Logger.LogError(ex, "Error loading prompt tools for {PromptId}", _editingPrompt.Id);
        }
    }

    private async Task LoadTestConfigsAndParameters(List<TestConfigRecord>? testConfigs)
    {
        if (testConfigs?.Any() == true)
        {
            _testConfigs = testConfigs.Select(c => new PromptTestConfig
            {
                Type = c.Type,
                ConfigId = c.ConfigId ?? string.Empty,
                Parameters = c.Parameters,
                // 🔥 加载 ChatHistory（如果存在）
                ChatHistory = c.ChatHistory?.Any() == true 
                    ? new List<AIChatMessage>(c.ChatHistory) 
                    : new List<AIChatMessage>(),
                TestResult = new PromptTestResult
                {
                    Success = c.Success,
                    Error = c.Error,
                    // 保留 ResponseSegments 用于向后兼容
                    Segments = c.ResponseSegments?.Any() == true
                        ? c.ResponseSegments.ToList()
                        : !string.IsNullOrEmpty(c.Response)
                            ? new List<ResponseSegment>
                            {
                                new ResponseSegment
                                {
                                    Type = ResponseSegmentType.Text,
                                    Text = c.Response
                                }
                            }
                            : new List<ResponseSegment>()
                }
            }).ToList();

            // 🔥 回显测试输入（如果存在）
            if (!string.IsNullOrEmpty(testConfigs.First().TestInput))
            {
                _testContent = testConfigs.First().TestInput!;
            }

            // Restore parameter values if they exist
            if (testConfigs.First().ParameterValues?.Any() == true)
            {
                _parameterValues = new Dictionary<string, string>(testConfigs.First().ParameterValues);
            }

            // 🎯 加载完成后,触发 UI 更新并滚动到底部
            StateHasChanged();

            // 使用 InvokeAsync 确保在下一个渲染周期后执行滚动
            await InvokeAsync(async () =>
            {
                await Task.Delay(150); // 等待 DOM 渲染

                // 为每个有历史记录的配置滚动到底部
                foreach (var config in _testConfigs.Where(c => c.ChatHistory.Any()))
                {
                    try
                    {
                        await ScrollToStreamingBottom(config.ConfigId);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogDebug(ex, "Failed to scroll chat history after loading for config {ConfigId}", config.ConfigId);
                    }
                }
            });
        }
        else
        {
            // Add a default test configuration if none exists
            _testConfigs = new List<PromptTestConfig>
            {
                new PromptTestConfig { Type = "Model" }
            };
        }
    }

    private async Task LoadPrompt()
    {
        try
        {
            var prompt = await PromptService.GetPromptByIdAsync(Id!);
            if (prompt == null)
            {
                _message.Error("Prompt not found");
                NavigationManager.NavigateTo("/prompt-list");
                return;
            }

            _editingPrompt = prompt;

            // Load the latest history record
            var history = await PromptService.GetPromptHistoryAsync(Id);
            var latestHistory = history.OrderByDescending(h => h.CreateTime).FirstOrDefault();

            if (latestHistory != null)
            {
                // Update prompt content from latest history
                _editingPrompt.Content = latestHistory.Content;
                _editingPrompt.Version = latestHistory.Version;
            }

            await LoadTestConfigsAndParameters(latestHistory?.TestConfigs);

            // Load associated tools
            await LoadPromptToolsAsync();

            // Update parameters based on the loaded content
            if (!string.IsNullOrEmpty(_editingPrompt.Content))
            {
                UpdatePromptParameters(_editingPrompt.Content);
            }
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to load prompt: {ex.Message}");
            NavigationManager.NavigateTo("/prompt-list");
        }
    }

    private async Task LoadHistoryVersion()
    {
        try
        {
            var history = await PromptService.GetPromptHistoryAsync(Id);
            var version = history.FirstOrDefault(h => h.Version.ToString() == Version);
            if (version == null)
            {
                _message.Error("Version not found");
                NavigationManager.NavigateTo("/prompt-list");
                return;
            }

            _editingPrompt = new LlmPrompt
            {
                Id = Restore ? version.PromptId : null,
                Name = _editingPrompt.Name, // Keep the current name
                Description = _editingPrompt.Description, // Keep the current description
                Content = version.Content,
                Version = version.Version
            };

            await LoadTestConfigsAndParameters(version.TestConfigs);

            // Update parameters based on the loaded content
            if (!string.IsNullOrEmpty(_editingPrompt.Content))
            {
                UpdatePromptParameters(_editingPrompt.Content);
            }
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to load history version: {ex.Message}");
            NavigationManager.NavigateTo("/prompt-list");
        }
    }

