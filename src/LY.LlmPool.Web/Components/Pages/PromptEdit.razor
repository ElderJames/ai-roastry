    #region 测试评分功能

    private async Task ScoreAllTestResults()
    {
        foreach (var config in _testConfigs)
        {
            if (config.TestResult == null) continue;
            if (!config.TestResult.Success) continue;

            // 如果已经评分，跳过
            if (config.TestResult.Score.HasValue) continue;

            try
            {
                // 标记为正在评分（UI 将显示“评分中”）
                if (!string.IsNullOrEmpty(config.ConfigId))
                {
                    _scoringInProgressIds.Add(config.ConfigId);
                    StateHasChanged();
                }

                // 取最后的文本响应（合并所有文本片段）
                var responseText = string.Join("\n", config.TestResult.Segments
                    .Where(s => s.Type == ResponseSegmentType.Text && !string.IsNullOrEmpty(s.Text))
                    .Select(s => s.Text!.Trim())
                ).Trim();

                if (string.IsNullOrWhiteSpace(responseText))
                {
                    Logger.LogDebug("No textual response to score for config {ConfigId}", config.ConfigId);
                    continue;
                }

                var promptContent = _editingPrompt.Content ?? string.Empty;

                var score = await ScoreResponseAsync(promptContent, responseText, config);
                if (score != null)
                {
                    config.TestResult.Score = score.Score;
                    config.TestResult.ScoreComment = score.Comment;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to score test result for config {ConfigId}", config.ConfigId);
            }
            finally
            {
                // 清除评分中标记
                if (!string.IsNullOrEmpty(config.ConfigId))
                {
                    _scoringInProgressIds.Remove(config.ConfigId);
                    StateHasChanged();
                }
            }
        }
    }

    /// <summary>
    /// 为单个配置执行评分（在其测试完成后立即调用）。
    /// </summary>
    private async Task ScoreSingleTestResultAsync(PromptTestConfig config)
    {
        if (config == null || config.TestResult == null) return;
        if (!config.TestResult.Success) return;
        if (config.TestResult.Score.HasValue) return;

        if (string.IsNullOrEmpty(config.ConfigId))
        {
            Logger.LogDebug("Skip scoring because ConfigId is empty");
            return;
        }

        try
        {
            _scoringInProgressIds.Add(config.ConfigId);
            await InvokeAsync(StateHasChanged);

            var responseText = string.Join("\n", config.ChatHistory.SelectMany(s => s.Contents)
                .OfType<TextContent>()
                .Select(s => s.Text!.Trim()))
                .Trim();

            if (string.IsNullOrWhiteSpace(responseText))
            {
                Logger.LogDebug("No textual response to score for config {ConfigId}", config.ConfigId);
                return;
            }

            var promptContent = _editingPrompt.Content ?? string.Empty;
            var score = await ScoreResponseAsync(promptContent, responseText, config);
            if (score != null)
            {
                config.TestResult.Score = score.Score;
                config.TestResult.ScoreComment = score.Comment;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to score single test result for config {ConfigId}", config.ConfigId);
        }
        finally
        {
            if (!string.IsNullOrEmpty(config.ConfigId))
            {
                _scoringInProgressIds.Remove(config.ConfigId);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private class ScoreResult
    {
        public int Score { get; set; }
        public string Comment { get; set; } = string.Empty;
    }

    private async Task<ScoreResult?> ScoreResponseAsync(string promptContent, string responseText, PromptTestConfig config)
    {
        try
        {
            // 读取评分模板
            var candidates = new[]
            {
                Path.Combine(Env.ContentRootPath ?? string.Empty, "PromptTemplates", "ScorePrompt.txt"),
                Path.Combine(AppContext.BaseDirectory ?? string.Empty, "PromptTemplates", "ScorePrompt.txt"),
            };
            var templatePath = candidates.FirstOrDefault(File.Exists);
            if (templatePath == null)
            {
                Logger.LogWarning("Score template not found. Tried: {Candidates}", string.Join(";", candidates));
                return null;
            }

            var template = await File.ReadAllTextAsync(templatePath);
            var systemPrompt = template.Replace("{{$content}}", promptContent).Replace("{{$response}}", responseText);

            var messages = new List<AIChatMessage>
            {
                new AIChatMessage(ChatRole.System, systemPrompt),
                new AIChatMessage(ChatRole.User, "请按要求输出 JSON 评分结果。")
            };

            var chatOptions = new ChatOptions { Temperature = 0.0f, MaxOutputTokens = 256 };

            // 获取 LlmConfig 并创建客户端
            var llmConfig = await LlmPoolService.GetConfigByIdAsync(config.ConfigId);
            if (llmConfig == null)
            {
                Logger.LogWarning("Cannot score because config not found: {ConfigId}", config.ConfigId);
                return null;
            }

            var chatClient = _chatClientFactory.CreateClientWithHttpClient(llmConfig);
            var response = await chatClient.GetResponseAsync(messages, chatOptions);
            var text = response.Text ?? string.Empty;

            // 尝试解析 JSON
            try
            {
                // 可能返回纯 JSON 或带编码块，尝试提取第一个 JSON 对象
                var jsonStart = text.IndexOf('{');
                var jsonEnd = text.LastIndexOf('}');
                if (jsonStart >= 0 && jsonEnd > jsonStart)
                {
                    var json = text.Substring(jsonStart, jsonEnd - jsonStart + 1);
                    var doc = System.Text.Json.JsonSerializer.Deserialize<JsonElement>(json);
                    var score = doc.TryGetProperty("score", out var s) && s.ValueKind == JsonValueKind.Number ? s.GetInt32() : 0;
                    var comment = doc.TryGetProperty("comment", out var c) && c.ValueKind == JsonValueKind.String ? c.GetString() ?? string.Empty : string.Empty;
                    return new ScoreResult { Score = Math.Clamp(score, 0, 100), Comment = comment };
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to parse scoring output: {Text}", text);
            }

            // 解析失败，尝试从文本中提取数字
            var digits = System.Text.RegularExpressions.Regex.Match(text, "(\\d{1,3})");
            if (digits.Success && int.TryParse(digits.Value, out var parsed))
            {
                return new ScoreResult { Score = Math.Clamp(parsed, 0, 100), Comment = text.Replace(digits.Value, "").Trim() };
            }

            return null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ScoreResponseAsync failed for config {ConfigId}", config.ConfigId);
            return null;
        }
    }

