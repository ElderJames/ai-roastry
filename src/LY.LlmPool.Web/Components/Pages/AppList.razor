@page "/app-list"
@using LY.LlmPool.Web.Services
@using LY.LlmPool.Web.Data.Entities
@using LY.LlmPool.Web.Models
@using AntDesign
@using AntDesign.TableModels
@inject AppService AppService
@inject PromptService PromptService
@inject LY.LlmPool.Web.Services.ConfigService ConfigService
@inject EndpointService EndpointService
@inject LlmPoolService LlmPoolService
@inject MessageService _message
@inject NavigationManager NavigationManager

<PageTitle>App List</PageTitle>

<Card>
    <TitleTemplate>
        <div class="d-flex justify-content-between align-items-center">
            <div>App List</div>
            <div>
                <div data-testid="app-add">
                    <Button Type="@ButtonType.Primary" OnClick="AddNewApp">
                        <Icon Type="plus" />
                        Add New App
                    </Button>
                </div>
                <div class="ml-2" data-testid="app-wizard-launch">
                    <Button OnClick="StartAgentGroupFlow">
                        <Icon Type="deployment-unit" />
                        AgentGroup 向导
                    </Button>
                </div>
            </div>
        </div>
    </TitleTemplate>
    <ChildContent>
        <Table TItem="LlmApp" DataSource="@_apps" Loading="_loading">
            <Column Title="Name" TData="LlmApp">
                @{ var iconType = context.AppType == "Prompt" ? "message" : "robot"; }
                <Space>
                    <SpaceItem>
                        <Icon Type="@iconType" />
                    </SpaceItem>
                    <SpaceItem>
                        <span data-testid="app-row-name" data-app-name="@context.Name">@context.Name</span>
                    </SpaceItem>
                </Space>
            </Column>
            <PropertyColumn Property="c=>c.AppType" Title="Type">
                @{ var tagColor = context.AppType == "Prompt" ? "blue" : "green"; }
                <Tag Color="@tagColor">@context.AppType</Tag>
            </PropertyColumn>
            <PropertyColumn Property="c=>c.Description" Title="Description" />
            <Column Title="Prompt" TData="string">
                @if (!string.IsNullOrEmpty(context.PromptId)) { <Tag>@context.Prompt?.Name</Tag> }
                else { <span class="text-muted">Not Set</span> }
            </Column>
            <Column Title="Configuration" TData="string">
                @{ var cfgColor = !string.IsNullOrEmpty(context.LlmConfigId) ? "blue" : (!string.IsNullOrEmpty(context.EndpointId) ? "green" : string.Empty); }
                @if (!string.IsNullOrEmpty(context.LlmConfigId)) { <Tag Color="@cfgColor">Model: @context.LlmConfig?.Name</Tag> }
                else if (!string.IsNullOrEmpty(context.EndpointId)) { <Tag Color="@cfgColor">Endpoint: @context.Endpoint?.Name</Tag> }
                else { <span class="text-muted">Not Set</span> }
            </Column>
            <PropertyColumn Property="c=>c.IsEnabled" Title="Status">
                @if (context.IsEnabled) { <Badge Status="@BadgeStatus.Success" Text="Enabled" /> } else { <Badge Status="@BadgeStatus.Default" Text="Disabled" /> }
            </PropertyColumn>
            <PropertyColumn Property="c=>c.UpdatedAt" Title="Last Modified" Format="yyyy-MM-dd HH:mm:ss" />
            <ActionColumn Title="Action">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="() => EditApp(context)"><Icon Type="edit" /> Edit</Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Type="@ButtonType.Default" OnClick="() => TestApp(context)"><Icon Type="play-circle" /> Test</Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="Are you sure to delete this app?" OkText="Yes" CancelText="No" OnConfirm="() => DeleteApp(context)">
                            <Button Danger><Icon Type="delete" /></Button>
                        </Popconfirm>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    </ChildContent>
</Card>

<!-- App Edit Modal -->
<Modal Title="@ModalTitle" Visible="_showEditModal" OnOk="SaveApp" OnCancel="CancelEdit" OkText="@("保存")" CancelText="@("取消")" ConfirmLoading="_saving" Width="800">
    <Form Model="_editingApp" ValidateOnChange="true">
        <Row Gutter="16">
            <AntDesign.Col Span="12">
                <FormItem Label="Name" Required>
                    <Input @bind-Value="_editingApp.Name" Placeholder="Enter app name" />
                </FormItem>
            </AntDesign.Col>
            <AntDesign.Col Span="12">
                <FormItem Label="Type" Required>
                    <div data-testid="app-type-select">
                        <Select TItemValue="string" TItem="string" @bind-Value="_editingApp.AppType" Placeholder="Select app type" DataSource="LlmAppTypes.All" />
                    </div>
                </FormItem>
            </AntDesign.Col>
        </Row>

        @if (_editingApp.AppType == LlmAppTypes.AgentGroup)
        {
            <FormItem>
                <div class="d-flex align-items-center">
                    <div class="mr-2 text-muted">需要批量配置 Agent 成员？</div>
                    <div data-testid="app-modal-wizard">
                        <Button Type="@ButtonType.Dashed" OnClick="() => _showWizardDialog = true">
                            <Icon Type="deployment-unit" /> 使用 AgentGroup 向导配置
                        </Button>
                    </div>
                </div>
            </FormItem>
        }

        <FormItem Label="Description">
            <TextArea @bind-Value="_editingApp.Description" Placeholder="Enter description" Rows="3" />
        </FormItem>

        <Row Gutter="16">
            <AntDesign.Col Span="12">
                <FormItem Label="Prompt">
                    <Select TItemValue="string" TItem="LlmPrompt" @bind-Value="_editingApp.PromptId" ValueName="Id" LabelName="Name" Placeholder="Select a prompt (optional)" AllowClear="true" DataSource="_prompts" />
                </FormItem>
            </AntDesign.Col>
            <AntDesign.Col Span="12">
                <FormItem Label="Configuration Type">
                    <RadioGroup @bind-Value="_configType">
                        <Radio Value="@("model")">Model Configuration</Radio>
                            <Radio Value="@("endpoint")">Endpoint Configuration</Radio>
                    </RadioGroup>
                </FormItem>
            </AntDesign.Col>
        </Row>

        @if (_configType == "model")
        {
            <FormItem Label="Model Configuration">
                <Select TItemValue="string" TItem="LlmConfig" @bind-Value="_editingApp.LlmConfigId" ValueName="Id" LabelName="Name" Placeholder="Select a model configuration" OnSelectedItemChanged="OnModelConfigChanged" DataSource="_llm_configs" />
            </FormItem>
        }
        else if (_configType == "endpoint")
        {
            <FormItem Label="Endpoint Configuration">
                <Select TItemValue="string" TItem="LlmEndpoint" @bind-Value="_editingApp.EndpointId" ValueName="Id" LabelName="Name" Placeholder="Select an endpoint configuration" OnSelectedItemChanged="OnEndpointConfigChanged" DataSource="_endpoints" />
            </FormItem>
        }

        <FormItem>
            <Checkbox @bind-Value="_editingApp.IsEnabled">Enabled</Checkbox>
        </FormItem>

        @if (!string.IsNullOrEmpty(_selectedConfigInfo))
        {
            <Alert Type="@AlertType.Info" Message="Configuration Info" Description="@_selectedConfigInfo" ShowIcon="true" />
        }

        <FormItem Label="Quick Copy">
            <div>
                <div>
                    <span class="text-muted">Base URL: </span>
                    <Text Copyable CopyConfig="copyableConfig">@_apiBase</Text>
                </div>
                <div>
                    <span class="text-muted">Model Name: </span>
                    <Text Copyable CopyConfig="copyableConfig">@_editingApp.Name</Text>
                </div>
                <div>
                    <span class="text-muted">Endpoint: </span>
                    <code>/v1/chat/completions</code>
                </div>
            </div>
        </FormItem>
    </Form>
</Modal>

@code {
    private List<LlmApp> _apps = new();
    private List<LlmPrompt> _prompts = new();
    private List<LlmConfig> _llm_configs = new();
    private List<LlmEndpoint> _endpoints = new();
    private bool _loading;
    private bool _showEditModal;
    private bool _saving;
    private bool _isEditing;
    private LlmApp _editingApp = new();
    private string _configType = "model";
    private string? _selectedConfigInfo;
    private TypographyCopyableConfig? copyableConfig;
    private List<AgentMember> _members = new();

    private string _apiBase => NavigationManager.BaseUri.TrimEnd('/') + "/v1";
    private string ModalTitle => _isEditing ? "Edit App" : "Create App";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await LoadSelectDataAsync();
        copyableConfig = new() { OnCopy = () => { _message.Success("已复制"); } };
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try { _apps = await AppService.GetAppsAsync(); }
        finally { _loading = false; }
    }

    private async Task LoadSelectDataAsync()
    {
        _prompts = await PromptService.GetPromptsAsync();
        _llm_configs = await ConfigService.GetConfigsAsync();
        _endpoints = await EndpointService.GetEndpointsAsync();
    }

    private void AddNewApp()
    {
        _isEditing = false;
        _editingApp = new LlmApp { AppType = LlmAppTypes.Prompt, IsEnabled = true, PromptId = string.Empty, LlmConfigId = string.Empty, EndpointId = string.Empty };
        _configType = "model";
        _selectedConfigInfo = null;
        _showEditModal = true;
    }

    private void StartAgentGroupFlow()
    {
        _isEditing = false;
        _editingApp = new LlmApp
        {
            AppType = LlmAppTypes.AgentGroup,
            IsEnabled = true,
            PromptId = string.Empty,
            LlmConfigId = string.Empty,
            EndpointId = string.Empty
        };
        _configType = "model";
        _selectedConfigInfo = null;
        _members = new List<AgentMember>();
        _showEditModal = true;
        _showWizardDialog = true;
    }

    private async Task EditApp(LlmApp app)
    {
        _isEditing = true;
        _editingApp = new LlmApp { Id = app.Id, Name = app.Name, Description = app.Description, AppType = app.AppType, PromptId = app.PromptId ?? string.Empty, LlmConfigId = app.LlmConfigId ?? string.Empty, EndpointId = app.EndpointId ?? string.Empty, IsEnabled = app.IsEnabled, ConfigJson = app.ConfigJson };
        if (!string.IsNullOrEmpty(_editingApp.LlmConfigId)) { _configType = "model"; OnModelConfigChanged(); }
        else if (!string.IsNullOrEmpty(_editingApp.EndpointId)) { _configType = "endpoint"; OnEndpointConfigChanged(); }
        if (_editingApp.AppType == LlmAppTypes.AgentGroup) { _members = await LlmPoolService.GetAgentMembersAsync(app.Id!); }
        _showEditModal = true;
    }

    private void TestApp(LlmApp app) => NavigationManager.NavigateTo($"/chat-test?app={app.Name}");

    private async Task DeleteApp(LlmApp app)
    {
        try { await AppService.DeleteAppAsync(app.Id!); await LoadDataAsync(); _message.Success("App deleted successfully"); }
        catch (Exception ex) { _message.Error($"Failed to delete app: {ex.Message}"); }
    }

    private void OnModelConfigChanged()
    {
        if (!string.IsNullOrEmpty(_editingApp.LlmConfigId)) { var config = _llm_configs.FirstOrDefault(c => c.Id == _editingApp.LlmConfigId); if (config != null) _selectedConfigInfo = $"Model: {config.Model}, Base URL: {config.BaseUrl}"; _editingApp.EndpointId = null; }
        else { _selectedConfigInfo = null; }
        StateHasChanged();
    }

    private void OnEndpointConfigChanged()
    {
        if (!string.IsNullOrEmpty(_editingApp.EndpointId)) { var endpoint = _endpoints.FirstOrDefault(e => e.Id == _editingApp.EndpointId); if (endpoint != null) _selectedConfigInfo = $"Endpoint: {endpoint.Name}, Description: {endpoint.Description}"; _editingApp.LlmConfigId = null; }
        else { _selectedConfigInfo = null; }
        StateHasChanged();
    }

    private async Task SaveApp()
    {
        if (string.IsNullOrWhiteSpace(_editingApp.Name)) { _message.Error("Name is required"); return; }
        if (string.IsNullOrWhiteSpace(_editingApp.AppType)) { _message.Error("App type is required"); return; }
        if (_editingApp.AppType == LlmAppTypes.Prompt && string.IsNullOrEmpty(_editingApp.LlmConfigId) && string.IsNullOrEmpty(_editingApp.EndpointId)) { _message.Error("Please select either a model configuration or an endpoint configuration"); return; }
        if (_editingApp.AppType == LlmAppTypes.AgentGroup && (_members == null || _members.Count == 0)) { _message.Error("Please add at least one agent member"); return; }

        _saving = true;
        try
        {
            if (_isEditing)
            {
                await AppService.UpdateAppAsync(_editingApp);
                if (_editingApp.AppType == LlmAppTypes.AgentGroup)
                {
                    var existing = await LlmPoolService.GetAgentMembersAsync(_editingApp.Id!);
                    foreach (var em in existing) await LlmPoolService.DeleteAgentMemberAsync(em.Id);
                    foreach (var m in _members) { m.LlmAppId = _editingApp.Id!; await LlmPoolService.AddAgentMemberAsync(m); }
                }
                _message.Success("App updated successfully");
            }
            else
            {
                var created = await AppService.AddAppAsync(_editingApp);
                if (_editingApp.AppType == LlmAppTypes.AgentGroup)
                {
                    foreach (var m in _members) { m.LlmAppId = created.Id!; await LlmPoolService.AddAgentMemberAsync(m); }
                }
                _message.Success("App created successfully");
            }

            _showEditModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex) { _message.Error($"Failed to save app: {ex.Message}"); }
        finally { _saving = false; }
    }

    private void CancelEdit() => _showEditModal = false;

    // Wizard dialog state and handlers
    private bool _showWizardDialog = false;

    private async Task HandleWizardCreated(AgentGroupWizardResult? result)
    {
        _showWizardDialog = false;
        if (result == null) return;

        await LoadSelectDataAsync();

        _members = result.Members ?? new List<AgentMember>();

        foreach (var member in _members)
        {
            if (string.IsNullOrWhiteSpace(member.LlmConfigId))
            {
                member.LlmConfigId = null;
            }
            else if (!_llm_configs.Any(c => c.Id == member.LlmConfigId))
            {
                var config = _llm_configs.FirstOrDefault(c => string.Equals(c.Name, member.LlmConfigId, StringComparison.OrdinalIgnoreCase));
                member.LlmConfigId = config?.Id;
            }

            if (string.IsNullOrWhiteSpace(member.LlmPromptId))
            {
                member.LlmPromptId = null;
            }
            else if (!_prompts.Any(p => p.Id == member.LlmPromptId))
            {
                var prompt = _prompts.FirstOrDefault(p => string.Equals(p.Name, member.LlmPromptId, StringComparison.OrdinalIgnoreCase));
                member.LlmPromptId = prompt?.Id;
            }
        }

        _editingApp.AppType = LlmAppTypes.AgentGroup;
        _editingApp.OrchestrationMode = result.OrchestrationMode;

        var cfg = _editingApp.Config;
        cfg.Remove("GroupChatMaxRounds");
        cfg.Remove("GroupChatStopOnFinal");
        cfg.Remove("GroupChatRoleOrder");
        cfg.Remove("GroupChatContextLimit");
        cfg.Remove("DAGWorkflow");

        if (result.OrchestrationMode == OrchestrationMode.GroupChat)
        {
            if (result.GroupChatMaxRounds.HasValue) cfg["GroupChatMaxRounds"] = result.GroupChatMaxRounds.Value;
            if (result.GroupChatStopOnFinal.HasValue) cfg["GroupChatStopOnFinal"] = result.GroupChatStopOnFinal.Value;
            if (!string.IsNullOrWhiteSpace(result.GroupChatRoleOrder)) cfg["GroupChatRoleOrder"] = result.GroupChatRoleOrder!;
            if (result.GroupChatContextLimit.HasValue) cfg["GroupChatContextLimit"] = result.GroupChatContextLimit.Value;
        }

        if (result.OrchestrationMode == OrchestrationMode.DAG)
        {
            var dagConfig = new Dictionary<string, object>();
            if (result.DAGMaxParallelism.HasValue) dagConfig["MaxParallelism"] = result.DAGMaxParallelism.Value;
            if (result.DAGGlobalTimeout.HasValue) dagConfig["GlobalTimeoutSeconds"] = result.DAGGlobalTimeout.Value;
            if (!string.IsNullOrWhiteSpace(result.DAGFailureStrategy)) dagConfig["FailureStrategy"] = result.DAGFailureStrategy!;
            
            if (dagConfig.Count > 0)
            {
                cfg["DAGWorkflow"] = dagConfig;
            }
        }

        _editingApp.Config = cfg;

        if (!_showEditModal)
        {
            _showEditModal = true;
        }

        StateHasChanged();
    }

    private void CloseWizard() { _showWizardDialog = false; }
}

<Modal Title="AgentGroup 向导" Visible="_showWizardDialog" OnCancel="CloseWizard" Width="900" Footer="null">
    <ChildContent>
    <AgentGroupWizard IsDialog="true" InitialApp="@_editingApp" InitialMembers="@_members" OnCreated="HandleWizardCreated" OnCancel="CloseWizard" />
    </ChildContent>
</Modal>
