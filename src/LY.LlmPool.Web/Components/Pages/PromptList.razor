@page "/prompt-list"
@using LY.LlmPool.Web.Services
@using LY.LlmPool.Web.Data.Entities
@using LY.LlmPool.Web.Models
@using AntDesign
@using AntDesign.TableModels
@inject PromptService PromptService
@inject MessageService _message
@inject NavigationManager NavigationManager

<PageTitle>Prompt List</PageTitle>

<Card>
    <TitleTemplate>
        <div class="d-flex justify-content-between align-items-center">
            <div>Prompt List</div>
            <div>
                <Space>
                    @if (_tagsLoaded)
                    {
                        <Select TItem="string" TItemValue="string" Values="_selectedTags" ValuesChanged="@((IEnumerable<string> vals) => { _selectedTags = vals ?? Array.Empty<string>(); _ = OnTagsChanged(null); })" Mode="@SelectMode.Multiple" Placeholder="Filter by tags" Style="min-width:220px; margin-right:8px;" AllowClear>
                            @foreach (var tag in _availableTags)
                            {
                                <SelectOption TItem="string" TItemValue="string" Value="@tag">@tag</SelectOption>
                            }
                        </Select>
                    }
                    else
                    {
                        <Select TItem="string" TItemValue="string" Disabled Placeholder="Loading tags..." Style="min-width:220px; margin-right:8px;" />
                    }

                    <Button OnClick="ClearTagFilter">Clear</Button>

                    <Button Type="@ButtonType.Primary" OnClick="AddNewPrompt">
                        <Icon Type="plus" />
                        Add New Prompt
                    </Button>
                </Space>
            </div>
        </div>
    </TitleTemplate>
    <ChildContent>
        <Table TItem="LlmPrompt"
               DataSource="@_prompts"
               Loading="_loading">
            <PropertyColumn Property="c=>c.Name" Title="Name">
                <Space>
                    <SpaceItem>
                        <Icon Type="message" />
                    </SpaceItem>
                    <SpaceItem>
                        @context.Name
                    </SpaceItem>
                </Space>
            </PropertyColumn>
            <PropertyColumn Property="c=>c.Description" Title="Description" />
            <PropertyColumn Property="c=>c.Content" Title="Content">
                <div style="max-height: 100px; overflow: hidden; text-overflow: ellipsis;">
                    @context.Content
                </div>
            </PropertyColumn>
            <PropertyColumn Property="c=>c.UpdateTime" Title="Last Modified" Format="yyyy-MM-dd HH:mm:ss" />
            <PropertyColumn Property="c=>c.Status" Title="Status" />
            <Column Title="Tags" TData="string">
                {@{
                    var tags = (context.Tags ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                    <div>
                        @foreach (var t in tags)
                        {
                            <Tag Class="mb-1">@t</Tag>
                        }
                    </div>
                }}
            </Column>
            <ActionColumn Title="Action">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="() => EditPrompt(context)">
                            <Icon Type="edit" />
                            Edit
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="() => ViewHistory(context)">
                            <Icon Type="history" />
                            History
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="Are you sure to delete this prompt?"
                                   OkText="Yes"
                                   CancelText="No"
                                   OnConfirm="() => DeletePrompt(context)">
                            <Button Danger>
                                <Icon Type="delete" />
                            </Button>
                        </Popconfirm>
                    </SpaceItem>
                    <SpaceItem>
                        @if (context.Status == "Draft")
                        {
                            <Button OnClick="() => SubmitForReview(context)">
                                提交审核
                            </Button>
                        }
                        else if (context.Status == "PendingReview")
                        {
                            <AuthorizeView Roles="prompt-auditor,Administrator">
                                <Authorized Context="auth">
                                    <Button OnClick="() => PublishPrompt(context)">发布</Button>
                                </Authorized>
                            </AuthorizeView>
                        }
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    </ChildContent>
</Card>

<Drawer Title="@("Prompt History")"
        Visible="@_showHistoryDrawer"
        Width="800"
        OnClose="CloseHistoryDrawer">
    <Table TItem="PromptHistoryEntry"
           DataSource="@_promptHistory"
           Loading="@_historyLoading">
        <PropertyColumn Property="c=>c.Version" Title="Version" />
        <PropertyColumn Property="c=>c.BasedOnVersion" Title="Based On Version" />
        <PropertyColumn Property="c=>c.CreateTime" Title="Test Time" Format="yyyy-MM-dd HH:mm:ss" />
        <Column Title="Test Configurations" TData="string">
            @{
                var entry = context;
                <div>
                    @foreach (var config in entry.TestConfigs)
                    {
                        <Tag Class="mb-1">
                            <Space>
                                <SpaceItem>
                                    <Icon Type="@(config.Type == "Model" ? "robot" : "api")" />
                                </SpaceItem>
                                <SpaceItem>
                                    @config.Type: @config.ConfigId
                                </SpaceItem>
                            </Space>
                        </Tag>
                    }
                </div>
            }
        </Column>
        <ActionColumn>
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" OnClick="() => ViewHistoryDetail(context)">
                        View
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" OnClick="() => RestoreFromHistory(context)">
                        Restore
                    </Button>
                </SpaceItem>
            </Space>
        </ActionColumn>
    </Table>
</Drawer>

@code {
    private List<LlmPrompt> _prompts = new();
    private List<string> _availableTags = new();
    private bool _tagsLoaded = false;
    private IEnumerable<string> _selectedTags = Array.Empty<string>();
    private bool _showHistoryDrawer;
    private bool _loading;
    private bool _historyLoading;
    private LlmPrompt _selectedPrompt = new();
    private List<PromptHistoryEntry> _promptHistory = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableTagsAsync();
        await LoadDataAsync();
    }

    private async Task LoadAvailableTagsAsync()
    {
        try
        {
            _availableTags = await PromptService.GetAllTagsAsync();
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to load tags: {ex.Message}");
        }
        finally
        {
            // Mark tags as loaded so UI can render Select safely
            _tagsLoaded = true;
        }
    }

    private async Task OnTagsChanged(object? _)
    {
        await LoadDataAsync();
    }

    private async Task ClearTagFilter()
    {
        _selectedTags = Array.Empty<string>();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _prompts = await PromptService.GetPromptsAsync(_selectedTags?.Any() == true ? _selectedTags : null);
        }
        finally
        {
            _loading = false;
        }
    }

    private void AddNewPrompt()
    {
        NavigationManager.NavigateTo("/prompt-edit");
    }

    private void EditPrompt(LlmPrompt prompt)
    {
        NavigationManager.NavigateTo($"/prompt-edit/{prompt.Id}");
    }

    private async Task DeletePrompt(LlmPrompt prompt)
    {
        try
        {
            await PromptService.DeletePromptAsync(prompt.Id!);
            await LoadDataAsync();
            _message.Success("Prompt deleted successfully");
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to delete prompt: {ex.Message}");
        }
    }

    private async Task ViewHistory(LlmPrompt prompt)
    {
        _selectedPrompt = prompt;
        await ShowHistory();
    }

    private async Task ShowHistory()
    {
        _showHistoryDrawer = true;
        _historyLoading = true;

        try
        {
            var history = await PromptService.GetPromptHistoryAsync(_selectedPrompt.Id);
            _promptHistory = history.Select(h => new PromptHistoryEntry
            {
                Version = h.Version.ToString(),
                BasedOnVersion = h.BasedOnVersion?.ToString(),
                Prompt = h.Prompt ?? new LlmPrompt
                {
                    Id = h.PromptId,
                    Content = h.Content,
                    Version = h.Version
                },
                TestConfigs = h.TestConfigs.Select(PromptTestConfig.FromTestConfigRecord).ToList(),
                CreateTime = h.CreateTime
            }).ToList();
        }
        finally
        {
            _historyLoading = false;
        }
    }

    private void CloseHistoryDrawer()
    {
        _showHistoryDrawer = false;
        _promptHistory.Clear();
    }

    private void ViewHistoryDetail(PromptHistoryEntry history)
    {
        NavigationManager.NavigateTo($"/prompt-edit/{_selectedPrompt.Id}?version={history.Version}");
    }

    private void RestoreFromHistory(PromptHistoryEntry history)
    {
        NavigationManager.NavigateTo($"/prompt-edit/{_selectedPrompt.Id}?version={history.Version}&restore=true");
    }

    private async Task SubmitForReview(LlmPrompt prompt)
    {
        try
        {
            await PromptService.SubmitForReviewAsync(prompt.Id!);
            await LoadDataAsync();
            _message.Success("Prompt 已提交审核");
        }
        catch (Exception ex)
        {
            _message.Error($"提交审核失败: {ex.Message}");
        }
    }

    private async Task PublishPrompt(LlmPrompt prompt)
    {
        try
        {
            await PromptService.PublishPromptAsync(prompt.Id!);
            await LoadDataAsync();
            _message.Success("Prompt 已发布");
        }
        catch (Exception ex)
        {
            _message.Error($"发布失败: {ex.Message}");
        }
    }

    public class PromptHistoryEntry
    {
        public string? Version { get; set; }
        public string? BasedOnVersion { get; set; }
        public LlmPrompt Prompt { get; set; } = new();
        public List<PromptTestConfig> TestConfigs { get; set; } = new();
        public DateTime CreateTime { get; set; }
    }
}