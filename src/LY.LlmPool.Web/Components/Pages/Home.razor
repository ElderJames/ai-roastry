@page "/"

<PageTitle>LLM Pool</PageTitle>

<h1 style="margin-bottom:10px">欢迎使用 LLM Pool</h1>
<p style="color:#666;margin-top:-6px; font-size:16px">统一管理模型配置、端点与应用，提供 OpenAI 兼容接口与可视化分析。</p>

<h2 style="margin-top:24px; margin-bottom:16px">使用指南</h2>
<ol>
		<li>
				创建/配置端点：在 <a href="/endpoint-config">端点配置</a> 中添加你的上游服务（如 OpenAI、Azure OpenAI、DeepSeek 等）的 BaseUrl 与 API Key。
		</li>
		<li>
				添加模型配置：在 <a href="/model-config">模型配置</a> 中为每个模型创建配置（模型名、BaseUrl、Key、并发上限等），可选择是否挂载到端点以参与负载均衡。
		</li>
		<li>
				组装应用（可选）：在 <a href="/app-list">应用管理</a> 中将 Prompt 与模型配置关联，前端测试时可用应用名作为 `model`。
		</li>
		<li>
				本地测试：打开 <a href="/chat-test">聊天测试</a>，或用 OpenAI 兼容接口进行调用（示例见下）。
		</li>
		<li>
				观测与分析：在 <a href="/request-log">请求日志</a>、<a href="/model-stats">模型统计</a>、<a href="/endpoint-calls">端点调用</a> 中查看时序与明细。
		</li>
	</ol>

<details style="margin-top:10px">
	<summary><b>curl 调用示例（OpenAI 兼容，含 parameters）</b></summary>
	<pre style="background:#f7f7f7;padding:12px;border-radius:6px;overflow:auto"><code>
curl -X POST \
	-H "Authorization: Bearer your-api-key" \
	-H "Content-Type: application/json" \
	-d '{
		"model": "your-app-or-config",
		"messages": [
			{"role": "user", "content": "你好，今天天气如何？"}
		],
		"parameters": {
			"city": "上海",
			"date": "2025-09-24"
		}
	}' \
	http://localhost:5071/v1/chat/completions
	</code></pre>
</details>

<details style="margin-top:10px">
	<summary><b>.NET C# 客户端示例（LY.LlmPool.Client）</b></summary>
	<pre style="background:#f7f7f7;padding:12px;border-radius:6px;overflow:auto"><code>
using LY.LlmPool.Client;

var client = new LlmPoolClient("http://localhost:5071/v1", "your-api-key");
var reply = await client.ChatAsync(
		model: "your-app-or-config",
		messages: new [] {
				new ClientMessage { Role = "user", Content = "你好" }
		}
);
Console.WriteLine(reply);
	</code></pre>
</details>

<details style="margin-top:10px">
	<summary><b>.NET C# 工具调用（KernelFunction）</b></summary>
	<pre style="background:#f7f7f7;padding:12px;border-radius:6px;overflow:auto"><code>
using LY.LlmPool.Client;
using Microsoft.SemanticKernel;

public class MyTools
{
		[KernelFunction("get_time")]
		public string GetTime(string? format = null)
				=> string.IsNullOrWhiteSpace(format) ? DateTime.Now.ToString() : DateTime.Now.ToString(format);
}

var client = new LlmPoolClient("http://localhost:5071/v1", "your-api-key");
var tools = new object[] { new MyTools() };
var reply = await client.ChatAsync(
		model: "your-app-or-config",
		messages: new [] {
				new ClientMessage { Role = "user", Content = "请调用 get_time 返回当前时间，格式 yyyy-MM-dd HH:mm:ss" }
		},
		toolObjects: tools
);
Console.WriteLine(reply);
	</code></pre>
</details>

<details style="margin-top:10px">
	<summary><b>流式调用示例（.NET 与 curl）</b></summary>
	<div style="margin-bottom:6px"><b>.NET C#（逐 token 输出）</b></div>
	<pre style="background:#f7f7f7;padding:12px;border-radius:6px;overflow:auto"><code>
using LY.LlmPool.Client;

var client = new LlmPoolClient("http://localhost:5071/v1", "your-api-key");
await foreach (var token in client.ChatStreamAsync(
		model: "your-app-or-config",
		messages: new [] { new ClientMessage { Role = "user", Content = "讲个笑话" } }
))
{
		Console.Write(token);
}
	</code></pre>
	<div style="margin:8px 0 6px"><b>curl（SSE）</b></div>
	<pre style="background:#f7f7f7;padding:12px;border-radius:6px;overflow:auto"><code>
curl -N \
	-H "Authorization: Bearer your-api-key" \
	-H "Content-Type: application/json" \
	-d '{"model":"your-app-or-config","stream":true,"messages":[{"role":"user","content":"讲个笑话"}]}' \
	http://localhost:5071/v1/chat/completions
	</code></pre>
</details>

<details style="margin-top:10px">
	<summary><b>Java 客户端示例（openai-java）</b></summary>
	<pre style="background:#f7f7f7;padding:12px;border-radius:6px;overflow:auto"><code>
import com.openai.client.OpenAIClient;
import com.openai.client.okhttp.OkHttpOpenAIClient;
import com.openai.models.ChatCompletionCreateParams;
import com.openai.models.ChatCompletion;

OpenAIClient client = OkHttpOpenAIClient.builder()
    .apiKey("your-api-key")
    .baseUrl("http://localhost:5071/v1")
    .build();

ChatCompletion chatCompletion = client.chat().completions().create(ChatCompletionCreateParams.builder()
    .model("your-app-or-config")
    .addUserMessage("你好")
    .build());

System.out.println(chatCompletion.choices().get(0).message().content());
	</code></pre>
</details>
