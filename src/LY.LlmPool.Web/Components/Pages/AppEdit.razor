@page "/app-edit"
@page "/app-edit/{id}"
@using LY.LlmPool.Web.Services
@using LY.LlmPool.Web.Data.Entities
@using AntDesign
@inject LlmPoolService LlmPoolService
@inject MessageService _message
@inject NavigationManager NavigationManager

<PageTitle>@(_isEditing ? "Edit App" : "Create App")</PageTitle>

<Card>
    <TitleTemplate>
        <div class="d-flex justify-content-between align-items-center">
            <div>@(_isEditing ? "Edit App" : "Create App")</div>
            <div>
                <Button OnClick="Cancel">Cancel</Button>
                <Button Type="@ButtonType.Primary" OnClick="Save" Loading="_saving">
                    Save
                </Button>
            </div>
        </div>
    </TitleTemplate>
    <ChildContent>
        <Form Model="_editingApp" ValidateOnChange="true">
            <Row Gutter="16">
                <AntDesign.Col Span="12">
                    <FormItem Label="Name" Required>
                        <Input @bind-Value="_editingApp.Name" Placeholder="Enter app name" />
                    </FormItem>
                </AntDesign.Col>
                <AntDesign.Col Span="12">
                    <FormItem Label="Type" Required>
                        <Select TItemValue="string" TItem="string" @bind-Value="_editingApp.AppType" 
                                Placeholder="Select app type"
                                DataSource="LlmAppTypes.All" />
                    </FormItem>
                </AntDesign.Col>
            </Row>
            
            <FormItem Label="Description">
                <TextArea @bind-Value="_editingApp.Description" Placeholder="Enter description" Rows="3" />
            </FormItem>

            <Row Gutter="16">
                <AntDesign.Col Span="12">
                    <FormItem Label="Prompt">
                        <Select TItemValue="string" TItem="LlmPrompt" @bind-Value="_editingApp.PromptId" 
                                ValueName="Id"
                                LabelName="Name"
                                Placeholder="Select a prompt (optional)" 
                                AllowClear="true"
                                DataSource="_prompts" />
                    </FormItem>
                </AntDesign.Col>
                <AntDesign.Col Span="12">
                    <FormItem Label="Configuration Type">
                        <RadioGroup @bind-Value="_configType">
                            <Radio Value="@("model")">Model Configuration</Radio>
                            <Radio Value="@("endpoint")">Endpoint Configuration</Radio>
                        </RadioGroup>
                    </FormItem>
                </AntDesign.Col>
            </Row>

            @if (_configType == "model")
            {
                <FormItem Label="Model Configuration">
                    <Select TItemValue="string" TItem="LlmConfig" @bind-Value="_editingApp.LlmConfigId" 
                            ValueName="Id"
                            LabelName="Name"
                            Placeholder="Select a model configuration"
                            OnSelectedItemChanged="OnModelConfigChanged"
                            DataSource="_llmConfigs" />
                </FormItem>
            }
            else if (_configType == "endpoint")
            {
                <FormItem Label="Endpoint Configuration">
                    <Select TItemValue="string" TItem="LlmEndpoint" @bind-Value="_editingApp.EndpointId" 
                            ValueName="Id"
                            LabelName="Name"
                            Placeholder="Select an endpoint configuration"
                            OnSelectedItemChanged="OnEndpointConfigChanged"
                            DataSource="_endpoints" />
                </FormItem>
            }

            <FormItem>
                <Checkbox @bind-Value="_editingApp.IsEnabled">Enabled</Checkbox>
            </FormItem>

            @if (!string.IsNullOrEmpty(_selectedConfigInfo))
            {
                <Alert Type="@AlertType.Info" Message="Configuration Info" Description="@_selectedConfigInfo" ShowIcon="true" />
            }
        </Form>
    </ChildContent>
</Card>

@code {
    [Parameter] public string? Id { get; set; }

    private bool _isEditing => !string.IsNullOrEmpty(Id);
    private bool _saving;
    private LlmApp _editingApp = new();
    private List<LlmPrompt> _prompts = new();
    private List<LlmConfig> _llmConfigs = new();
    private List<LlmEndpoint> _endpoints = new();
    private string _configType = "model";
    private string? _selectedConfigInfo;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        
        if (_isEditing)
        {
            await LoadAppAsync();
        }
        else
        {
            _editingApp = new LlmApp
            {
                AppType = LlmAppTypes.Prompt,
                IsEnabled = true,
                PromptId = string.Empty,
                LlmConfigId = string.Empty,
                EndpointId = string.Empty
            };
        }
    }

    private async Task LoadDataAsync()
    {
        _prompts = await LlmPoolService.GetPromptsAsync();
        _llmConfigs = await LlmPoolService.GetConfigsAsync();
        _endpoints = await LlmPoolService.GetEndpointsAsync();
    }

    private async Task LoadAppAsync()
    {
        if (string.IsNullOrEmpty(Id)) return;

        var app = await LlmPoolService.GetAppByIdAsync(Id);
        if (app == null)
        {
            _message.Error("App not found");
            NavigationManager.NavigateTo("/app-list");
            return;
        }

        _editingApp = new LlmApp
        {
            Id = app.Id,
            Name = app.Name,
            Description = app.Description,
            AppType = app.AppType,
            PromptId = app.PromptId ?? string.Empty,
            LlmConfigId = app.LlmConfigId ?? string.Empty,
            EndpointId = app.EndpointId ?? string.Empty,
            IsEnabled = app.IsEnabled,
            ConfigJson = app.ConfigJson
        };

        // Set config type based on what's configured
        if (!string.IsNullOrEmpty(_editingApp.LlmConfigId))
        {
            _configType = "model";
            await OnModelConfigChanged();
        }
        else if (!string.IsNullOrEmpty(_editingApp.EndpointId))
        {
            _configType = "endpoint";
            await OnEndpointConfigChanged();
        }
    }

    private async Task OnModelConfigChanged()
    {
        if (!string.IsNullOrEmpty(_editingApp.LlmConfigId))
        {
            var config = _llmConfigs.FirstOrDefault(c => c.Id == _editingApp.LlmConfigId);
            if (config != null)
            {
                _selectedConfigInfo = $"Model: {config.Model}, Base URL: {config.BaseUrl}";
            }
            _editingApp.EndpointId = null; // Clear endpoint when model is selected
        }
        else
        {
            _selectedConfigInfo = null;
        }
        StateHasChanged();
    }

    private async Task OnEndpointConfigChanged()
    {
        if (!string.IsNullOrEmpty(_editingApp.EndpointId))
        {
            var endpoint = _endpoints.FirstOrDefault(e => e.Id == _editingApp.EndpointId);
            if (endpoint != null)
            {
                _selectedConfigInfo = $"Endpoint: {endpoint.Name}, Description: {endpoint.Description}";
            }
            _editingApp.LlmConfigId = null; // Clear model when endpoint is selected
        }
        else
        {
            _selectedConfigInfo = null;
        }
        StateHasChanged();
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_editingApp.Name))
        {
            _message.Error("Name is required");
            return;
        }

        if (string.IsNullOrWhiteSpace(_editingApp.AppType))
        {
            _message.Error("App type is required");
            return;
        }

        if (string.IsNullOrEmpty(_editingApp.LlmConfigId) && string.IsNullOrEmpty(_editingApp.EndpointId))
        {
            _message.Error("Please select either a model configuration or an endpoint configuration");
            return;
        }

        _saving = true;
        try
        {
            if (_isEditing)
            {
                await LlmPoolService.UpdateAppAsync(_editingApp);
                _message.Success("App updated successfully");
            }
            else
            {
                await LlmPoolService.AddAppAsync(_editingApp);
                _message.Success("App created successfully");
            }

            NavigationManager.NavigateTo("/app-list");
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to save app: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/app-list");
    }
}
