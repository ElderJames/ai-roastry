@page "/app-call-trace"
@using LY.LlmPool.Web.Services.Telemetry
@using Microsoft.Extensions.Options
@inject ActivityTraceService TraceService
@inject IOptions<ActivityTracingOptions> ActivityOptions
@implements IDisposable

<PageTitle>App 调用追踪 - 实时监控</PageTitle>

<div style="padding: 24px; max-width: 100%; overflow-x: hidden;">
    <PageHeader Title="App 调用追踪 - 实时监控" Subtitle="监控 App Tool 调用链路、嵌套调用和并行执行">
        <PageHeaderExtra>
            <Space>
                <SpaceItem>
                    <Tag Color="@(_autoRefresh ? "green" : "default")">
                        @(_autoRefresh ? "实时刷新中" : "已暂停")
                    </Tag>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@(_autoRefresh ? ButtonType.Default : ButtonType.Primary)"
                            OnClick="ToggleAutoRefresh"
                            Disabled="_conversationMode == ConversationDataSourceMode.History">
                        @(_autoRefresh ? "暂停" : "恢复")
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Button OnClick="ClearAll" Danger>清除所有</Button>
                </SpaceItem>
                <SpaceItem>
                    <RadioGroup TValue="ConversationDataSourceMode">
                        <Radio Value="ConversationDataSourceMode.RealTime"
                               Checked="_conversationMode == ConversationDataSourceMode.RealTime"
                               CheckedChanged="async isChecked => await OnConversationModeCheckedChangedAsync(isChecked, ConversationDataSourceMode.RealTime)">
                            实时会话
                        </Radio>
                        <Radio Value="ConversationDataSourceMode.History"
                               Checked="_conversationMode == ConversationDataSourceMode.History"
                               CheckedChanged="async isChecked => await OnConversationModeCheckedChangedAsync(isChecked, ConversationDataSourceMode.History)">
                            历史会话
                        </Radio>
                    </RadioGroup>
                </SpaceItem>
            </Space>
        </PageHeaderExtra>
    </PageHeader>

    <Row Gutter="16">
        <!-- 左侧：Conversation 列表 -->
        <AntDesign.Col Span="5">
            <Card Size="@CardSize.Small" Style="height: calc(100vh - 200px); overflow-y: auto;">
                <TitleTemplate>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span>💬 会话列表</span>
                        <Tooltip Title="基于 gen_ai.conversation.id 分组">
                            <Icon Type="@IconType.Outline.InfoCircle" Style="color: #999; font-size: 14px;" />
                        </Tooltip>
                    </div>
                </TitleTemplate>
                <Extra>
                    <Badge Count="@_conversations.Count" ShowZero="true" />
                </Extra>
                <Body>
                    @if (_conversations.Any())
                    {
                        <!-- 添加"全部"选项 -->
                        <div class="conversation-item @(string.IsNullOrEmpty(_selectedConversationId) ? "selected" : "")"
                             @onclick="async () => await SelectConversationAsync(null)">
                            <div style="display: flex; align-items: center;">
                                <Text Strong>📋 全部会话</Text>
                            </div>
                            <div style="margin-top: 4px; font-size: 12px; color: #999;">
                                显示所有调用记录
                            </div>
                        </div>
                        <Divider Style="margin: 8px 0;" />
                        
                        @foreach (var conv in _conversations)
                        {
                            <div class="conversation-item @(conv.ConversationId == _selectedConversationId ? "selected" : "")"
                                 @onclick="async () => await SelectConversationAsync(conv.ConversationId)">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <div style="flex: 1; min-width: 0;">
                                        @if (conv.IsActive)
                                        {
                                            <Badge Status="@BadgeStatus.Processing" />
                                        }
                                        <Tooltip Title="@conv.ConversationId">
                                            <Text Strong Ellipsis Style="max-width: 150px;">
                                                @if (conv.ConversationId.StartsWith("conv-auto-"))
                                                {
                                                    <span style="color: #999;">🔄 自动生成</span>
                                                }
                                                else
                                                {
                                                    <span>💬 @(conv.ConversationId.Length > 15 
                                                        ? conv.ConversationId.Substring(0, 15) + "..." 
                                                        : conv.ConversationId)</span>
                                                }
                                            </Text>
                                        </Tooltip>
                                    </div>
                                    @if (conv.Models.Any())
                                    {
                                        <Tooltip Title="@string.Join(", ", conv.Models)">
                                            <Tag Color="@("geekblue")" Style="font-size: 10px; margin-left: 4px;">
                                                🤖 @conv.Models.Count
                                            </Tag>
                                        </Tooltip>
                                    }
                                </div>
                                <div style="margin-top: 4px; font-size: 12px; color: #999;">
                                    <Space Size="@("small")">
                                        <SpaceItem>📊 @conv.RequestCount 次</SpaceItem>
                                        <SpaceItem>🎯 @(conv.TotalInputTokens + conv.TotalOutputTokens) tokens</SpaceItem>
                                    </Space>
                                </div>
                                <div style="margin-top: 2px; font-size: 11px; color: #999;">
                                    🕐 @conv.LastRequestTime.ToLocalTime().ToString("HH:mm:ss")
                                    @if (conv.SuccessCount > 0)
                                    {
                                        <span style="color: #52c41a; margin-left: 8px;">✓ @conv.SuccessCount</span>
                                    }
                                </div>
                                @if (conv.ErrorCount > 0)
                                {
                                    <Tag Color="@TagColor.Error" Style="font-size: 10px; margin-top: 4px;">
                                        ❌ @conv.ErrorCount 个错误
                                    </Tag>
                                }
                            </div>
                            <Divider Style="margin: 8px 0;" />
                        }
                    }
                    else
                    {
                        <Empty Description="@("暂无会话记录")" Simple />
                    }

                    @* 历史会话分页控件 *@
                    @if (_conversationMode == ConversationDataSourceMode.History)
                    {
                        <Divider Style="margin: 12px 0;" />
                        <div style="padding: 8px 0; display: flex; flex-direction: column; gap: 8px;">
                            <Space Size="@("small")" Style="justify-content: center;">
                                <SpaceItem>
                                    <Button Size="@ButtonSize.Small"
                                            OnClick="async _ => await ChangeHistoryPageAsync(_historyPageIndex - 1)"
                                            Disabled="_historyPageIndex <= 1">
                                        上一页
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Text>第 @_historyPageIndex / @HistoryTotalPages 页</Text>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button Size="@ButtonSize.Small"
                                            OnClick="async _ => await ChangeHistoryPageAsync(_historyPageIndex + 1)"
                                            Disabled="_historyPageIndex >= HistoryTotalPages">
                                        下一页
                                    </Button>
                                </SpaceItem>
                            </Space>
                            <div style="text-align: center;">
                                <Button Size="@ButtonSize.Small"
                                        OnClick="async _ => await RefreshHistoryPageAsync()"
                                        Loading="_isLoading"
                                        Block>
                                    刷新历史
                                </Button>
                            </div>
                        </div>
                    }
                </Body>
            </Card>
        </AntDesign.Col>

        <!-- 右侧：原有的调用树和详情 -->
        <AntDesign.Col Span="19">
            <!-- 🎯 筛选器 -->
            <Card Size="@CardSize.Small" Style="margin-bottom: 16px;">
                <Body>
                    <Space Size="@("middle")">
                        <SpaceItem>
                            <Text Strong>筛选:</Text>
                        </SpaceItem>
                        <SpaceItem>
                            <Input Placeholder="搜索名称/内容/Tag/Event/错误..." 
                                   @bind-Value="@_filterText" 
                                   Style="width: 250px;"
                                   AllowClear
                                   TValue="string"
                                   BindOnInput
                                   DebounceMilliseconds="500"
                                   OnChange="async _ => await OnFilterChangedAsync()" />
                        </SpaceItem>
                        <SpaceItem>
                            <Select TItem="string" 
                                    TItemValue="string"
                                    DataSource="@_typeOptions"
                                    @bind-Value="@_filterType"
                                    Style="width: 150px;"
                                    Placeholder="选择类型"
                                    AllowClear
                                    OnSelectedItemChanged="async _ => await OnFilterChangedAsync()">
                            </Select>
                        </SpaceItem>
                        <SpaceItem>
                            <Checkbox @bind-Checked="@_filterErrorOnly" OnChange="async _ => await OnFilterChangedAsync()">仅显示错误</Checkbox>
                        </SpaceItem>
                        <SpaceItem>
                            <Button Size="@ButtonSize.Small" OnClick="async _ => await ClearFiltersAsync()">清除筛选</Button>
                        </SpaceItem>
                    </Space>
                </Body>
            </Card>
            
            <Tabs DefaultActiveKey="1">
                <TabPane Key="1" Tab="活跃调用树">
            <div style="margin-top: 16px;">
                @if (_isLoading)
                {
                    <div style="text-align: center; padding: 60px 0;">
                        <Spin Size="@SpinSize.Large" Tip="加载中..." />
                    </div>
                }
                else if (_activeRoots.Count == 0)
                {
                    <Empty Description="@("当前没有活跃的 App 调用")" />
                }
                else
                {
                    <Row Gutter="16">
                        <AntDesign.Col Span="12">
                            <Card Title="调用树" Bordered>
                                <Body>
                                    @if (_activeRoots.Any())
                                    {
                                        <Tree TItem="TraceNode"
                                              DataSource="_activeRoots"
                                              ChildrenExpression="@(node => node.DataItem.Children)"
                                              TitleExpression="@(node => node.DataItem.DisplayName)"
                                              KeyExpression="@(node => node.DataItem.ActivityId)"
                                              DefaultExpandAll="true"
                                              ShowLine
                                              ShowIcon
                                              OnClick="@OnActiveNodeClick">
                                            <TitleTemplate>
                                                <span>
                                                    @GetNodeIcon(context.DataItem) 
                                                    <strong>@context.DataItem.DisplayName</strong>
                                                    
                                                    @{
                                                        var typeTag = GetNodeTypeTag(context.DataItem);
                                                    }
                                                    <Tag Color="@typeTag.Color">@typeTag.Text</Tag>
                                                    
                                                    @if (!string.IsNullOrEmpty(context.DataItem.AppName))
                                                    {
                                                        <Tag Color="@("blue")">@context.DataItem.AppName</Tag>
                                                    }
                                                    @if (!string.IsNullOrEmpty(context.DataItem.ToolName))
                                                    {
                                                        <Tag Color="@("purple")">@context.DataItem.ToolName</Tag>
                                                    }
                                                    @if (!string.IsNullOrEmpty(context.DataItem.McpServerName))
                                                    {
                                                        <Tag Color="@("orange")">@context.DataItem.McpServerName</Tag>
                                                    }
                                                    
                                                    <Tag Color="@("processing")">
                                                        @((DateTime.UtcNow - context.DataItem.StartTime).TotalSeconds.ToString("F1"))s
                                                    </Tag>
                                                </span>
                                            </TitleTemplate>
                                        </Tree>
                                    }
                                    else
                                    {
                                        <Empty Description="@("暂无活跃调用")" />
                                    }
                                </Body>
                            </Card>
                        </AntDesign.Col>
                        <AntDesign.Col Span="12">
                            <Card Title="详细信息" Bordered>
                                <Body>
                                    @if (_selectedActiveNode != null)
                                    {
                                        @RenderNodeDetails(_selectedActiveNode, true)
                                    }
                                    else
                                    {
                                        <Empty Description="@("点击左侧节点查看详情")" Simple />
                                    }
                                </Body>
                            </Card>
                        </AntDesign.Col>
                    </Row>
                }
            </div>
        </TabPane>

        <TabPane Key="2" Tab="已完成调用">
            <div style="margin-top: 16px;">
                @if (_isLoading)
                {
                    <div style="text-align: center; padding: 60px 0;">
                        <Spin Size="@SpinSize.Large" Tip="加载中..." />
                    </div>
                }
                else if (_completedRoots.Count == 0)
                {
                    <Empty Description="@("还没有完成的 App 调用记录")" />
                }
                else
                {
                    <Row Gutter="16">
                        <AntDesign.Col Span="12">
                            <Card Bordered>
                                <TitleTemplate>
                                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <span>📋 调用树</span>
                                        <Space Size="@("small")">
                                            <SpaceItem>
                                                <Button Size="@ButtonSize.Small" 
                                                        Type="@ButtonType.Link" 
                                                        OnClick="ExpandAllCompletedNodes">
                                                    @(_completedTreeExpandAll ? "收起全部" : "展开全部")
                                                </Button>
                                            </SpaceItem>
                                            <SpaceItem>
                                                <Tag Color="@("blue")">共 @_completedRoots.Count 条</Tag>
                                            </SpaceItem>
                                        </Space>
                                    </div>
                                </TitleTemplate>
                                <Body>
                                    <Tree @ref="_completedTreeRef"
                                          TItem="TraceNode"
                                          DataSource="_completedRoots"
                                          ChildrenExpression="@(node => node.DataItem.Children)"
                                          TitleExpression="@(node => node.DataItem.DisplayName)"
                                          KeyExpression="@(node => node.DataItem.ActivityId)"
                                          DefaultExpandAll="true"
                                          ShowLine
                                          ShowIcon
                                          OnClick="@OnCompletedNodeClick">
                                        <TitleTemplate>
                                            @{
                                                var statusIcon = context.DataItem.Status == "Success" ? "✅" : 
                                                               context.DataItem.Status == "Error" ? "❌" : "⏹️";
                                                var typeTag = GetNodeTypeTag(context.DataItem);
                                            }
                                            <span>
                                                @statusIcon @GetNodeIcon(context.DataItem) 
                                                <strong>@context.DataItem.DisplayName</strong>
                                                
                                                <Tag Color="@typeTag.Color">@typeTag.Text</Tag>
                                                
                                                @if (!string.IsNullOrEmpty(context.DataItem.AppName))
                                                {
                                                    <Tag Color="@("blue")">@context.DataItem.AppName</Tag>
                                                }
                                                @if (!string.IsNullOrEmpty(context.DataItem.ToolName))
                                                {
                                                    <Tag Color="@("purple")">@context.DataItem.ToolName</Tag>
                                                }
                                                @if (!string.IsNullOrEmpty(context.DataItem.McpServerName))
                                                {
                                                    <Tag Color="@("orange")">@context.DataItem.McpServerName</Tag>
                                                }
                                                
                                                <Tag>@context.DataItem.Duration.TotalSeconds.ToString("F2")s</Tag>
                                            </span>
                                        </TitleTemplate>
                                    </Tree>
                                </Body>
                            </Card>
                        </AntDesign.Col>
                        <AntDesign.Col Span="12">
                            <Card Title="详细信息" Bordered>
                                <Body>
                                    @if (_selectedCompletedNode != null)
                                    {
                                        @RenderNodeDetails(_selectedCompletedNode, false)
                                    }
                                    else
                                    {
                                        <Empty Description="@("点击左侧节点查看详情")" Simple />
                                    }
                                </Body>
                            </Card>
                        </AntDesign.Col>
                    </Row>
                }
            </div>
        </TabPane>

        <TabPane Key="3" Tab="调用统计">
            <div style="margin-top: 16px;">
                <Row Gutter="16">
                    <AntDesign.Col Span="6">
                        <Statistic Title="活跃调用" Value="@_activeRoots.Count" />
                    </AntDesign.Col>
                    <AntDesign.Col Span="6">
                        <Statistic Title="已完成" Value="@_completedRoots.Count" />
                    </AntDesign.Col>
                    <AntDesign.Col Span="6">
                        <Statistic Title="平均耗时" 
                                  Value="@(_completedRoots.Any() ? _completedRoots.Average(r => r.Duration.TotalSeconds).ToString("F2") : "0")" 
                                  Suffix="s" />
                    </AntDesign.Col>
                    <AntDesign.Col Span="6">
                        <Statistic Title="总 Token 消耗" 
                                  Value="@_completedRoots.Sum(r => r.InputTokens + r.OutputTokens)" />
                    </AntDesign.Col>
                </Row>
            </div>
        </TabPane>
    </Tabs>
        </AntDesign.Col>
    </Row>
</div>

@code {
    private enum ConversationDataSourceMode
    {
        RealTime,
        History
    }

    private bool _autoRefresh = true;
    private System.Threading.Timer? _timer;
    private ConversationDataSourceMode _conversationMode = ConversationDataSourceMode.RealTime;
    private List<TraceNode> _activeRoots = new();
    private List<TraceNode> _completedRoots = new();
    private List<ConversationInfo> _conversations = new();
    private List<ConversationInfo> _realTimeConversations = new();
    private List<ConversationInfo> _historyConversations = new();
    private int _historyPageIndex = 1;
    private int _historyTotalCount;
    private int _historyPageSize;
    private string? _selectedConversationId;
    
    // 选中的节点
    private TraceNode? _selectedActiveNode;
    private TraceNode? _selectedCompletedNode;

    // 🎯 树组件的引用和展开状态
    private Tree<TraceNode>? _completedTreeRef;
    private bool _completedTreeExpandAll = false;
    
    // 🎯 性能优化: 防止点击节点时触发刷新
    private bool _isUserInteracting = false;
    private DateTime _lastUserInteraction = DateTime.MinValue;
    
    // 🎯 筛选器状态
    private string? _filterText;
    private string? _filterStatus;
    private string? _filterType;
    private bool _filterErrorOnly = false;
    
    // 🎯 Loading 状态
    private bool _isLoading = false;
    
    private readonly List<string> _statusOptions = new() { "Success", "Error", "InProgress" };
    private readonly List<string> _typeOptions = new() { "App", "Tool", "MCP Tool", "MCP Server", "Chat", "HTTP" };

    private int HistoryTotalPages
    {
        get
        {
            var pageSize = Math.Max(1, _historyPageSize);
            if (_historyTotalCount <= 0)
            {
                return 1;
            }

            return (int)Math.Ceiling(_historyTotalCount / (double)pageSize);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // 订阅事件
        TraceService.ActivityStarted += OnActivityStarted;
        TraceService.ActivityStopped += OnActivityStopped;

        _historyPageSize = Math.Max(1, ActivityOptions.Value.Pagination?.ConversationsPageSize ?? 5);

        // 初始加载数据
        await RefreshDataAsync(showLoading: true);

        // 🎯 启动定时器（2秒刷新一次,降低频率）
        _timer = new System.Threading.Timer(_ =>
        {
            if (_conversationMode != ConversationDataSourceMode.RealTime)
            {
                return;
            }

            // 🎯 性能优化: 如果用户正在交互,跳过自动刷新
            if (_autoRefresh && !_isUserInteracting && (DateTime.Now - _lastUserInteraction).TotalSeconds > 1)
            {
                InvokeAsync(() =>
                {
                    RefreshRealTimeData(showLoading: false); // 🎯 自动刷新不显示 loading
                    StateHasChanged();
                });
            }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private async Task RefreshDataAsync(bool showLoading = true)
    {
        if (_conversationMode == ConversationDataSourceMode.History)
        {
            RefreshRealTimeData(showLoading: false, updateVisibleList: false);
            await RefreshHistoryDataAsync(showLoading);
        }
        else
        {
            RefreshRealTimeData(showLoading, updateVisibleList: true);
        }
    }

    private void RefreshRealTimeData(bool showLoading = true, bool updateVisibleList = true)
    {
        if (showLoading)
        {
            _isLoading = true;
            StateHasChanged();
        }

        try
        {
            _realTimeConversations = TraceService.GetConversationList();

            if (!updateVisibleList)
            {
                return;
            }

            _conversations = _realTimeConversations;

            if (!string.IsNullOrEmpty(_selectedConversationId) &&
                !_conversations.Any(c => c.ConversationId == _selectedConversationId))
            {
                _selectedConversationId = null;
            }

            if (!string.IsNullOrEmpty(_selectedConversationId))
            {
                var traceNodes = TraceService.GetTracesByConversation(_selectedConversationId);
                var allNodes = FlattenTraceNodes(traceNodes);

                var activeNodes = ApplyFilters(allNodes.Where(t => t.Status == "InProgress").ToList());
                var completedNodes = ApplyFilters(allNodes.Where(t => t.Status != "InProgress").ToList());

                _activeRoots = BuildTraceTree(activeNodes).OrderBy(r => r.StartTime).ToList();
                _completedRoots = BuildTraceTree(completedNodes).OrderByDescending(r => r.StartTime).ToList();
            }
            else
            {
                var activeTraces = TraceService.GetActiveTraces();
                var completedTraces = TraceService.GetCompletedTraces(1000);

                var filteredActiveTraces = FilterAppRelatedTraces(activeTraces.ToList());
                var filteredCompletedTraces = FilterAppRelatedTraces(completedTraces.ToList());

                var activeNodes = FlattenTraceNodes(BuildTraceTree(filteredActiveTraces));
                var completedNodes = FlattenTraceNodes(BuildTraceTree(filteredCompletedTraces));

                activeNodes = ApplyFilters(activeNodes);
                completedNodes = ApplyFilters(completedNodes);

                _activeRoots = BuildTraceTree(activeNodes)
                    .OrderBy(r => r.StartTime)
                    .ToList();

                _completedRoots = BuildTraceTree(completedNodes)
                    .OrderByDescending(r => r.StartTime)
                    .ToList();
            }
        }
        finally
        {
            if (showLoading)
            {
                _isLoading = false;
            }
        }
    }

    private async Task RefreshHistoryDataAsync(bool showLoading = true)
    {
        if (showLoading)
        {
            _isLoading = true;
            StateHasChanged();
        }

        try
        {
            var (items, totalCount) = await TraceService.GetHistoricalConversationsAsync(_historyPageIndex, _historyPageSize);

            _historyTotalCount = totalCount;
            _historyConversations = items.ToList();

            var skip = (_historyPageIndex - 1) * _historyPageSize;
            if (_historyConversations.Count == 0 && _historyTotalCount > 0 && skip >= _historyTotalCount)
            {
                _historyPageIndex = HistoryTotalPages;
                (items, totalCount) = await TraceService.GetHistoricalConversationsAsync(_historyPageIndex, _historyPageSize);
                _historyTotalCount = totalCount;
                _historyConversations = items.ToList();
            }

            _conversations = _historyConversations;

            if (!string.IsNullOrEmpty(_selectedConversationId) &&
                !_historyConversations.Any(c => c.ConversationId == _selectedConversationId))
            {
                _selectedConversationId = null;
            }

            await RefreshHistoryTraceViewCoreAsync();
        }
        finally
        {
            if (showLoading)
            {
                _isLoading = false;
            }
        }
    }

    private async Task RefreshHistoryTraceViewAsync(bool showLoading)
    {
        if (_conversationMode != ConversationDataSourceMode.History)
        {
            return;
        }

        if (showLoading)
        {
            _isLoading = true;
            StateHasChanged();
        }

        try
        {
            await RefreshHistoryTraceViewCoreAsync();
        }
        finally
        {
            if (showLoading)
            {
                _isLoading = false;
            }
        }
    }

    private async Task RefreshHistoryTraceViewCoreAsync()
    {
        _activeRoots.Clear();
        _completedRoots.Clear();

        var targetConversationIds = !string.IsNullOrEmpty(_selectedConversationId)
            ? new List<string> { _selectedConversationId }
            : _historyConversations
                .Select(c => c.ConversationId)
                .Where(id => !string.IsNullOrEmpty(id))
                .Distinct()
                .ToList();

        if (!targetConversationIds.Any())
        {
            return;
        }

        var traceTrees = await TraceService.GetHistoricalTracesByConversationsAsync(targetConversationIds);
        if (traceTrees == null || traceTrees.Count == 0)
        {
            return;
        }

        var allNodes = FlattenTraceNodes(traceTrees);

        var activeNodes = ApplyFilters(allNodes.Where(t => t.Status == "InProgress").ToList());
        var completedNodes = ApplyFilters(allNodes.Where(t => t.Status != "InProgress").ToList());

        _activeRoots = BuildTraceTree(activeNodes).OrderBy(r => r.StartTime).ToList();
        _completedRoots = BuildTraceTree(completedNodes).OrderByDescending(r => r.StartTime).ToList();
    }

	private async Task OnConversationModeCheckedChangedAsync(bool isChecked, ConversationDataSourceMode mode)
	{
		if (!isChecked)
		{
			return;
		}

		await OnConversationModeChangedAsync(mode);
	}

	private async Task OnConversationModeChangedAsync(ConversationDataSourceMode mode)
	{
		if (_conversationMode != mode)
		{
			_conversationMode = mode;
		}

		_selectedConversationId = null;
		_selectedActiveNode = null;
		_selectedCompletedNode = null;

		if (_conversationMode == ConversationDataSourceMode.RealTime)
		{
			RefreshRealTimeData(showLoading: true);
		}
		else
		{
			RefreshRealTimeData(showLoading: false, updateVisibleList: false);
			_historyPageIndex = 1;
			await RefreshHistoryDataAsync(showLoading: true);
		}

		StateHasChanged();
	}

    private async Task RefreshHistoryPageAsync()
    {
        if (_conversationMode != ConversationDataSourceMode.History)
        {
            return;
        }

        await RefreshHistoryDataAsync(showLoading: true);
        StateHasChanged();
    }

    private async Task ChangeHistoryPageAsync(int newIndex)
    {
        if (_conversationMode != ConversationDataSourceMode.History)
        {
            return;
        }

        var totalPages = HistoryTotalPages;
        newIndex = Math.Clamp(newIndex, 1, totalPages);

        if (newIndex == _historyPageIndex)
        {
            return;
        }

        _historyPageIndex = newIndex;
        await RefreshHistoryDataAsync(showLoading: true);
        StateHasChanged();
    }

    private async Task OnFilterChangedAsync()
    {
        if (_conversationMode == ConversationDataSourceMode.History)
        {
            await RefreshHistoryTraceViewAsync(showLoading: true);
        }
        else
        {
            RefreshRealTimeData(showLoading: true);
        }

        StateHasChanged();
    }

    private async Task ClearFiltersAsync()
    {
        _filterText = null;
        _filterStatus = null;
        _filterType = null;
        _filterErrorOnly = false;

        await OnFilterChangedAsync();
    }

    private async Task SelectConversationAsync(string? conversationId)
    {
        _isUserInteracting = true;
        _lastUserInteraction = DateTime.Now;

        _selectedConversationId = conversationId;
        _selectedActiveNode = null;
        _selectedCompletedNode = null;

        if (_conversationMode == ConversationDataSourceMode.History)
        {
            await RefreshHistoryTraceViewAsync(showLoading: true);
        }
        else
        {
            RefreshRealTimeData(showLoading: true);
        }

        StateHasChanged();

        _ = Task.Delay(500).ContinueWith(_ => _isUserInteracting = false);
    }

    private void OnActivityStarted(object? sender, TraceNode node)
    {
        if (_conversationMode != ConversationDataSourceMode.RealTime)
        {
            return;
        }

        if (!_isUserInteracting)
        {
            InvokeAsync(() =>
            {
                RefreshRealTimeData(showLoading: false);
                StateHasChanged();
            });
        }
    }

    private void OnActivityStopped(object? sender, TraceNode node)
    {
        if (_conversationMode != ConversationDataSourceMode.RealTime)
        {
            return;
        }

        if (!_isUserInteracting)
        {
            InvokeAsync(() =>
            {
                RefreshRealTimeData(showLoading: false);
                StateHasChanged();
            });
        }
    }

    // 🎯 应用筛选逻辑
    private List<TraceNode> ApplyFilters(List<TraceNode> nodes)
    {
        if (!nodes.Any()) return nodes;
        
        var filtered = nodes.AsEnumerable();
        
        // 🔍 文本筛选: 搜索 App/Tool 名称、Tag、Event、错误信息等
        if (!string.IsNullOrWhiteSpace(_filterText))
        {
            var searchText = _filterText.Trim().ToLowerInvariant();
            filtered = filtered.Where(n => 
                // 基本信息
                (!string.IsNullOrEmpty(n.AppName) && n.AppName.ToLowerInvariant().Contains(searchText)) ||
                (!string.IsNullOrEmpty(n.ToolName) && n.ToolName.ToLowerInvariant().Contains(searchText)) ||
                (!string.IsNullOrEmpty(n.DisplayName) && n.DisplayName.ToLowerInvariant().Contains(searchText)) ||
                (!string.IsNullOrEmpty(n.OperationName) && n.OperationName.ToLowerInvariant().Contains(searchText)) ||
                (!string.IsNullOrEmpty(n.McpServerName) && n.McpServerName.ToLowerInvariant().Contains(searchText)) ||
                (!string.IsNullOrEmpty(n.ModelId) && n.ModelId.ToLowerInvariant().Contains(searchText)) ||
                
                // Tool 参数和结果
                (!string.IsNullOrEmpty(n.ToolArguments) && n.ToolArguments.ToLowerInvariant().Contains(searchText)) ||
                (!string.IsNullOrEmpty(n.ToolResult) && n.ToolResult.ToLowerInvariant().Contains(searchText)) ||
                
                // 消息内容
                (!string.IsNullOrEmpty(n.OutputContent) && n.OutputContent.ToLowerInvariant().Contains(searchText)) ||
                (n.InputMessages.Any(m => !string.IsNullOrEmpty(m.Content) && m.Content.ToLowerInvariant().Contains(searchText))) ||
                
                // 错误信息
                (!string.IsNullOrEmpty(n.ErrorType) && n.ErrorType.ToLowerInvariant().Contains(searchText)) ||
                (!string.IsNullOrEmpty(n.StatusDescription) && n.StatusDescription.ToLowerInvariant().Contains(searchText)) ||
                
                // Tags (key 或 value)
                (n.Tags != null && n.Tags.Any(t => 
                    t.Key.ToLowerInvariant().Contains(searchText) || 
                    (!string.IsNullOrEmpty(t.Value) && t.Value.ToLowerInvariant().Contains(searchText))
                )) ||
                
                // Events (name 或 tags)
                (n.Events != null && n.Events.Any(e => 
                    e.Name.ToLowerInvariant().Contains(searchText) ||
                    e.Tags.Any(et => 
                        et.Key.ToLowerInvariant().Contains(searchText) || 
                        (!string.IsNullOrEmpty(et.Value) && et.Value.ToLowerInvariant().Contains(searchText))
                    )
                )) ||
                
                // ID 相关
                n.TraceId.ToLowerInvariant().Contains(searchText) ||
                n.SpanId.ToLowerInvariant().Contains(searchText) ||
                n.ActivityId.ToLowerInvariant().Contains(searchText)
            );
        }
        
        // 状态筛选
        if (!string.IsNullOrWhiteSpace(_filterStatus))
        {
            filtered = filtered.Where(n => n.Status == _filterStatus);
        }
        
        // 类型筛选
        if (!string.IsNullOrWhiteSpace(_filterType))
        {
            filtered = _filterType switch
            {
                "App" => filtered.Where(n => n.IsAppCall),
                "Tool" => filtered.Where(n => n.IsToolCall && !n.IsMcpTool),
                "MCP Tool" => filtered.Where(n => n.IsMcpTool),
                "MCP Server" => filtered.Where(n => n.IsMcpServer),
                "Chat" => filtered.Where(n => n.OperationName.StartsWith("chat")),
                "HTTP" => filtered.Where(n => n.OperationName.StartsWith("http")),
                _ => filtered
            };
        }
        
        // 仅显示错误
        if (_filterErrorOnly)
        {
            // 🎯 修复: 活跃节点可能还未停止,但 error.type 标签已设置
            // 检查: Status == "Error" 或 有 ErrorType 标签 或 Tags 中包含 "error.type"
            filtered = filtered.Where(n => 
                n.Status == "Error" || 
                !string.IsNullOrEmpty(n.ErrorType) ||
                (n.Tags != null && n.Tags.ContainsKey("error.type"))
            );
        }
        
        return filtered.ToList();
    }
    
    private List<TraceNode> BuildTraceTree(List<TraceNode> nodes)
    {
        if (!nodes.Any()) return new List<TraceNode>();

        // 按 TraceId 分组
        var groups = nodes.GroupBy(n => n.TraceId);
        var roots = new List<TraceNode>();

        foreach (var group in groups)
        {
            var nodeList = group.ToList();
            
            // 使用 ActivityId 作为 key（更唯一）或 SpanId
            var nodeDict = nodeList.ToDictionary(n => n.SpanId);

            // 清空所有节点的 Children，避免重复
            foreach (var node in nodeList)
            {
                node.Children.Clear();
            }

            // 找到根节点
            var rootNodes = nodeList.Where(n => 
                n.ParentSpanId == "0000000000000000" || 
                string.IsNullOrEmpty(n.ParentSpanId) ||
                !nodeDict.ContainsKey(n.ParentSpanId) // 父节点不在列表中，也视为根
            ).ToList();

            // 构建树形结构
            foreach (var node in nodeList)
            {
                if (!rootNodes.Contains(node) && nodeDict.ContainsKey(node.ParentSpanId))
                {
                    var parent = nodeDict[node.ParentSpanId];
                    if (!parent.Children.Contains(node)) // 避免重复添加
                    {
                        parent.Children.Add(node);
                    }
                }
            }

            // 递归排序所有子节点
            foreach (var root in rootNodes)
            {
                SortChildren(root);
                roots.Add(root);
            }
        }

        return roots;
    }

    private void SortChildren(TraceNode node)
    {
        if (node.Children.Any())
        {
            node.Children = node.Children.OrderBy(c => c.StartTime).ToList();
            foreach (var child in node.Children)
            {
                SortChildren(child);
            }
        }
    }

    /// <summary>
    /// 过滤出包含 App 调用相关的 trace,保持调用链完整
    /// </summary>
    /// <param name="traces">所有 trace 节点</param>
    /// <returns>过滤后的 trace 节点列表</returns>
    private List<TraceNode> FilterAppRelatedTraces(List<TraceNode> traces)
    {
        if (!traces.Any()) return new List<TraceNode>();

        // 按 TraceId 分组
        var traceGroups = traces.GroupBy(t => t.TraceId);
        var filteredTraces = new List<TraceNode>();

        foreach (var group in traceGroups)
        {
            var nodesInTrace = group.ToList();
            
            // 🎯 判断这个 trace 是否包含 App 相关的调用
            // 条件: 包含 IsAppCall=true 或 IsAppTool=true 的节点
            bool hasAppRelatedCall = nodesInTrace.Any(n => 
                n.IsAppCall ||      // App 调用
                n.IsAppTool ||      // App Tool 调用
                n.IsLlmPoolServer   // LlmPool Server 调用
            );

            // 如果包含 App 相关调用,则保留整个 trace 的所有节点(保持调用链完整)
            if (hasAppRelatedCall)
            {
                filteredTraces.AddRange(nodesInTrace);
            }
        }

        return filteredTraces;
    }
    
    /// <summary>
    /// 展平树形结构为扁平列表(递归收集所有节点)
    /// </summary>
    private List<TraceNode> FlattenTraceNodes(List<TraceNode> roots)
    {
        var result = new List<TraceNode>();
        
        void CollectNodes(TraceNode node)
        {
            result.Add(node);
            foreach (var child in node.Children)
            {
                CollectNodes(child);
            }
        }
        
        foreach (var root in roots)
        {
            CollectNodes(root);
        }
        
        return result;
    }

    private void ToggleAutoRefresh()
    {
        _autoRefresh = !_autoRefresh;
    }

    private void ClearAll()
    {
        _activeRoots.Clear();
        _completedRoots.Clear();
        StateHasChanged();
    }

    /// <summary>
    /// 展开或收起已完成调用树的所有节点
    /// </summary>
    private void ExpandAllCompletedNodes()
    {
        if (_completedTreeRef != null)
        {
            _completedTreeExpandAll = !_completedTreeExpandAll;
            
            if (_completedTreeExpandAll)
            {
                // 展开全部
                _completedTreeRef.ExpandAll();
            }
            else
            {
                // 收起全部
                _completedTreeRef.CollapseAll();
            }
        }
    }

    // 递归渲染追踪节点
    private RenderFragment RenderTraceNode(TraceNode node, bool isActive) => __builder =>
    {
        var hasChildren = node.Children.Any();
        var indentStyle = "margin-left: 24px; border-left: 2px solid #d9d9d9; padding-left: 12px;";

        <div style="margin-bottom: 8px;">
            @* 节点信息 *@
            <div style="display: flex; align-items: center; gap: 8px;">
                <span>@(hasChildren ? "📦" : "📄")</span>

                <strong>@node.DisplayName</strong>

                @if (node.IsAppCall)
                {
                    <Tag Color="@("blue")">App: @node.AppName</Tag>
                }

                @if (node.IsToolCall)
                {
                    <Tag Color="@("purple")">Tool: @node.ToolName</Tag>
                }

                @if (!string.IsNullOrEmpty(node.ModelId))
                {
                    <Tag>@node.ModelId</Tag>
                }

                @if (isActive)
                {
                    <Tag Color="@("processing")">执行中...</Tag>
                    <span style="color: #999;">
                        @((DateTime.UtcNow - node.StartTime).TotalSeconds.ToString("F1"))s
                    </span>
                }
                else
                {
                    var statusColor = node.Status == "Success" ? "success" : 
                                    node.Status == "Error" ? "error" : "default";
                    <Tag Color="@statusColor">@node.Status</Tag>
                    <span style="color: #999;">@node.Duration.TotalSeconds.ToString("F2")s</span>
                }

                @if (node.InputTokens > 0 || node.OutputTokens > 0)
                {
                    <Tag Color="@("cyan")">
                        ↑@node.InputTokens ↓@node.OutputTokens
                    </Tag>
                }
            </div>

            @* 详细信息 *@
            @if (!string.IsNullOrEmpty(node.ToolArguments) || !string.IsNullOrEmpty(node.ToolResult))
            {
                <div style="margin-top: 4px; margin-left: 32px; color: #999;">
                    @if (!string.IsNullOrEmpty(node.ToolArguments))
                    {
                        <div>
                            📝 Args: @(node.ToolArguments.Length > 100 ? node.ToolArguments.Substring(0, 100) + "..." : node.ToolArguments)
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(node.ToolResult))
                    {
                        <div>
                            ✅ Result: @(node.ToolResult.Length > 100 ? node.ToolResult.Substring(0, 100) + "..." : node.ToolResult)
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(node.ErrorType))
            {
                <div style="margin-top: 4px; margin-left: 32px; color: #ff4d4f;">
                    ❌ Error: @node.ErrorType - @node.StatusDescription
                </div>
            }

            @* 子节点 *@
            @if (hasChildren)
            {
                <div style="@indentStyle; margin-top: 8px;">
                    @foreach (var child in node.Children)
                    {
                        @RenderTraceNode(child, isActive)
                    }
                </div>
            }
        </div>
    };

    // 节点点击事件处理
    private void OnActiveNodeClick(TreeEventArgs<TraceNode> args)
    {
        // 🎯 性能优化: 标记用户正在交互
        _isUserInteracting = true;
        _lastUserInteraction = DateTime.Now;
        
        _selectedActiveNode = args.Node.DataItem;
        StateHasChanged();
        
        // 🎯 延迟重置交互标志
        Task.Delay(500).ContinueWith(_ => _isUserInteracting = false);
    }

    private void OnCompletedNodeClick(TreeEventArgs<TraceNode> args)
    {
        // 🎯 性能优化: 标记用户正在交互
        _isUserInteracting = true;
        _lastUserInteraction = DateTime.Now;
        
        _selectedCompletedNode = args.Node.DataItem;
        StateHasChanged();
        
        // 🎯 延迟重置交互标志
        Task.Delay(500).ContinueWith(_ => _isUserInteracting = false);
    }

    // 获取节点图标
    private string GetNodeIcon(TraceNode node)
    {
        // MCP 相关
        if (node.IsMcpTool)
            return "🔌"; // MCP Tool 调用
        if (node.IsMcpServer)
            return "🖥️"; // MCP Server Activity
            
        // App 相关
        if (node.IsAppTool)
            return "⚙️"; // App Tool
        if (node.IsAppCall)
            return "📱"; // App 调用
            
        // LlmPool Server
        if (node.IsLlmPoolServer)
            return "🏠"; // LlmPool Server
            
        // HTTP 请求
        if (node.OperationName.StartsWith("http.request") || node.Kind == "Client")
            return "🌐";
            
        // AI 相关
        if (node.OperationName.StartsWith("gen_ai.") || node.OperationName.StartsWith("chat"))
            return "🤖";
            
        // 通用工具调用
        if (node.IsToolCall)
            return "🔧";
            
        return "📄";
    }
    
    // 获取节点类型标签
    private (string Text, string Color) GetNodeTypeTag(TraceNode node)
    {
        if (node.IsMcpTool)
            return ("MCP Tool", "purple");
        if (node.IsAppTool)
            return ("App Tool", "blue");
        if (node.IsMcpServer)
            return (node.McpServerName ?? "MCP Server", "orange");
        if (node.IsLlmPoolServer)
            return ("LlmPool", "green");
        if (node.IsAppCall)
            return ("App", "blue");
        if (node.IsToolCall)
            return ("Tool", "cyan");
        if (node.OperationName.StartsWith("chat"))
            return ("Chat", "geekblue");
        if (node.OperationName.StartsWith("http"))
            return ("HTTP", "default");
        return ("Other", "default");
    }

    // 渲染节点详情
    private RenderFragment RenderNodeDetails(TraceNode node, bool isActive) => __builder =>
    {
        <Descriptions Bordered Column="1" Size="@DescriptionsSize.Small">
            <DescriptionsItem Title="操作名称">@node.OperationName</DescriptionsItem>
            <DescriptionsItem Title="TraceId">
                <Text Code Copyable>@node.TraceId</Text>
            </DescriptionsItem>
            <DescriptionsItem Title="SpanId">
                <Text Code Copyable>@node.SpanId</Text>
            </DescriptionsItem>
            @if (!string.IsNullOrEmpty(node.ParentSpanId))
            {
                <DescriptionsItem Title="ParentSpanId">
                    <Text Code Copyable>@node.ParentSpanId</Text>
                </DescriptionsItem>
            }
            <DescriptionsItem Title="开始时间">@node.StartTime.ToString("yyyy-MM-dd HH:mm:ss.fff")</DescriptionsItem>
            @if (!isActive && node.EndTime.HasValue)
            {
                <DescriptionsItem Title="结束时间">@node.EndTime.Value.ToString("yyyy-MM-dd HH:mm:ss.fff")</DescriptionsItem>
                <DescriptionsItem Title="耗时">@node.Duration.TotalSeconds.ToString("F3")s</DescriptionsItem>
            }
            else
            {
                <DescriptionsItem Title="已运行">@((DateTime.UtcNow - node.StartTime).TotalSeconds.ToString("F1"))s</DescriptionsItem>
            }
            @if (!string.IsNullOrEmpty(node.Status))
            {
                <DescriptionsItem Title="状态">
                    <Tag Color="@(node.Status == "Ok" || node.Status == "Success" ? "success" : "error")">
                        @node.Status
                    </Tag>
                </DescriptionsItem>
            }
        </Descriptions>

        @* App 调用信息 *@
        @if (node.IsAppCall && !string.IsNullOrEmpty(node.AppName))
        {
            <Card Title="App 调用信息" Size="@CardSize.Small" Style="margin-top: 16px;">
                <Descriptions Bordered Column="1" Size="@DescriptionsSize.Small">
                    <DescriptionsItem Title="App 名称">@node.AppName</DescriptionsItem>
                    @if (!string.IsNullOrEmpty(node.ModelId))
                    {
                        <DescriptionsItem Title="Model">@node.ModelId</DescriptionsItem>
                    }
                    @if (node.Temperature.HasValue)
                    {
                        <DescriptionsItem Title="Temperature">@node.Temperature.Value</DescriptionsItem>
                    }
                    @if (node.MaxTokens.HasValue)
                    {
                        <DescriptionsItem Title="Max Tokens">@node.MaxTokens.Value</DescriptionsItem>
                    }
                </Descriptions>
            </Card>
        }

        @* Tool 调用信息 *@
        @if (node.IsToolCall && !string.IsNullOrEmpty(node.ToolName))
        {
            <Card Title="Tool 调用信息" Size="@CardSize.Small" Style="margin-top: 16px;">
                <Descriptions Bordered Column="1" Size="@DescriptionsSize.Small">
                    <DescriptionsItem Title="Tool 名称">@node.ToolName</DescriptionsItem>
                    @if (!string.IsNullOrEmpty(node.ToolArguments))
                    {
                        <DescriptionsItem Title="参数">
                            <div style="max-width: 100%; overflow-x: auto;">
                                <pre style="margin: 0; white-space: pre-wrap; word-wrap: break-word; word-break: break-all; max-width: 800px;">@node.ToolArguments</pre>
                            </div>
                        </DescriptionsItem>
                    }
                    @if (!string.IsNullOrEmpty(node.ToolResult))
                    {
                        <DescriptionsItem Title="结果">
                            <div style="max-width: 100%; overflow-x: auto;">
                                <pre style="margin: 0; max-height: 300px; overflow-y: auto; white-space: pre-wrap; word-wrap: break-word; word-break: break-all; max-width: 800px;">@node.ToolResult</pre>
                            </div>
                        </DescriptionsItem>
                    }
                </Descriptions>
            </Card>
        }

        @* Chat 消息内容 *@
        @if (node.InputMessages.Any() || !string.IsNullOrEmpty(node.OutputContent))
        {
            <Card Title="对话内容" Size="@CardSize.Small" Style="margin-top: 16px;">
                @if (node.InputMessages.Any())
                {
                    <div style="margin-bottom: 16px;">
                        <Text Strong>📥 输入消息:</Text>
                        @foreach (var msg in node.InputMessages)
                        {
                            <div style="margin-top: 8px; padding: 12px; background-color: #f5f5f5; border-radius: 4px; border-left: 3px solid #1890ff; max-width: 100%; overflow-x: auto;">
                                <div style="margin-bottom: 4px;">
                                    <Tag Color="@(msg.Role == "system" ? "purple" : msg.Role == "user" ? "blue" : "green")">
                                        @msg.Role
                                    </Tag>
                                </div>
                                <pre style="margin: 0; white-space: pre-wrap; word-wrap: break-word; word-break: break-all; background: transparent; max-width: 100%;">@msg.Content</pre>
                            </div>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(node.OutputContent))
                {
                    <div>
                        <Text Strong>📤 输出内容:</Text>
                        <div style="margin-top: 8px; padding: 12px; background-color: #f0f9ff; border-radius: 4px; border-left: 3px solid #52c41a; max-width: 100%; overflow-x: auto;">
                            <pre style="margin: 0; white-space: pre-wrap; word-wrap: break-word; word-break: break-all; background: transparent; max-width: 100%;">@node.OutputContent</pre>
                        </div>
                    </div>
                }
            </Card>
        }

        @* Token 使用信息 *@
        @if (node.InputTokens > 0 || node.OutputTokens > 0)
        {
            <Card Title="Token 使用" Size="@CardSize.Small" Style="margin-top: 16px;">
                <Row Gutter="16">
                    <AntDesign.Col Span="8">
                        <Statistic Title="输入 Token" Value="@node.InputTokens" />
                    </AntDesign.Col>
                    <AntDesign.Col Span="8">
                        <Statistic Title="输出 Token" Value="@node.OutputTokens" />
                    </AntDesign.Col>
                    <AntDesign.Col Span="8">
                        <Statistic Title="总计" Value="@(node.InputTokens + node.OutputTokens)" />
                    </AntDesign.Col>
                </Row>
            </Card>
        }

        @* Activity Events 展示 *@
        @if (node.Events != null && node.Events.Count > 0)
        {
            <Card Title="Activity Events" Size="@CardSize.Small" Style="margin-top: 16px;">
                <Table TItem="LY.LlmPool.Web.Services.Telemetry.ActivityEventInfo" 
                       DataSource="@node.Events" 
                       Size="@TableSize.Small"
                       Bordered>
                    <Column Title="事件名称" TData="string">
                        @if (context.Name.StartsWith("tool_call:"))
                        {
                            <Tag Color="@("purple")">🔧 @context.Name</Tag>
                        }
                        else if (context.Name.StartsWith("tool_result:"))
                        {
                            <Tag Color="@("green")">✅ @context.Name</Tag>
                        }
                        else
                        {
                            <Tag>@context.Name</Tag>
                        }
                    </Column>
                    <Column Title="时间戳" TData="string">
                        @context.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")
                    </Column>
                    <Column Title="Tags" TData="string">
                        @if (context.Tags.Count > 0)
                        {
                            <div style="max-height: 200px; overflow-y: auto;">
                                @foreach (var tag in context.Tags)
                                {
                                    <div style="margin-bottom: 4px;">
                                        <Tag Color="@("blue")">@tag.Key</Tag>
                                        <Text Code>@tag.Value</Text>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <span style="color: #999;">无</span>
                        }
                    </Column>
                </Table>
            </Card>
        }

        @* 错误信息 *@
        @if (!string.IsNullOrEmpty(node.ErrorType))
        {
            <Alert Type="@AlertType.Error" Message="错误信息" Style="margin-top: 16px;">
                <MessageTemplate>
                    <p><strong>类型:</strong> @node.ErrorType</p>
                    <p><strong>描述:</strong> @node.StatusDescription</p>
                </MessageTemplate>
            </Alert>
        }

        @* 所有 Tags *@
        @if (node.Tags != null && node.Tags.Count > 0)
        {
            <Card Title="所有 Tags" Size="@CardSize.Small" Style="margin-top: 16px;">
                <Table TItem="KeyValuePair<string, string>" 
                       DataSource="@node.Tags.ToList()" 
                       Size="@TableSize.Small"
                       Bordered>
                    <PropertyColumn Property="c => c.Key" Title="Key" />
                    <PropertyColumn Property="c => c.Value" Title="Value" />
                </Table>
            </Card>
        }
    };

    public void Dispose()
    {
        TraceService.ActivityStarted -= OnActivityStarted;
        TraceService.ActivityStopped -= OnActivityStopped;
        _timer?.Dispose();
    }
