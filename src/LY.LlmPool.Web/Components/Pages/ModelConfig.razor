@page "/model-config"
@using LY.LlmPool.Web.Data
@using LY.LlmPool.Web.Data.Entities
@using LY.LlmPool.Web.Models
@using LY.LlmPool.Web.Services
@inject LlmPoolService LlmPoolService
@inject MessageService _message

<PageTitle>Model Configuration</PageTitle>

<Card>
    <TitleTemplate>
        <div class="d-flex justify-content-between align-items-center">
            <div>Model Configuration</div>
            <div>
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="ShowModelTypeModal">
                            <Icon Type="setting" />
                            Manage Model Types
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="AddNewConfig">
                            <Icon Type="plus" />
                            Add New Model
                        </Button>
                    </SpaceItem>
                </Space>
            </div>
        </div>
    </TitleTemplate>
    <ChildContent>
        @if (_modelTypes.Count > 0)
        {
            <Tabs>
                @foreach (var modelType in _modelTypes)
                {
                    <TabPane Key="@modelType.Id" Tab="@modelType.Name">
                        <Row Gutter="16">
                            @{
                                var configs = _llmGroups
                                .FirstOrDefault(g => g.ModelTypeId == modelType.Id)?.Configs ?? new List<LlmConfig>();
                            }
                            @foreach (var config in configs)
                            {
                                <AntDesign.Col Span="8" Class="mb-4">
                                    <Card>
                                        <TitleTemplate>
                                            <Space>
                                                <SpaceItem>
                                                    <Icon Type="@modelType.Icon" />
                                                </SpaceItem>
                                                <SpaceItem>
                                                    @config.Name
                                                </SpaceItem>
                                            </Space>
                                        </TitleTemplate>
                                        <Extra>
                                            <Tag Color="@(config.IsEnabled ? (config.IsBusy ? "orange" : "green") : "red")">
                                                @(config.IsEnabled ? (config.IsBusy ? "Busy" : "Available") : "Disabled")
                                            </Tag>
                                        </Extra>
                                        <ChildContent>
                                            <p>@config.Description</p>
                                            <div class="mt-3">
                                                <Space>
                                                    <SpaceItem>
                                                        <Button Type="@ButtonType.Primary" OnClick="() => EditConfig(config)">
                                                            <Icon Type="edit" />
                                                            Edit
                                                        </Button>
                                                    </SpaceItem>
                                                    <SpaceItem>
                                                        <Popconfirm Title="Are you sure to delete this model?"
                                                                    OkText="Yes"
                                                                    CancelText="No"
                                                                    OnConfirm="() => DeleteConfig(config)">
                                                            <Button Danger>
                                                                <Icon Type="delete" />
                                                                Delete
                                                            </Button>
                                                        </Popconfirm>
                                                    </SpaceItem>
                                                </Space>
                                            </div>
                                        </ChildContent>
                                    </Card>
                                </AntDesign.Col>
                            }
                        </Row>
                    </TabPane>
                }

            </Tabs>
        }
    </ChildContent>
</Card>

<Modal Title="Manage Model Types"
       Visible="@_showModelTypeDialog"
       OnOk="SaveModelTypes"
       OnCancel="CloseModelTypeDialog"
       Width="800">
    <Table TItem="LlmModelType"
           DataSource="@_modelTypes"
           Size="TableSize.Small">
        <Column Title="Name" TData="string">
            <Input @bind-Value="@context.Name" />
        </Column>
        <Column Title="Description" TData="string">
            <Input @bind-Value="@context.Description" />
        </Column>
        <Column Title="Icon" TData="string" Width="200">
            <IconSelectorInput @bind-Value="@context.Icon" />
        </Column>
        <Column Title="Default Endpoint" TData="string">
            <Input @bind-Value="@context.DefaultEndpoint" Placeholder="https://api.example.com" />
        </Column>
        <ActionColumn Title="Action" Width="100">
            <Space>
                <SpaceItem>
                    <Button Danger OnClick="() => RemoveModelType(context)">
                        <Icon Type="delete" />
                    </Button>
                </SpaceItem>
            </Space>
        </ActionColumn>
    </Table>
    <div class="mt-3">
        <Button Type="@ButtonType.Primary" OnClick="AddModelType">
            <Icon Type="plus" />
            Add Model Type
        </Button>
    </div>
</Modal>

<Modal Title="@(_editingConfig.Id == null ? "Add New Model" : "Edit Model")"
       Visible="@_showConfigDialog"
       OnOk="SaveConfig"
       OnCancel="CloseConfigDialog">
    <Form Model="@_editingConfig"
          LabelCol="new ColLayoutParam { Span = 8 }"
          WrapperCol="new ColLayoutParam { Span = 16 }">
        <FormItem Label="Name" Required>
            <Input @bind-Value="@_editingConfig.Name" />
        </FormItem>
        <FormItem Label="Description">
            <TextArea @bind-Value="@_editingConfig.Description" />
        </FormItem>
        <FormItem Label="Model Type" Required>
            <Select DataSource="@_modelTypes" TItem="LlmModelType" TItemValue="string"
                    @bind-Value="@_editingConfig.ModelTypeId"
                    ValueName="@nameof(LlmModelType.Id)"
                    LabelName="@nameof(LlmModelType.Name)"
                    OnSelectedItemChanged="OnModelTypeChanged"
                    Style="width: 100%;">
                <ItemTemplate Context="item">
                    <Space>
                        <SpaceItem>
                            <Icon Type="@item.Icon" />
                        </SpaceItem>
                        <SpaceItem>
                            @item.Name
                        </SpaceItem>
                    </Space>
                </ItemTemplate>
            </Select>
        </FormItem>
        <FormItem Label="Base URL" Required>
            <Input @bind-Value="@_editingConfig.BaseUrl" />
        </FormItem>
        <FormItem Label="API Key" Required>
            <Input @bind-Value="@_editingConfig.ApiKey" Type="InputType.Password" />
        </FormItem>
        <FormItem Label="Model" Required>
            <Input @bind-Value="@_editingConfig.Model" />
        </FormItem>
        <FormItem Label="Enabled">
            <Switch @bind-Value="@_editingConfig.IsEnabled" />
        </FormItem>
    </Form>
</Modal>

@code {
    private List<LlmModelType> _modelTypes = new();
    private List<LlmConfigGroup> _llmGroups = new();
    private bool _showConfigDialog;
    private bool _showModelTypeDialog;
    private LlmConfig _editingConfig = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadModelTypesAsync();
        await LoadConfigsAsync();
    }

    private async Task LoadModelTypesAsync()
    {
        _modelTypes = await LlmPoolService.GetModelTypesAsync();
    }

    private async Task LoadConfigsAsync()
    {
        _llmGroups = await LlmPoolService.GetLlmGroupsAsync();
    }

    private void ShowModelTypeModal()
    {
        _showModelTypeDialog = true;
    }

    private void AddModelType()
    {
        _modelTypes.Add(new LlmModelType 
        { 
            Icon = "api",
            CreatedAt = DateTime.UtcNow
        });
    }

    private async Task RemoveModelType(LlmModelType modelType)
    {
        try
        {
            if (!string.IsNullOrEmpty(modelType.Id))
            {
                await LlmPoolService.DeleteModelTypeAsync(modelType.Id);
                _message.Success($"Deleted model type: {modelType.Name}");
            }
            _modelTypes.Remove(modelType);
        }
        catch (InvalidOperationException ex)
        {
            _message.Error(ex.Message);
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to delete model type: {ex.Message}");
        }
    }

    private async Task SaveModelTypes()
    {
        var hasError = false;
        foreach (var modelType in _modelTypes)
        {
            if (string.IsNullOrWhiteSpace(modelType.Name))
            {
                _message.Error("Model type name is required");
                hasError = true;
                break;
            }
        }

        if (hasError) return;

        try 
        {
            foreach (var modelType in _modelTypes)
            {
                if (string.IsNullOrEmpty(modelType.Id))
                {
                    // 新增模型类型
                    modelType.Id = Guid.NewGuid().ToString("N");
                    modelType.CreatedAt = DateTime.UtcNow;
                    await LlmPoolService.AddModelTypeAsync(modelType);
                    _message.Success($"Added model type: {modelType.Name}");
                }
                else
                {
                    // 更新现有模型类型
                    modelType.UpdatedAt = DateTime.UtcNow;
                    await LlmPoolService.UpdateModelTypeAsync(modelType);
                    _message.Success($"Updated model type: {modelType.Name}");
                }
            }

            CloseModelTypeDialog();
            await LoadModelTypesAsync();
            await LoadConfigsAsync();
        }
        catch (Exception ex)
        {
            _message.Error($"Failed to save model types: {ex.Message}");
        }
    }

    private void CloseModelTypeDialog()
    {
        _showModelTypeDialog = false;
    }

    private void AddNewConfig()
    {
        if (!_modelTypes.Any())
        {
            _message.Warning("Please create model types first");
            ShowModelTypeModal();
            return;
        }

        _editingConfig = new LlmConfig
            {
                ModelTypeId = _modelTypes.First().Id
            };

        // 自动填充默认endpoint
        var selectedModelType = _modelTypes.First();
        if (!string.IsNullOrEmpty(selectedModelType.DefaultEndpoint))
        {
            _editingConfig.BaseUrl = selectedModelType.DefaultEndpoint;
        }

        _showConfigDialog = true;
    }

    private void EditConfig(LlmConfig config)
    {
        _editingConfig = new LlmConfig
            {
                Id = config.Id,
                Name = config.Name,
                Description = config.Description,
                ModelTypeId = config.ModelTypeId,
                BaseUrl = config.BaseUrl,
                ApiKey = config.ApiKey,
                Model = config.Model,
                IsEnabled = config.IsEnabled,
                AdditionalHeaders = new Dictionary<string, string>(config.AdditionalHeaders)
            };
        _showConfigDialog = true;
    }

    private async Task DeleteConfig(LlmConfig config)
    {
        await LlmPoolService.DeleteConfigAsync(config.Id);
        await LoadConfigsAsync();
    }

    private async Task SaveConfig()
    {
        if (string.IsNullOrWhiteSpace(_editingConfig.Name))
        {
            _message.Error("Name is required");
            return;
        }
        if (string.IsNullOrWhiteSpace(_editingConfig.ModelTypeId))
        {
            _message.Error("Model Type is required");
            return;
        }
        if (string.IsNullOrWhiteSpace(_editingConfig.BaseUrl))
        {
            _message.Error("Base URL is required");
            return;
        }
        if (string.IsNullOrWhiteSpace(_editingConfig.ApiKey))
        {
            _message.Error("API Key is required");
            return;
        }
        if (string.IsNullOrWhiteSpace(_editingConfig.Model))
        {
            _message.Error("Model is required");
            return;
        }

        if (string.IsNullOrEmpty(_editingConfig.Id))
        {
            await LlmPoolService.AddConfigAsync(_editingConfig);
        }
        else
        {
            await LlmPoolService.UpdateConfigAsync(_editingConfig);
        }

        CloseConfigDialog();
        await LoadConfigsAsync();
    }

    private void CloseConfigDialog()
    {
        _showConfigDialog = false;
        _editingConfig = new LlmConfig();
    }

    private void OnModelTypeChanged(LlmModelType item)
    {
        if (item is LlmModelType modelType && !string.IsNullOrEmpty(modelType.DefaultEndpoint))
        {
            _editingConfig.BaseUrl = modelType.DefaultEndpoint;
        }
    }
} 