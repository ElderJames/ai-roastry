@page "/endpoint-calls"
@using AntDesign.TableModels
@using LY.LlmPool.Web.Data.Entities
@using LY.LlmPool.Web.Services
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject LlmPoolService LlmPoolService
@inject MessageService _message
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Endpoint Call Records</PageTitle>

<Card>
    <TitleTemplate>
        <div class="d-flex justify-content-between align-items-center">
            <div>Endpoint Call Records</div>
            <div>
                <Button OnClick="ExportCsv" Disabled="@(!_callRecords.Any())">
                    <Icon Type="download" />
                    导出 CSV
                </Button>
            </div>
        </div>
    </TitleTemplate>
    <ChildContent>
        <Form Layout="FormLayout.Inline" Model="@_filterModel">
            <FormItem Label="Endpoint">
                @if (_endpoints.Any())
                {
                    <Select TItem="LlmEndpoint" 
                    TItemValue="string" 
                    DataSource="@_endpoints" 
                    @bind-Value="@_filterModel.EndpointId"
                    ValueName="@nameof(LlmEndpoint.Id)"
                    LabelName="@nameof(LlmEndpoint.Name)"
                    Style="width: 180px;"
                    AllowClear 
                    Placeholder="All Endpoints">
                    </Select>
                }
                else
                {
                    <div style="width: 180px; line-height: 32px;">Loading...</div>
                }
            </FormItem>
            <FormItem Label="LLM Model">
                @if (_configs.Any())
                {
                    <Select TItem="LlmConfig" 
                    TItemValue="string" 
                    DataSource="@_configs" 
                    @bind-Value="@_filterModel.ConfigId"
                    ValueName="@nameof(LlmConfig.Id)"
                    LabelName="@nameof(LlmConfig.Name)"
                    Style="width: 180px;"
                    AllowClear 
                    Placeholder="All Models">
                    </Select>
                }
                else
                {
                    <div style="width: 180px; line-height: 32px;">Loading...</div>
                }
            </FormItem>
            <FormItem Label="Date Range">
                <RangePicker @bind-Value="@_dateRange" Style="width: 300px;" />
            </FormItem>
            <FormItem Label="Strategy">
                <Select TItem="string"
                        TItemValue="string"
                        DataSource="@_strategyOptions"
                        @bind-Value="@_filterModel.Strategy"
                        AllowClear
                        Placeholder="All Strategies"
                        Style="width: 200px;" />
            </FormItem>
            <FormItem>
                <Button Type="@ButtonType.Primary" OnClick="ApplyFilters">
                    <Icon Type="search" />
                    Search
                </Button>
            </FormItem>
            <FormItem>
                <Button OnClick="ResetFilters">
                    <Icon Type="clear" />
                    Reset
                </Button>
            </FormItem>
        </Form>

        <Divider />

        <Table TItem="EndpointCallRecord"
        DataSource="@_callRecords"
        Loading="@_loading"
        Total="@_totalRecords"
        OnChange="HandleTableChange"
        PageIndex="@_pageIndex"
        PageSize="@_pageSize"
        @bind-SelectedRows="@_selectedRows">

            <Column Title="Request Time" 
            Sortable
            TData="DateTime">
                @context.RequestReceivedAt.ToString("yyyy-MM-dd HH:mm:ss")
            </Column>

            <Column Title="Endpoint" 
            TData="string" 
            Sortable>
                @(context.Endpoint?.Name ?? "Unknown")
            </Column>

            <Column Title="Model" 
            TData="string"
            Sortable>
                @(context.LlmConfig?.Name ?? "N/A")
            </Column>

            <Column Title="Wait Time" 
            TData="TimeSpan"
            Sortable>
                @context.WaitTime.TotalMilliseconds.ToString("0.00") ms
            </Column>

            <Column Title="Processing Time" 
            TData="TimeSpan?">
                @if (context.ModelProcessingTime.HasValue)
                {
                    <span>@context.ModelProcessingTime.Value.TotalSeconds.ToString("0.00") s</span>
                }
                else
                {
                    <span>N/A</span>
                }
            </Column>

            <Column Title="Tools" TData="string">
                @if (ToolCallCount(context.ResponseDataJson) > 0)
                {
                    <Tag Color="TagColor.Blue">@($"{ToolCallCount(context.ResponseDataJson)} call(s)")</Tag>
                }
                else
                {
                    <span>-</span>
                }
            </Column>

            <Column Title="Strategy" TData="string">
                @{
                    var strategy = GetSelectionStrategy(context.ResponseDataJson);
                }
                @if (!string.IsNullOrEmpty(strategy))
                {
                    <Tag>@strategy</Tag>
                }
                else
                {
                    <span>-</span>
                }
            </Column>

            <Column Title="Status" 
            TData="bool"
            Sortable>
                <Tag Color="@(context.IsSuccessful ? "green" : "red")">
                    @(context.IsSuccessful ? "Success" : "Failed")
                </Tag>
            </Column>

            <ActionColumn Title="Actions">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" 
                        Size="ButtonSize.Small"
                        OnClick="() => ViewCallDetail(context.Id)">
                            <Icon Type="eye" />
                            View
                        </Button>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    </ChildContent>
</Card>

@code {
    private List<EndpointCallRecord> _callRecords = new();
    private List<LlmEndpoint> _endpoints = new();
    private List<LlmConfig> _configs = new();
    private List<string> _strategyOptions = new() { "app-config", "app-endpoint-lb", "config-name-direct-acquire", "endpoint-name-lb", "endpoint-id-lb" };
    private bool _loading = false;
    private int _totalRecords = 0;
    private int _pageIndex = 1;
    private int _pageSize = 10;
    private FilterModel _filterModel = new();
    private IEnumerable<EndpointCallRecord> _selectedRows = new List<EndpointCallRecord>();
    private DateTime?[] _dateRange = new DateTime?[2];

    protected override async Task OnInitializedAsync()
    {
        // Get query parameters
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);

        if (queryParams.TryGetValue("configId", out var configId))
        {
            _filterModel.ConfigId = configId.ToString();
        }

        if (queryParams.TryGetValue("endpointId", out var endpointId))
        {
            _filterModel.EndpointId = endpointId.ToString();
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;

        try
        {
            // Load filter dropdowns
            _endpoints = await LlmPoolService.GetEndpointsAsync();
            _configs = await LlmPoolService.GetConfigsAsync();

            // Apply filters and load data
            await ApplyFilters();
        }
        catch (Exception ex)
        {
            _message.Error($"Error loading data: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _loading = true;

        try
        {
            // Extract date range if set
            DateTime? startDate = null;
            DateTime? endDate = null;

            if (_dateRange != null && _dateRange.Length == 2 && _dateRange is not [null,null])
            {
                startDate = _dateRange[0];
                if (_dateRange[1].HasValue)
                {
                    endDate = _dateRange[1]!.Value.AddDays(1); // Include the end date
                }
            }

            // Calculate skip for pagination
            int skip = (_pageIndex - 1) * _pageSize;

            // Load call records with filters
            _callRecords = await LlmPoolService.GetCallRecordsAsync(
                _filterModel.EndpointId,
                _filterModel.ConfigId,
                startDate,
                endDate,
                skip,
                _pageSize
            );

            // 额外在客户端按策略筛选（由 ResponseDataJson.selection.strategy 提供）
            if (!string.IsNullOrWhiteSpace(_filterModel.Strategy))
            {
                _callRecords = _callRecords
                    .Where(r => string.Equals(GetSelectionStrategy(r.ResponseDataJson), _filterModel.Strategy, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            // For simplicity, we're making an assumption about total count
            // In a production app, you'd want to have a separate count query
            _totalRecords = _callRecords.Count == _pageSize ? skip + _pageSize + 1 : skip + _callRecords.Count;
        }
        catch (Exception ex)
        {
            _message.Error($"Error applying filters: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetFilters()
    {
        _filterModel = new FilterModel();
        _dateRange = [];
        _pageIndex = 1;
        await ApplyFilters();
    }

    private async Task HandleTableChange(QueryModel<EndpointCallRecord> queryModel)
    {
        _pageIndex = queryModel.PageIndex;
        _pageSize = queryModel.PageSize;
        await ApplyFilters();
    }

    private void ViewCallDetail(string id)
    {
        NavigationManager.NavigateTo($"/call-detail/{id}");
    }

    private int ToolCallCount(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return 0;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object &&
                doc.RootElement.TryGetProperty("tool_calls", out var tc) &&
                tc.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                return tc.GetArrayLength();
            }
        }
        catch { }
        return 0;
    }

    private string? GetSelectionStrategy(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object &&
                doc.RootElement.TryGetProperty("selection", out var sel) && sel.ValueKind == System.Text.Json.JsonValueKind.Object &&
                sel.TryGetProperty("strategy", out var st) && st.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                return st.GetString();
            }
        }
        catch { }
        return null;
    }

    private class FilterModel
    {
        public string EndpointId { get; set; } = string.Empty;
        public string ConfigId { get; set; } = string.Empty;
        public string? Strategy { get; set; }
    }

    private async Task ExportCsv()
    {
        if (!_callRecords.Any())
        {
            _message.Warning("当前无数据可导出");
            return;
        }

        // Header
        var sb = new System.Text.StringBuilder();
        void AppendCsvCell(string? s)
        {
            s ??= string.Empty;
            var needsQuote = s.Contains('"') || s.Contains(',') || s.Contains('\n') || s.Contains('\r');
            s = s.Replace("\"", "\"\"");
            if (needsQuote) sb.Append('"').Append(s).Append('"'); else sb.Append(s);
        }

        string? GetStrategy(EndpointCallRecord r) => GetSelectionStrategy(r.ResponseDataJson) ?? string.Empty;

        // Columns: RequestTime, Endpoint, Model, WaitMs, ProcessSec, Strategy, Status
        sb.AppendLine("Request Time,Endpoint,Model,Wait(ms),Processing(s),Strategy,Status");
        foreach (var r in _callRecords)
        {
            var requestTime = r.RequestReceivedAt.ToString("yyyy-MM-dd HH:mm:ss");
            var endpoint = r.Endpoint?.Name ?? string.Empty;
            var model = r.LlmConfig?.Name ?? string.Empty;
            var waitMs = r.WaitTime.TotalMilliseconds.ToString("0.##", CultureInfo.InvariantCulture);
            var procSec = r.ModelProcessingTime.HasValue ? r.ModelProcessingTime.Value.TotalSeconds.ToString("0.##", CultureInfo.InvariantCulture) : string.Empty;
            var strategy = GetStrategy(r);
            var status = r.IsSuccessful ? "Success" : "Failed";

            AppendCsvCell(requestTime); sb.Append(',');
            AppendCsvCell(endpoint); sb.Append(',');
            AppendCsvCell(model); sb.Append(',');
            AppendCsvCell(waitMs); sb.Append(',');
            AppendCsvCell(procSec); sb.Append(',');
            AppendCsvCell(strategy); sb.Append(',');
            AppendCsvCell(status); sb.AppendLine();
        }

        var csv = sb.ToString();
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
        var base64 = Convert.ToBase64String(bytes);
        var dataUrl = $"data:text/csv;base64,{base64}";

        var fileName = $"endpoint-calls-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv";
        await JSRuntime.InvokeVoidAsync("downloadDataUrl", dataUrl, fileName);
    }
} 