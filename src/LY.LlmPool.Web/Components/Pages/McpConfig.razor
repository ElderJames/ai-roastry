@code {
    private List<McpServerConfig> _items = new();
    private bool _showDialog;
    private McpServerConfig? _editing;
    //private string? _fetchingId;
    // tools modal state
    private bool _showToolsModal;
    private string? _toolsLoadingId;
    private List<ToolRow> _tools = new();

    private class ToolRow
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? JsonSchema { get; set; }
        // UI state
        public bool Expanded { get; set; }
        public string? FormattedJson { get; set; }
    }

    private async Task ReloadAsync()
    {
        _items = await McpService.ListAsync(); 
        StateHasChanged();
    }

    private void ShowAddDialog()
    {
        _editing = new McpServerConfig();
        _showDialog = true;
    }

    private void Edit(McpServerConfig item)
    {
        _editing = new McpServerConfig
        {
            Id = item.Id,
            Name = item.Name,
            Url = item.Url,
            Description = item.Description,
            SchemaCacheJson = item.SchemaCacheJson
        };
        _showDialog = true;
    }

    private async Task Save()
    {
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _message.Error("名称必填");
            return;
        }
        if (string.IsNullOrWhiteSpace(_editing.Url))
        {
            _message.Error("URL 必填");
            return;
        }

        try
        {
            if (string.IsNullOrEmpty(_editing.Id))
            {
                await McpService.CreateAsync(_editing);
                _message.Success($"已创建: {_editing.Name}");
            }
            else
            {
                var ok = await McpService.UpdateAsync(_editing);
                if (!ok)
                {
                    _message.Warning("未找到要更新的记录");
                }
                else
                {
                    _message.Success("已保存修改");
                }
            }
            await ReloadAsync();
            CloseDialog();
        }
        catch (Exception ex)
        {
            _message.Error($"保存失败: {ex.Message}");
        }
    }

    private async Task Delete(McpServerConfig item)
    {
        try
        {
            await McpService.DeleteAsync(item.Id);
            _message.Success($"已删除: {item.Name}");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message.Error($"删除失败: {ex.Message}");
        }
    }
     
    private int GetToolsCount(McpServerConfig cfg)
    {
        if (string.IsNullOrWhiteSpace(cfg.SchemaCacheJson)) return 0;
        return McpServerConfigService.ParseCounts(cfg.SchemaCacheJson).tools;
    }

    private int GetPromptsCount(McpServerConfig cfg)
    {
        if (string.IsNullOrWhiteSpace(cfg.SchemaCacheJson)) return 0;
        return McpServerConfigService.ParseCounts(cfg.SchemaCacheJson).prompts;
    }

    private void CloseDialog()
    {
        _showDialog = false;
    }

    private async Task ViewTools(McpServerInfo item)
    {
        try
        {
            _toolsLoadingId = item.ServerId;
            _tools.Clear();
            StateHasChanged();
            var details = await McpService.GetToolsDetailedAsync(item.ServerId);
            // map to local list for UI
            _tools.AddRange(details.Select(t => new ToolRow {
                Id = t.Id,
                Name = t.Name,
                Description = t.Description,
                JsonSchema = t.JsonSchema,
                Expanded = false,
                FormattedJson = TryFormatJson(t.JsonSchema)
            }));
            _showToolsModal = true;
        }
        catch (Exception ex)
        {
            _message.Error($"获取工具失败: {ex.Message}");
        }
        finally
        {
            _toolsLoadingId = null;
            StateHasChanged();
        }
    }

    private static string? TryFormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            // not valid json, return original
            return json;
        }
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text ?? string.Empty);
            _message.Success("已复制到剪贴板");
        }
        catch
        {
            _message.Warning("复制失败：浏览器不允许或不可用");
        }
    }

    private void CloseToolsModal()
    {
        _showToolsModal = false;
        _tools.Clear();
    }

    protected void InspectServer(string serverId) => NavigationManager.NavigateTo($"/inspector?server={serverId}");
}

<Modal Title="MCP 工具列表" Visible="@_showToolsModal" OnOk="CloseToolsModal" OnCancel="CloseToolsModal" Width="800">
    <div style="max-height:60vh; overflow:auto;">
        @if (_tools == null || _tools.Count == 0)
        {
            <div>没有可用工具。</div>
        }
        else
        {
            <Table TItem="ToolRow" DataSource="_tools">
                <Column TData="string" Title="ID">@context.Id</Column>
                <Column TData="string" Title="名称">@context.Name</Column>
                <Column TData="string" Title="描述">@context.Description</Column>
                <Column TData="string" Title="JSON Schema" Width="220">
                    <Space>
                        <Button Size="@ButtonSize.Small" OnClick="@( (Func<Task>)(async () => {
                            // toggle expand for this row
                        }) )">切换</Button>
                    </Space>
                </Column>
            </Table>
            @foreach (var t in _tools)
            {
                if (!string.IsNullOrWhiteSpace(t.JsonSchema))
                {
                    <Card Style="margin-top:8px;">
                        <div class="d-flex justify-content-between align-items-start">
                            <div><strong>@t.Name (@t.Id)</strong></div>
                            <div>
                                <Space>
                                    <Button Size="@ButtonSize.Small" OnClick="() => { t.Expanded = !t.Expanded; StateHasChanged(); }">@((t.Expanded) ? "收起" : "展开")</Button>
                                    <Button Size="@ButtonSize.Small" OnClick="() => CopyToClipboard(t.FormattedJson ?? t.JsonSchema)">复制</Button>
                                </Space>
                            </div>
                        </div>
                        @if (t.Expanded)
                        {
                            <pre style="white-space:pre-wrap; word-break:break-all; margin-top:8px;">@t.FormattedJson</pre>
                        }
                        else
                        {
                            <div style="color:var(--ant-gray-6); margin-top:8px;">(已隐藏，点击展开查看)</div>
                        }
                    </Card>
                }
            }
        }
    </div>
</Modal>
