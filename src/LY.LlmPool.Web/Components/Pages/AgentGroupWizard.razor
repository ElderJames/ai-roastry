@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using LY.LlmPool.Web.Data.Entities
@using LY.LlmPool.Web.Models
@using LY.LlmPool.Web.Services
@using AntDesign
@using AntDesign.TableModels
@inject LlmPoolService LlmPoolService
@inject MessageService _message

<div class="agent-group-wizard">
    <Steps Current="_step">
        <Step Title="成员配置" />
        <Step Title="确认创建" />
    </Steps>

    @if (_step == 0)
    {
        <div class="mt-3">
            <Form Model="_formModel" Layout="FormLayout.Vertical">
                <FormItem Label="编排模式">
                    <div data-testid="wizard-orch-mode">
                        <Select TItemValue="string" TItem="string" @bind-Value="_orchestrationMode" DataSource="_orchestrationModes" />
                    </div>
                </FormItem>
                @if (_orchestrationMode == "GroupChat")
                {
                    <Row Gutter="16" Class="mt-1">
                        <AntDesign.Col Span="6">
                            <FormItem Label="最大轮次">
                                <div data-testid="wizard-gc-maxrounds">
                                    <AntDesign.InputNumber @bind-Value="_gcMaxRounds" Min="1" Max="10" />
                                </div>
                            </FormItem>
                        </AntDesign.Col>
                        <AntDesign.Col Span="6">
                            <FormItem Label="遇 FINAL 提前结束">
                                <div data-testid="wizard-gc-stoponfinal">
                                    <Switch @bind-Checked="_gcStopOnFinal" />
                                </div>
                            </FormItem>
                        </AntDesign.Col>
                        <AntDesign.Col Span="12">
                            <FormItem Label="角色顺序（逗号分隔）">
                                <div data-testid="wizard-gc-roleorder">
                                    <Input @bind-Value="_gcRoleOrder" Placeholder="planner,researcher,moderator" />
                                </div>
                            </FormItem>
                        </AntDesign.Col>
                    </Row>
                    <Row Gutter="16">
                        <AntDesign.Col Span="12">
                            <FormItem Label="上下文消息条数上限">
                                <div data-testid="wizard-gc-contextlimit">
                                    <AntDesign.InputNumber @bind-Value="_gcContextLimit" Min="10" Max="200" />
                                </div>
                            </FormItem>
                        </AntDesign.Col>
                    </Row>
                }
                @if (_orchestrationMode == "DAG")
                {
                    <Row Gutter="16" Class="mt-1">
                        <AntDesign.Col Span="8">
                            <FormItem Label="最大并行度">
                                <div data-testid="wizard-dag-maxparallel">
                                    <AntDesign.InputNumber @bind-Value="_dagMaxParallelism" Min="1" Max="10" />
                                </div>
                                <span class="ant-form-text text-secondary">同时执行的最大 Agent 数量</span>
                            </FormItem>
                        </AntDesign.Col>
                        <AntDesign.Col Span="8">
                            <FormItem Label="全局超时（秒）">
                                <div data-testid="wizard-dag-timeout">
                                    <AntDesign.InputNumber @bind-Value="_dagGlobalTimeout" Min="60" Max="3600" />
                                </div>
                                <span class="ant-form-text text-secondary">整个 DAG 执行的最大时长</span>
                            </FormItem>
                        </AntDesign.Col>
                        <AntDesign.Col Span="8">
                            <FormItem Label="失败策略">
                                <div data-testid="wizard-dag-failure">
                                    <Select TItemValue="string" TItem="string" @bind-Value="_dagFailureStrategy" DataSource="@(new[] { "stop", "continue", "retry" })" />
                                </div>
                                <span class="ant-form-text text-secondary">遇到错误时的处理方式</span>
                            </FormItem>
                        </AntDesign.Col>
                    </Row>
                    <Alert Type="@AlertType.Info" Message="DAG 配置说明" Class="mt-2">
                        <MessageTemplate>
                            <div>
                                <ul style="margin: 0; padding-left: 20px;">
                                    <li><b>最大并行度</b>：控制同时运行的 Agent 数量，建议设置为 2-5</li>
                                    <li><b>全局超时</b>：整个 DAG 工作流的最大执行时间</li>
                                    <li><b>失败策略</b>：stop=立即停止，continue=跳过失败节点继续，retry=重试失败节点</li>
                                    <li>在下方表格中，您可以为每个 Agent 配置依赖关系（在确认页面设置）</li>
                                </ul>
                            </div>
                        </MessageTemplate>
                    </Alert>
                }
            </Form>

            <Divider>Agent 成员</Divider>
            <Space>
                <SpaceItem>
                    <div data-testid="wizard-add-row">
                        <Button Type="@ButtonType.Primary" OnClick="AddRow"><Icon Type="plus" /> 添加一行</Button>
                    </div>
                </SpaceItem>
                <SpaceItem>
                    <div data-testid="wizard-import-prompts">
                        <Button OnClick="ImportAllPrompts">从全部 Prompt 生成</Button>
                    </div>
                </SpaceItem>
            </Space>

            <Table TItem="MemberRow" DataSource="_rows" Size="TableSize.Small" Bordered Class="mt-2" ExpandIconColumnIndex="0">
                <ExpandTemplate Context="rowData">
                    @{
                        var row = rowData.Data;
                        RenderFragment content = @<div style="padding: 16px; background: #fafafa;">
                            <h4>DAG 配置 - @DisplayName(row)</h4>
                            <Row Gutter="16">
                                <AntDesign.Col Span="12">
                                    <FormItem Label="依赖节点（可多选）">
                                        <Select Mode="@SelectMode.Multiple"
                                                TItemValue="string"
                                                TItem="string"
                                                Values="@row.Dependencies"
                                                ValuesChanged="@((IEnumerable<string> vals) => row.Dependencies = vals?.ToList())"
                                                DataSource="@GetAvailableDependencies(row)"
                                                Placeholder="选择前置依赖节点"
                                                AllowClear />
                                        <span class="ant-form-text text-secondary">此 Agent 依赖的前置节点，留空表示无依赖</span>
                                    </FormItem>
                                </AntDesign.Col>
                                <AntDesign.Col Span="6">
                                    <FormItem Label="并行组">
                                        <Input @bind-Value="row.ParallelGroup" Placeholder="如：research" />
                                        <span class="ant-form-text text-secondary">同组节点可并行执行</span>
                                    </FormItem>
                                </AntDesign.Col>
                                <AntDesign.Col Span="6">
                                    <FormItem Label="超时（秒）">
                                        <AntDesign.InputNumber @bind-Value="row.TimeoutSeconds" Min="10" Max="3600" Placeholder="默认300" />
                                        <span class="ant-form-text text-secondary">节点执行超时时间</span>
                                    </FormItem>
                                </AntDesign.Col>
                            </Row>
                            <Row Gutter="16">
                                <AntDesign.Col Span="12">
                                    <FormItem Label="失败时继续">
                                        <Checkbox Checked="@(row.ContinueOnFailure ?? false)" 
                                                  CheckedChanged="@((bool val) => row.ContinueOnFailure = val)">
                                            失败时是否继续执行后续节点
                                        </Checkbox>
                                    </FormItem>
                                </AntDesign.Col>
                            </Row>
                        </div>;
                    }
                    @if (_orchestrationMode == "DAG")
                    {
                        @content
                    }
                </ExpandTemplate>
                <ChildContent Context="row">
                    <Column Title="#" TData="int">@row.Order</Column>
                    <Column Title="名称" TData="string">
                        <Input @bind-Value="row.Name" Placeholder="可空，自动填充" />
                    </Column>
                    <Column Title="角色" TData="string">
                        <Input @bind-Value="row.Role" Placeholder="如：Planner/Researcher" />
                    </Column>
                    <Column Title="Prompt" TData="string" Width="100px">
                        <Select TItem="LlmPrompt" TItemValue="string" ValueName="Id" LabelName="Name" @bind-Value="row.LlmPromptId" DataSource="_prompts" AllowClear />
                    </Column>
                    <Column Title="模型配置" TData="string" Width="100px">
                        <Select TItem="LlmConfig" TItemValue="string" ValueName="Id" LabelName="Name" @bind-Value="row.LlmConfigId" DataSource="_configs" />
                    </Column>
                    @if (_orchestrationMode == "DAG")
                    {
                        <Column Title="DAG 配置" TData="string">
                            @{
                                var depCount = row.Dependencies?.Count ?? 0;
                                var hasTimeout = row.TimeoutSeconds.HasValue;
                                var hasGroup = !string.IsNullOrWhiteSpace(row.ParallelGroup);
                                var badges = new List<string>();
                                if (depCount > 0) badges.Add($"依赖:{depCount}");
                                if (hasGroup) badges.Add($"组:{row.ParallelGroup}");
                                if (hasTimeout) badges.Add($"超时:{row.TimeoutSeconds}s");
                                if (row.ContinueOnFailure == true) badges.Add("继续");
                            }
                            @if (badges.Any())
                            {
                                foreach (var badge in badges)
                                {
                                    <Tag Color="@("blue")" Style="margin: 2px;">@badge</Tag>
                                }
                            }
                            else
                            {
                                <span class="text-secondary">未配置</span>
                            }
                        </Column>
                    }
                    <ActionColumn Title="操作">
                        <Space>
                            <SpaceItem>
                                <Button OnClick="() => MoveUp(row)"><Icon Type="arrow-up" /></Button>
                            </SpaceItem>
                            <SpaceItem>
                                <Button OnClick="() => MoveDown(row)"><Icon Type="arrow-down" /></Button>
                            </SpaceItem>
                            <SpaceItem>
                                <Button Danger OnClick="() => RemoveRow(row)"><Icon Type="delete" /></Button>
                            </SpaceItem>
                        </Space>
                    </ActionColumn>
                </ChildContent>
            </Table>

            <Space Class="mt-3">
                <SpaceItem>
                    <Button OnClick="CancelAsync">取消</Button>
                </SpaceItem>
                <SpaceItem>
                    <div data-testid="wizard-next">
                        <Button Type="@ButtonType.Primary" OnClick="NextStep">下一步</Button>
                    </div>
                </SpaceItem>
            </Space>
        </div>
    }
    else
    {
        <div class="mt-3">
            <Descriptions Title="确认信息" Bordered>
                <DescriptionsItem Title="编排模式">@_orchestrationMode</DescriptionsItem>
                <DescriptionsItem Title="成员数">@_rows.Count</DescriptionsItem>
            </Descriptions>

            @if (_orchestrationMode == "GroupChat")
            {
                <Descriptions Bordered Size="DescriptionsSize.Small" Class="mt-2">
                    <DescriptionsItem Title="最大轮次">@_gcMaxRounds</DescriptionsItem>
                    <DescriptionsItem Title="遇 FINAL 提前结束">@(_gcStopOnFinal ? "是" : "否")</DescriptionsItem>
                    <DescriptionsItem Title="角色顺序">@_gcRoleOrder</DescriptionsItem>
                    <DescriptionsItem Title="上下文消息条数上限">@_gcContextLimit</DescriptionsItem>
                </Descriptions>
            }
            @if (_orchestrationMode == "DAG")
            {
                <Descriptions Bordered Size="DescriptionsSize.Small" Class="mt-2">
                    <DescriptionsItem Title="最大并行度">@_dagMaxParallelism</DescriptionsItem>
                    <DescriptionsItem Title="全局超时">@_dagGlobalTimeout 秒</DescriptionsItem>
                    <DescriptionsItem Title="失败策略">@_dagFailureStrategy</DescriptionsItem>
                </Descriptions>
            }

            <Table TItem="MemberRow" DataSource="_rows" Size="TableSize.Small" Bordered Class="mt-2">
                <ChildContent Context="row">
                    <Column Title="#" TData="int">@row.Order</Column>
                    <Column Title="名称" TData="string">@DisplayName(row)</Column>
                    <Column Title="角色" TData="string">@DisplayRole(row)</Column>
                    <Column Title="Prompt" TData="string">@DisplayPrompt(row)</Column>
                    <Column Title="模型配置" TData="string">@DisplayConfig(row)</Column>
                </ChildContent>
            </Table>

            <Space Class="mt-3">
                <SpaceItem>
                    <Button OnClick="PrevStep">上一步</Button>
                </SpaceItem>
                <SpaceItem>
                    <Button OnClick="CancelAsync">取消</Button>
                </SpaceItem>
                <SpaceItem>
                    <div data-testid="wizard-confirm">
                        <Button Type="@ButtonType.Primary" Loading="_saving" OnClick="CreateAll">确认</Button>
                    </div>
                </SpaceItem>
            </Space>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<AgentGroupWizardResult> OnCreated { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public LlmApp? InitialApp { get; set; }

    [Parameter]
    public IEnumerable<AgentMember>? InitialMembers { get; set; }

    [Parameter]
    public bool IsDialog { get; set; } = true;

    private int _step = 0;
    private readonly List<string> _orchestrationModes = new() { "Sequential", "GroupChat", "DAG" };
    private string _orchestrationMode = "Sequential";
    private int _gcMaxRounds = 1;
    private bool _gcStopOnFinal = true;
    private string _gcRoleOrder = "planner,researcher,moderator";
    private int _gcContextLimit = 50;
    
    // DAG 配置
    private int _dagMaxParallelism = 2;
    private int _dagGlobalTimeout = 600;
    private string _dagFailureStrategy = "stop";

    private readonly object _formModel = new();
    private List<LlmPrompt> _prompts = new();
    private List<LlmConfig> _configs = new();
    private List<MemberRow> _rows = new();
    private bool _saving;
    private bool _lookupsLoaded;
    private string? _initialAppSignature;
    private string? _initialMembersSignature;

    protected override async Task OnInitializedAsync()
    {
        _prompts = await LlmPoolService.GetPromptsAsync();
        _configs = await LlmPoolService.GetConfigsAsync();
        _lookupsLoaded = true;

        ApplyInitialAppConfig(force: true);
        ApplyInitialMembers(force: true);
        EnsureDefaultRow();
    }

    protected override void OnParametersSet()
    {
        if (!_lookupsLoaded)
        {
            return;
        }

        ApplyInitialAppConfig();
        ApplyInitialMembers();
        EnsureDefaultRow();
    }

    private void NextStep()
    {
        if (_rows.Count == 0)
        {
            _message.Error("至少添加一个成员");
            return;
        }

        _step = Math.Min(_step + 1, 1);
    }

    private void PrevStep()
    {
        if (_step > 0)
        {
            _step--;
        }
    }

    private void AddRow()
    {
        _rows.Add(new MemberRow { Order = _rows.Count + 1 });
    }

    private void RemoveRow(MemberRow row)
    {
        _rows.Remove(row);
        Renumber();
    }

    private void MoveUp(MemberRow row)
    {
        var index = _rows.IndexOf(row);
        if (index > 0)
        {
            (_rows[index - 1], _rows[index]) = (_rows[index], _rows[index - 1]);
            Renumber();
        }
    }

    private void MoveDown(MemberRow row)
    {
        var index = _rows.IndexOf(row);
        if (index < _rows.Count - 1)
        {
            (_rows[index + 1], _rows[index]) = (_rows[index], _rows[index + 1]);
            Renumber();
        }
    }

    private void Renumber()
    {
        for (int i = 0; i < _rows.Count; i++)
        {
            _rows[i].Order = i + 1;
        }
    }

    private void ImportAllPrompts()
    {
        _rows.Clear();
        int order = 1;
        foreach (var prompt in _prompts)
        {
            _rows.Add(new MemberRow { Order = order++, Name = prompt.Name, LlmPromptId = prompt.Id });
        }
    }

    private IEnumerable<string> GetAvailableDependencies(MemberRow current)
    {
        return _rows
            .Where(r => r.Order < current.Order)
            .Select(r => !string.IsNullOrWhiteSpace(r.Name) ? r.Name! : $"Agent {r.Order}")
            .ToList();
    }

    private async Task CreateAll()
    {
        if (_saving)
        {
            return;
        }

        if (_rows.Count == 0)
        {
            _message.Error("至少添加一个成员");
            return;
        }

        try
        {
            _saving = true;
            var members = _rows.Select(r =>
            {
                var member = new AgentMember
                {
                    Name = string.IsNullOrWhiteSpace(r.Name) ? $"Agent {r.Order}" : r.Name!,
                    Role = string.IsNullOrWhiteSpace(r.Role) ? "Agent" : r.Role!,
                    Order = r.Order,
                    LlmPromptId = r.LlmPromptId ?? string.Empty,
                    LlmConfigId = r.LlmConfigId ?? string.Empty
                };

                // 如果是 DAG 模式,序列化 DAG 配置到 ConfigJson
                if (_orchestrationMode == "DAG" && (r.Dependencies?.Any() == true || !string.IsNullOrWhiteSpace(r.ParallelGroup) 
                    || r.TimeoutSeconds.HasValue || r.ContinueOnFailure.HasValue))
                {
                    var dagConfig = new AgentMemberDAGConfig
                    {
                        Dependencies = r.Dependencies,
                        ParallelGroup = r.ParallelGroup,
                        TimeoutSeconds = r.TimeoutSeconds,
                        ContinueOnFailure = r.ContinueOnFailure
                    };
                    member.ConfigJson = JsonSerializer.Serialize(dagConfig);
                }

                return member;
            }).ToList();

            var result = new AgentGroupWizardResult
            {
                Members = members,
                OrchestrationMode = _orchestrationMode == "GroupChat" ? OrchestrationMode.GroupChat 
                                  : _orchestrationMode == "DAG" ? OrchestrationMode.DAG 
                                  : OrchestrationMode.Sequential
            };

            if (result.OrchestrationMode == OrchestrationMode.GroupChat)
            {
                result.GroupChatMaxRounds = _gcMaxRounds;
                result.GroupChatStopOnFinal = _gcStopOnFinal;
                result.GroupChatRoleOrder = _gcRoleOrder;
                result.GroupChatContextLimit = _gcContextLimit;
            }

            if (result.OrchestrationMode == OrchestrationMode.DAG)
            {
                result.DAGMaxParallelism = _dagMaxParallelism;
                result.DAGGlobalTimeout = _dagGlobalTimeout;
                result.DAGFailureStrategy = _dagFailureStrategy;
            }

            if (OnCreated.HasDelegate)
            {
                await OnCreated.InvokeAsync(result);
            }
            else
            {
                _message.Success("向导已完成");
            }
        }
        catch (Exception ex)
        {
            _message.Error($"创建失败: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CancelAsync()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    private void ApplyInitialAppConfig(bool force = false)
    {
        if (InitialApp == null)
        {
            return;
        }

        var signature = ComputeAppSignature(InitialApp);
        if (!force && signature == _initialAppSignature)
        {
            return;
        }

        _initialAppSignature = signature;

        _orchestrationMode = InitialApp.OrchestrationMode switch
        {
            OrchestrationMode.GroupChat => "GroupChat",
            OrchestrationMode.DAG => "DAG",
            _ => "Sequential"
        };

        ResetGroupChatDefaults();
        ResetDagDefaults();

        var cfg = InitialApp.Config;
        if (InitialApp.OrchestrationMode == OrchestrationMode.GroupChat)
        {
            ApplyGroupChatConfig(cfg);
        }
        else if (InitialApp.OrchestrationMode == OrchestrationMode.DAG)
        {
            ApplyDagConfig(cfg);
        }
    }

    private void ApplyInitialMembers(bool force = false)
    {
        var memberList = InitialMembers?.ToList() ?? new List<AgentMember>();
        var signature = ComputeMembersSignature(memberList);
        if (!force && signature == _initialMembersSignature)
        {
            return;
        }

        _initialMembersSignature = signature;

        if (memberList.Count == 0)
        {
            _rows.Clear();
            return;
        }

        LoadRowsFromMembers(memberList);
    }

    private void ApplyGroupChatConfig(Dictionary<string, object> cfg)
    {
        if (cfg.TryGetValue("GroupChatMaxRounds", out var maxObj) && TryConvertToInt(maxObj, out var rounds))
        {
            _gcMaxRounds = Math.Clamp(rounds, 1, 10);
        }
        if (cfg.TryGetValue("GroupChatStopOnFinal", out var stopObj) && TryConvertToBool(stopObj, out var stop))
        {
            _gcStopOnFinal = stop;
        }
        if (cfg.TryGetValue("GroupChatRoleOrder", out var roleObj) && TryConvertToString(roleObj, out var roleOrder) && !string.IsNullOrWhiteSpace(roleOrder))
        {
            _gcRoleOrder = roleOrder;
        }
        if (cfg.TryGetValue("GroupChatContextLimit", out var limitObj) && TryConvertToInt(limitObj, out var limit))
        {
            _gcContextLimit = Math.Clamp(limit, 10, 200);
        }
    }

    private void ApplyDagConfig(Dictionary<string, object> cfg)
    {
        if (!cfg.TryGetValue("DAGWorkflow", out var dagObj))
        {
            return;
        }

        if (dagObj is JsonElement dagElement && dagElement.ValueKind == JsonValueKind.Object)
        {
            if (dagElement.TryGetProperty("MaxParallelism", out var maxParallelElem) && maxParallelElem.TryGetInt32(out var maxParallel))
            {
                _dagMaxParallelism = Math.Clamp(maxParallel, 1, 10);
            }
            if (dagElement.TryGetProperty("GlobalTimeoutSeconds", out var timeoutElem) && timeoutElem.TryGetInt32(out var timeout))
            {
                _dagGlobalTimeout = Math.Clamp(timeout, 60, 3600);
            }
            if (dagElement.TryGetProperty("FailureStrategy", out var failureElem) && failureElem.ValueKind == JsonValueKind.String)
            {
                var strategy = failureElem.GetString();
                if (!string.IsNullOrWhiteSpace(strategy))
                {
                    _dagFailureStrategy = strategy;
                }
            }
            return;
        }

        if (dagObj is IDictionary<string, object> dagDict)
        {
            if (dagDict.TryGetValue("MaxParallelism", out var maxParallelObj) && TryConvertToInt(maxParallelObj, out var maxParallel))
            {
                _dagMaxParallelism = Math.Clamp(maxParallel, 1, 10);
            }
            if (dagDict.TryGetValue("GlobalTimeoutSeconds", out var timeoutObj) && TryConvertToInt(timeoutObj, out var timeout))
            {
                _dagGlobalTimeout = Math.Clamp(timeout, 60, 3600);
            }
            if (dagDict.TryGetValue("FailureStrategy", out var strategyObj) && TryConvertToString(strategyObj, out var strategy) && !string.IsNullOrWhiteSpace(strategy))
            {
                _dagFailureStrategy = strategy;
            }
        }
    }

    private void LoadRowsFromMembers(IEnumerable<AgentMember> members)
    {
        _rows = members
            .OrderBy(m => m.Order == 0 ? int.MaxValue : m.Order)
            .ThenBy(m => m.Name)
            .Select((m, index) =>
            {
                var row = new MemberRow
                {
                    Order = index + 1,
                    Name = string.IsNullOrWhiteSpace(m.Name) ? null : m.Name,
                    Role = string.IsNullOrWhiteSpace(m.Role) ? null : m.Role,
                    LlmPromptId = ResolvePromptId(m),
                    LlmConfigId = ResolveConfigId(m)
                };

                // 如果有 ConfigJson,尝试反序列化 DAG 配置
                if (!string.IsNullOrWhiteSpace(m.ConfigJson))
                {
                    try
                    {
                        var dagConfig = JsonSerializer.Deserialize<AgentMemberDAGConfig>(m.ConfigJson);
                        if (dagConfig != null)
                        {
                            row.Dependencies = dagConfig.Dependencies;
                            row.ParallelGroup = dagConfig.ParallelGroup;
                            row.TimeoutSeconds = dagConfig.TimeoutSeconds;
                            row.ContinueOnFailure = dagConfig.ContinueOnFailure;
                        }
                    }
                    catch
                    {
                        // 忽略反序列化错误
                    }
                }

                return row;
            })
            .ToList();
    }

    private string? ResolvePromptId(AgentMember member)
    {
        if (!string.IsNullOrWhiteSpace(member.LlmPromptId) && _prompts.Any(p => p.Id == member.LlmPromptId))
        {
            return member.LlmPromptId;
        }

        if (member.LlmPrompt != null)
        {
            if (!string.IsNullOrWhiteSpace(member.LlmPrompt.Id) && _prompts.Any(p => p.Id == member.LlmPrompt.Id))
            {
                return member.LlmPrompt.Id;
            }

            var promptByName = _prompts.FirstOrDefault(p => string.Equals(p.Name, member.LlmPrompt.Name, StringComparison.OrdinalIgnoreCase));
            if (promptByName != null)
            {
                return promptByName.Id;
            }
        }

        return member.LlmPromptId;
    }

    private string? ResolveConfigId(AgentMember member)
    {
        if (!string.IsNullOrWhiteSpace(member.LlmConfigId) && _configs.Any(c => c.Id == member.LlmConfigId))
        {
            return member.LlmConfigId;
        }

        if (member.LlmConfig != null)
        {
            if (!string.IsNullOrWhiteSpace(member.LlmConfig.Id) && _configs.Any(c => c.Id == member.LlmConfig.Id))
            {
                return member.LlmConfig.Id;
            }

            var configByName = _configs.FirstOrDefault(c => string.Equals(c.Name, member.LlmConfig.Name, StringComparison.OrdinalIgnoreCase));
            if (configByName != null)
            {
                return configByName.Id;
            }
        }

        return member.LlmConfigId;
    }

    private void EnsureDefaultRow()
    {
        if (_rows.Count == 0)
        {
            _rows.Add(new MemberRow { Order = 1 });
        }
        else
        {
            Renumber();
        }
    }

    private static string ComputeMembersSignature(IReadOnlyCollection<AgentMember> members)
    {
        if (members.Count == 0)
        {
            return string.Empty;
        }

        return string.Join("|", members
            .OrderBy(m => m.Order == 0 ? int.MaxValue : m.Order)
            .ThenBy(m => m.Name)
            .Select(m => string.Join("~", new[]
            {
                m.Id ?? string.Empty,
                m.Name ?? string.Empty,
                m.Role ?? string.Empty,
                m.Order.ToString(),
                m.LlmPromptId ?? string.Empty,
                m.LlmConfigId ?? string.Empty,
                m.ConfigJson ?? string.Empty
            })));
    }

    private static string ComputeAppSignature(LlmApp app)
    {
        var key = !string.IsNullOrWhiteSpace(app.Id) ? app.Id! : app.Name;
        return $"{key}|{app.OrchestrationMode}|{app.ConfigJson}";
    }

    private void ResetGroupChatDefaults()
    {
        _gcMaxRounds = 1;
        _gcStopOnFinal = true;
        _gcRoleOrder = "planner,researcher,moderator";
        _gcContextLimit = 50;
    }

    private void ResetDagDefaults()
    {
        _dagMaxParallelism = 2;
        _dagGlobalTimeout = 600;
        _dagFailureStrategy = "stop";
    }

    private static bool TryConvertToInt(object? value, out int result)
    {
        switch (value)
        {
            case int i:
                result = i;
                return true;
            case long l when l <= int.MaxValue && l >= int.MinValue:
                result = (int)l;
                return true;
            case double d:
                result = (int)d;
                return true;
            case JsonElement je when je.ValueKind == JsonValueKind.Number && je.TryGetInt32(out var v):
                result = v;
                return true;
            case string s when int.TryParse(s, out var parsed):
                result = parsed;
                return true;
            default:
                result = default;
                return false;
        }
    }

    private static bool TryConvertToBool(object? value, out bool result)
    {
        switch (value)
        {
            case bool b:
                result = b;
                return true;
            case JsonElement je when je.ValueKind is JsonValueKind.True or JsonValueKind.False:
                result = je.ValueKind == JsonValueKind.True;
                return true;
            case string s when bool.TryParse(s, out var parsed):
                result = parsed;
                return true;
            default:
                result = default;
                return false;
        }
    }

    private static bool TryConvertToString(object? value, out string? result)
    {
        switch (value)
        {
            case string s:
                result = s;
                return true;
            case JsonElement je when je.ValueKind == JsonValueKind.String:
                result = je.GetString();
                return true;
            default:
                result = null;
                return false;
        }
    }

    private string DisplayName(MemberRow row) => string.IsNullOrWhiteSpace(row.Name) ? $"Agent {row.Order}" : row.Name!;

    private string DisplayRole(MemberRow row) => string.IsNullOrWhiteSpace(row.Role) ? "Agent" : row.Role!;

    private string DisplayPrompt(MemberRow row)
    {
        if (string.IsNullOrEmpty(row.LlmPromptId))
        {
            return "-";
        }

        return _prompts.FirstOrDefault(p => p.Id == row.LlmPromptId)?.Name ?? row.LlmPromptId;
    }

    private string DisplayConfig(MemberRow row)
    {
        if (string.IsNullOrEmpty(row.LlmConfigId))
        {
            return "-";
        }

        return _configs.FirstOrDefault(c => c.Id == row.LlmConfigId)?.Name ?? row.LlmConfigId;
    }

    private class MemberRow
    {
        public int Order { get; set; }
        public string? Name { get; set; }
        public string? Role { get; set; }
        public string? LlmPromptId { get; set; }
        public string? LlmConfigId { get; set; }
        
        // DAG 配置
        public List<string>? Dependencies { get; set; }
        public string? ParallelGroup { get; set; }
        public int? TimeoutSeconds { get; set; }
        public bool? ContinueOnFailure { get; set; }
    }
}

