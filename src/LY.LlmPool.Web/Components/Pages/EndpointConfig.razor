@page "/endpoint-config"
@using LY.LlmPool.Web.Services
@using LY.LlmPool.Web.Data.Entities
@using AntDesign
@inject EndpointService EndpointService
@inject LlmPoolService LlmPoolService
@inject MessageService _message
@inject NavigationManager NavigationManager

<PageTitle>Endpoint Configuration</PageTitle>

<Card>
    <TitleTemplate>
        <div class="d-flex justify-content-between align-items-center">
            <div>Endpoint Configuration</div>
            <div>
                <Button Type="@ButtonType.Primary" OnClick="AddNewEndpoint">
                    <Icon Type="plus" />
                    Add New Endpoint
                </Button>
            </div>
        </div>
    </TitleTemplate>
    <ChildContent>
        <Table TItem="LlmEndpoint"
        DataSource="@_endpoints"
        Loading="_loading">
            <Column @bind-Field="@context.Name" Title="Name">
                <Space>
                    <SpaceItem>
                        <Icon Type="api" />
                    </SpaceItem>
                    <SpaceItem>
                        @context.Name
                    </SpaceItem>
                </Space>
            </Column>
            <Column @bind-Field="@context.Description" Title="Description" />
            <Column Title="Endpoint" TData="string">
                <div>
                    <div>
                        <Text Type="@TextElementType.Secondary">Base URL:</Text>
                        <Text Copyable CopyConfig="copyableConfig">@($"{_baseUrl}")</Text>
                    </div>
                    <div>
                        <Text Type="@TextElementType.Secondary">Chat:</Text>
                        <Text Copyable CopyConfig="copyableConfig">@($"{_baseUrl}/v1/chat/completions")</Text>
                    </div>
                </div>
            </Column>
            <Column Title="API Key" TData="string">
                <Text Copyable CopyConfig="copyableConfig">@context.Id</Text>
            </Column>
            <Column Title="Models" TData="string">
                @foreach (var config in context.EndpointConfigs.OrderBy(x => x.Priority))
                {
                    <Tag Class="mb-1">@config.LlmConfig?.Name</Tag>
                }
            </Column>
            <Column Title="Status" TData="string">
                <Tag Color="@(context.IsEnabled ? "green" : "red")">
                    @(context.IsEnabled ? "Enabled" : "Disabled")
                </Tag>
            </Column>
            <ActionColumn Title="Action">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="() => EditEndpoint(context)">
                            <Icon Type="edit" />
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="Are you sure to delete this endpoint?"
                        OkText="Yes"
                        CancelText="No"
                        OnConfirm="() => DeleteEndpoint(context)">
                            <Button Danger>
                                <Icon Type="delete" />
                            </Button>
                        </Popconfirm>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    </ChildContent>
</Card>

<Modal Title="@(_editingEndpoint.Id == null ? "Add New Endpoint" : "Edit Endpoint")"
Visible="@_showDialog"
OnOk="SaveEndpoint"
OnCancel="CloseDialog"
Width="800">
    <Form Model="@_editingEndpoint"
    LabelCol="new ColLayoutParam { Span = 8 }"
    WrapperCol="new ColLayoutParam { Span = 16 }">
        <FormItem Label="Name" Required>
            <Input @bind-Value="@_editingEndpoint.Name" />
        </FormItem>
        <FormItem Label="Description">
            <TextArea @bind-Value="@_editingEndpoint.Description" />
        </FormItem>
        <FormItem Label="Enabled">
            <Switch @bind-Value="@_editingEndpoint.IsEnabled" />
        </FormItem>
        <FormItem Label="Models" Required>
            <div class="mb-2">
                <Button Type="@ButtonType.Primary" OnClick="AddModel">
                    <Icon Type="plus" />
                    Add Model
                </Button>
            </div>
            <Table TItem="LlmEndpointConfig"
            DataSource="@_editingEndpoint.EndpointConfigs.OrderBy(x => x.Priority)"
            Size="TableSize.Small"
            Context="configItem"
            Bordered>
                <Column Title="Model" TData="string">
                    <Select TItem="LlmConfig"
                    TItemValue="string"
                    DataSource="@_availableConfigs"
                    @bind-Value="@configItem.LlmConfigId"
                    ValueName="@nameof(LlmConfig.Id)"
                    LabelName="@nameof(LlmConfig.Name)"
                    EnableSearch
                    AutoClearSearchValue="false"
                    Style="width: 100%;">
                        <ItemTemplate Context="item">
                            @item.Name
                        </ItemTemplate>
                    </Select>
                </Column>
                <Column Title="Priority" TData="int">
                    <AntDesign.InputNumber @bind-Value="@configItem.Priority" Min="0" />
                </Column>
                <ActionColumn Title="Action">
                    <Button Danger OnClick="() => RemoveModel(configItem)">
                        <Icon Type="delete" />
                    </Button>
                </ActionColumn>
            </Table>
        </FormItem>
    </Form>
</Modal>

@code {
    private List<LlmEndpoint> _endpoints = new();
    private List<LlmConfig> _availableConfigs = new();
    private bool _showDialog;
    private bool _loading;
    private LlmEndpoint _editingEndpoint = new();
    private TypographyCopyableConfig? copyableConfig;

    private string _baseUrl => NavigationManager.BaseUri.TrimEnd('/');

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        copyableConfig = new() { OnCopy = () => { _message.Success("已复制"); } };
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _endpoints = await EndpointService.GetEndpointsAsync();
            _availableConfigs = await LlmPoolService.GetConfigsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private void AddNewEndpoint()
    {
        _editingEndpoint = new LlmEndpoint();
        _showDialog = true;
    }

    private void EditEndpoint(LlmEndpoint endpoint)
    {
        _editingEndpoint = new LlmEndpoint
        {
            Id = endpoint.Id,
            Name = endpoint.Name,
            Description = endpoint.Description,
            IsEnabled = endpoint.IsEnabled,
            EndpointConfigs = endpoint.EndpointConfigs.ToList()
        };
        _showDialog = true;
    }

    private async Task DeleteEndpoint(LlmEndpoint endpoint)
    {
        await EndpointService.DeleteEndpointAsync(endpoint.Id);
        await LoadDataAsync();
    }

    private async Task SaveEndpoint()
    {
        if (string.IsNullOrWhiteSpace(_editingEndpoint.Name))
        {
            _message.Error("Name is required");
            return;
        }
        if (!_editingEndpoint.EndpointConfigs.Any())
        {
            _message.Error("At least one model is required");
            return;
        }

        if (string.IsNullOrEmpty(_editingEndpoint.Id))
        {
            await EndpointService.AddEndpointAsync(_editingEndpoint);
        }
        else
        {
            await EndpointService.UpdateEndpointAsync(_editingEndpoint);
        }
        _message.Success($"Saved successfully");
        CloseDialog();
        await LoadDataAsync();
    }

    private void CloseDialog()
    {
        _showDialog = false;
        _editingEndpoint = new LlmEndpoint();
    }

    private void AddModel()
    {
        _editingEndpoint.EndpointConfigs.Add(new LlmEndpointConfig
        {
            Priority = _editingEndpoint.EndpointConfigs.Count
        });
    }

    private void RemoveModel(LlmEndpointConfig config)
    {
        _editingEndpoint.EndpointConfigs.Remove(config);
    }
} 