@page "/model-stats"
@using LY.LlmPool.Web.Data.Entities
@using LY.LlmPool.Web.Services
@inject LlmPoolService LlmPoolService
@inject MessageService _message
@inject NavigationManager NavigationManager

<PageTitle>Model Statistics</PageTitle>

<Card>
    <TitleTemplate>
        <div class="d-flex justify-content-between align-items-center">
            <div>Model Statistics</div>
            <div>
                <DatePicker TValue="DateTime?" 
                           Value="@selectedDate"
                           OnChange="OnDateChanged"
                           Picker="DatePickerType.Date"
                           DisabledDate="date => date > DateTime.UtcNow.Date" />
            </div>
        </div>
    </TitleTemplate>
    <ChildContent>
        @if (loading)
        {
            <Spin />
        }
        else if (configs == null || !configs.Any())
        {
            <Empty />
        }
        else
        {
            <Row Gutter="16">
                @foreach (var config in configs)
                {
                    <AntDesign.Col Span="8" Style="margin-bottom: 16px;">
                        <Card Bordered>
                            <TitleTemplate>
                                <Space>
                                    <SpaceItem>
                                        <Icon Type="@(config.ModelType?.Icon ?? "api")" />
                                    </SpaceItem>
                                    <SpaceItem>
                                        @config.Name
                                    </SpaceItem>
                                </Space>
                            </TitleTemplate>
                            <Extra>
                                <Space>
                                    <SpaceItem>
                                        <Button Type="@ButtonType.Link" OnClick="() => ViewModelCalls(config.Id!)">
                                            View Model Calls
                                        </Button>
                                    </SpaceItem>
                                    @foreach (var endpoint in GetEndpointsForModel(config.Id!))
                                    {
                                        <SpaceItem>
                                            <Button Type="@ButtonType.Link" OnClick="() => ViewEndpointCalls(endpoint.Id)">
                                                View @endpoint.Name Calls
                                            </Button>
                                        </SpaceItem>
                                    }
                                </Space>
                            </Extra>
                            <ChildContent>
                                <Statistic Title="Total Calls" Value="@GetCallCount(config.Id!)" />

                                <Divider />

                                <Row>
                                    <AntDesign.Col Span="12">
                                        <Statistic Title="Success Rate" 
                                        Value="@GetSuccessRate(config.Id!)" 
                                        Precision="2"
                                        Suffix="%" 
                                        ValueStyle="@($"color: {GetColorForSuccessRate(config.Id!)}")" />
                                    </AntDesign.Col>
                                    <AntDesign.Col Span="12">
                                        <Statistic Title="Avg. Response Time" 
                                        Value="@GetAvgResponseTime(config.Id!)" 
                                        Precision="2"
                                        Suffix="s" />
                                    </AntDesign.Col>
                                </Row>

                                <Divider />

                                <div class="call-timeline">
                                    @{
                                        var timelineCalls = GetCallsForModel(config.Id!);
                                        var timelineHours = Enumerable.Range(0, 24);
                                    }
                                    <div class="hour-bars">
                                        @foreach (var hour in timelineHours)
                                        {
                                            var hourCalls = timelineCalls.Where(c => c.RequestReceivedAt.Hour == hour).Count();
                                            var maxHourCalls = Math.Max(1, timelineCalls.GroupBy(c => c.RequestReceivedAt.Hour)
                                                                              .Select(g => g.Count())
                                                                              .DefaultIfEmpty(0)
                                                                              .Max());
                                            var heightPercent = hourCalls > 0 ? Math.Max(10, (hourCalls * 100) / maxHourCalls) : 0;
                                            var bgColor = hourCalls > 0 ? "#1890ff" : "#f0f0f0";

                                            <Tooltip Title="@($"{hour}:00 - {hour}:59: {hourCalls} calls")">
                                                <div class="hour-bar" style="height: @(heightPercent)%; background-color: @bgColor;"></div>
                                            </Tooltip>
                                        }
                                    </div>
                                    <div class="hour-labels">
                                        <div>0h</div>
                                        <div>12h</div>
                                        <div>23h</div>
                                    </div>
                                </div>

                                <Divider />

                                @{
                                    var strategyCounts = GetStrategyCountsForModel(config.Id!);
                                    var strategyTotal = strategyCounts.Values.Sum();
                                }
                                <div class="strategy-section">
                                    <div class="strategy-title">策略分布</div>
                                    @if (strategyTotal == 0)
                                    {
                                        <div class="strategy-empty">无数据</div>
                                    }
                                    else
                                    {
                                        @foreach (var kv in strategyCounts.OrderByDescending(x => x.Value))
                                        {
                                            var percent = strategyTotal > 0 ? (kv.Value * 100.0 / strategyTotal) : 0;
                                            var color = GetStrategyColor(kv.Key);
                                            <div class="strategy-row">
                                                <div class="strategy-label">@kv.Key</div>
                                                <Tooltip Title="@($"{kv.Value} / {strategyTotal} ({percent:0.0}%)")">
                                                    <div class="strategy-bar">
                                                        <div class="strategy-bar-fill" style="width:@($"{percent:0.0}%"); background-color:@color;"></div>
                                                    </div>
                                                </Tooltip>
                                                <div class="strategy-val">@percent.ToString("0.0")%</div>
                                            </div>
                                        }
                                    }
                                </div>

                                <Divider />

                                <div class="strategy-trend">
                                    <div class="strategy-title">策略趋势（按小时）</div>
                                    @{
                                        var trendCalls = GetCallsForModel(config.Id!);
                                        var strategies = new[] { "app-config", "app-endpoint-lb", "config-name-direct-acquire", "endpoint-name-lb", "endpoint-id-lb" };
                                        var trendHours = Enumerable.Range(0, 24);
                                    }
                                    <div class="trend-bars">
                                        @foreach (var hour in trendHours)
                                        {
                                            var hourCalls = trendCalls.Where(c => c.RequestReceivedAt.Hour == hour).ToList();
                                            var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                                            foreach (var call in hourCalls)
                                            {
                                                var st = ParseSelectionStrategy(call.ResponseDataJson);
                                                if (string.IsNullOrWhiteSpace(st)) continue;
                                                counts[st] = counts.TryGetValue(st, out var v) ? v + 1 : 1;
                                            }
                                            var trendTotal = counts.Values.Sum();
                                            <div class="trend-bar">
                                                @if (trendTotal == 0)
                                                {
                                                    <div class="trend-seg" style="height: 2px; background-color:#f0f0f0;"></div>
                                                }
                                                else
                                                {
                                                    @foreach (var st in strategies)
                                                    {
                                                        var val = counts.TryGetValue(st, out var v) ? v : 0;
                                                        if (val == 0) { continue; }
                                                        var percent = (val * 100.0 / trendTotal);
                                                        var color = GetStrategyColor(st);
                                                        <Tooltip Title="@($"{hour}:00 - {hour}:59 | {st}: {val} / {trendTotal} ({percent:0.0}%)")">
                                                            <div class="trend-seg" style="height:@($"{percent:0.0}%"); background-color:@color;"></div>
                                                        </Tooltip>
                                                    }
                                                }
                                                <div class="trend-hour">@hour</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </ChildContent>
                        </Card>
                    </AntDesign.Col>
                }
            </Row>
        }
    </ChildContent>
</Card>

<style>
    .call-timeline {
    margin-top: 8px;
    height: 100px;
    }

    .hour-bars {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    height: 80px;
    }

    .hour-bar {
    flex: 1;
    margin: 0 1px;
    border-radius: 2px 2px 0 0;
    transition: all 0.3s;
    cursor: pointer;
    }

    .hour-bar:hover {
    background-color: #40a9ff !important;
    }

    .hour-labels {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #999;
    margin-top: 4px;
    }

    .strategy-section { margin-top: 8px; }
    .strategy-title { font-weight: 500; margin-bottom: 6px; }
    .strategy-empty { color:#999; font-size: 12px; }
    .strategy-row { display:flex; align-items:center; gap:8px; margin: 6px 0; }
    .strategy-label { width: 160px; font-size: 12px; color:#555; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .strategy-bar { flex:1; height: 8px; background:#f0f0f0; border-radius: 4px; overflow:hidden; }
    .strategy-bar-fill { height: 100%; border-radius: 4px; transition: width 0.3s ease; }
    .strategy-val { width: 60px; text-align:right; font-size: 12px; color:#555; }
</style>

@code {
    private List<LlmConfig> configs = new();
    private List<EndpointCallRecord> callRecords = new();
    private bool loading = true;
    private DateTime selectedDate = DateTime.UtcNow.Date;
    private Dictionary<string, int> callCountCache = new();
    private Dictionary<string, double> successRateCache = new();
    private Dictionary<string, double> avgResponseTimeCache = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task OnDateChanged(DateTimeChangedEventArgs<DateTime?> date)
    {
        if (date.Date.HasValue)
        {
            selectedDate = date.Date.Value.Date;
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        
        try
        {
            // Clear caches
            callCountCache.Clear();
            successRateCache.Clear();
            avgResponseTimeCache.Clear();
            
            // Set date range for the selected date
            DateTime startDate = selectedDate.ToUniversalTime();
            DateTime endDate = startDate.AddDays(1);
            
            // Load all data in parallel
            var configsTask = LlmPoolService.GetConfigsAsync();
            var callRecordsTask = LlmPoolService.GetCallRecordsAsync(
                configId: null,
                startDate: startDate,
                endDate: endDate,
                take: null
            );
            
            await Task.WhenAll(configsTask, callRecordsTask);
            
            configs = await configsTask;
            callRecords = await callRecordsTask;
        }
        catch (Exception ex)
        {
            _message.Error($"Error loading model statistics: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }
    
    private List<EndpointCallRecord> GetCallsForModel(string configId)
    {
        return callRecords.Where(c => c.LlmConfigId == configId).ToList();
    }

    private Dictionary<string, int> GetStrategyCountsForModel(string configId)
    {
        var dict = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var c in callRecords.Where(c => c.LlmConfigId == configId))
        {
            var st = ParseSelectionStrategy(c.ResponseDataJson);
            if (string.IsNullOrWhiteSpace(st)) continue;
            dict[st] = dict.TryGetValue(st, out var v) ? v + 1 : 1;
        }
        return dict;
    }
    
    private int GetCallCount(string configId)
    {
        if (!callCountCache.ContainsKey(configId))
        {
            callCountCache[configId] = GetCallsForModel(configId).Count;
        }
        
        return callCountCache[configId];
    }
    
    private double GetSuccessRate(string configId)
    {
        if (!successRateCache.ContainsKey(configId))
        {
            var calls = GetCallsForModel(configId);
            
            if (calls.Count == 0)
            {
                successRateCache[configId] = 0;
            }
            else
            {
                var successCount = calls.Count(c => c.IsSuccessful);
                successRateCache[configId] = ((double)successCount / calls.Count) * 100;
            }
        }
        
        return successRateCache[configId];
    }
    
    private double GetAvgResponseTime(string configId)
    {
        if (!avgResponseTimeCache.ContainsKey(configId))
        {
            var calls = GetCallsForModel(configId)
                .Where(c => c.ModelProcessingTime.HasValue)
                .ToList();
            
            if (calls.Count == 0)
            {
                avgResponseTimeCache[configId] = 0;
            }
            else
            {
                var totalSeconds = calls.Sum(c => c.ModelProcessingTime!.Value.TotalSeconds);
                avgResponseTimeCache[configId] = totalSeconds / calls.Count;
            }
        }
        
        return avgResponseTimeCache[configId];
    }
    
    private string GetColorForSuccessRate(string configId)
    {
        var rate = GetSuccessRate(configId);
        
        if (rate >= 95) return "#52c41a"; // Green
        if (rate >= 80) return "#faad14"; // Amber
        return "#f5222d"; // Red
    }
    
    private List<LlmEndpoint> GetEndpointsForModel(string configId)
    {
        return callRecords
            .Where(c => c.LlmConfigId == configId)
            .Select(c => c.Endpoint)
            .Where(e => e != null)
            .DistinctBy(e => e.Id)
            .ToList();
    }

    private void ViewEndpointCalls(string endpointId)
    {
        NavigationManager.NavigateTo($"/endpoint-calls?endpointId={endpointId}");
    }

    private void ViewModelCalls(string configId)
    {
        NavigationManager.NavigateTo($"/endpoint-calls?configId={configId}");
    }

    private string? ParseSelectionStrategy(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Object &&
                root.TryGetProperty("selection", out var sel) && sel.ValueKind == System.Text.Json.JsonValueKind.Object &&
                sel.TryGetProperty("strategy", out var st) && st.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                return st.GetString();
            }
        }
        catch { }
        return null;
    }

    private string GetStrategyColor(string strategy)
    {
        // 简单配色映射
        return strategy switch
        {
            "app-config" => "#52c41a",
            "app-endpoint-lb" => "#1890ff",
            "config-name-direct-acquire" => "#fa8c16",
            "endpoint-name-lb" => "#722ed1",
            "endpoint-id-lb" => "#eb2f96",
            _ => "#595959"
        };
    }
} 