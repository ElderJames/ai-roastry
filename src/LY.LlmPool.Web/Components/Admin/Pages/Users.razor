@page "/admin/users"
@using Microsoft.AspNetCore.Identity
@using LY.LlmPool.Web.Data
@using LY.LlmPool.Web.Data.Entities
@using AntDesign
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrator")]

<PageTitle>用户管理</PageTitle>

<Card>
    <TitleTemplate>
        <div class="d-flex justify-content-between align-items-center">
            <div>用户管理</div>
            <div>
                <Button Type="@ButtonType.Primary" OnClick="Refresh">刷新</Button>
            </div>
        </div>
    </TitleTemplate>
    <ChildContent>
        <Table TItem="ApplicationUser" DataSource="@_users" Loading="_loading">
            <PropertyColumn Property="c => c.UserName" Title="用户名" />
            <PropertyColumn Property="c => c.Email" Title="邮箱" />
            <Column TData="ApplicationUser" Title="角色">
                @context =>
                {
                    <div>
                        @if (_rolesByUser.TryGetValue(context.Id, out var rl))
                        {
                            foreach (var r in rl)
                            {
                                <Tag Class="mb-1">@r</Tag>
                            }
                        }
                    </div>
                }
            </Column>
            <ActionColumn Title="操作">
                <Space>
                    <SpaceItem>
                        <Button OnClick="() => OpenManageRoles(context)">管理角色</Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="确认删除该用户吗？" OkText="是" CancelText="否" OnConfirm="() => DeleteUser(context)">
                            <Button Danger>删除</Button>
                        </Popconfirm>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    </ChildContent>
</Card>

<Modal Title="管理角色" Visible="@_showRolesModal" OnCancel="CloseManageRoles">
    <div class="mb-3">
        <Input @bind-Value="_roleToAdd" Placeholder="输入角色名并点击加入" />
        <Button OnClick="AddRoleToUser">加入</Button>
    </div>
    <div>
        <h5>当前角色</h5>
        @if (_editingUserId != null && _rolesByUser.TryGetValue(_editingUserId, out var roles))
        {
            foreach (var r in roles)
            {
                <div class="d-flex align-items-center mb-2">
                    <div class="flex-grow-1">@r</div>
                    <Button Danger OnClick="() => RemoveRoleFromUser(r)">移除</Button>
                </div>
            }
        }
    </div>
</Modal>

@code {
    [Inject] private UserManager<ApplicationUser> UserManager { get; set; } = default!;
    [Inject] private RoleManager<IdentityRole> RoleManager { get; set; } = default!;
    [Inject] private MessageService _message { get; set; } = default!;

    private List<ApplicationUser> _users = new();
    private Dictionary<string, List<string>> _rolesByUser = new();
    private bool _loading;

    private bool _showRolesModal;
    private string? _editingUserId;
    private string _roleToAdd = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    private async Task Refresh()
    {
        _loading = true;
        try
        {
            _users = UserManager.Users.ToList();
            _rolesByUser.Clear();
            foreach (var u in _users)
            {
                var roles = await UserManager.GetRolesAsync(u);
                _rolesByUser[u.Id] = roles.ToList();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenManageRoles(ApplicationUser user)
    {
        _editingUserId = user.Id;
        _showRolesModal = true;
    }

    private void CloseManageRoles()
    {
        _roleToAdd = string.Empty;
        _editingUserId = null;
        _showRolesModal = false;
    }

    private async Task AddRoleToUser()
    {
        if (string.IsNullOrWhiteSpace(_roleToAdd) || _editingUserId == null)
        {
            return;
        }

        var user = await UserManager.FindByIdAsync(_editingUserId);
        if (user == null) return;

        if (!await RoleManager.RoleExistsAsync(_roleToAdd))
        {
            await RoleManager.CreateAsync(new IdentityRole(_roleToAdd));
        }

        var result = await UserManager.AddToRoleAsync(user, _roleToAdd);
        if (result.Succeeded)
        {
            await Refresh();
            _message.Success("角色已添加");
        }
        else
        {
            _message.Error("添加角色失败");
        }
    }

    private async Task RemoveRoleFromUser(string role)
    {
        if (_editingUserId == null) return;
        var user = await UserManager.FindByIdAsync(_editingUserId);
        if (user == null) return;
        var result = await UserManager.RemoveFromRoleAsync(user, role);
        if (result.Succeeded)
        {
            await Refresh();
            _message.Success("角色已移除");
        }
        else
        {
            _message.Error("移除角色失败");
        }
    }

    private async Task DeleteUser(ApplicationUser user)
    {
        var result = await UserManager.DeleteAsync(user);
        if (result.Succeeded)
        {
            await Refresh();
            _message.Success("用户已删除");
        }
        else
        {
            _message.Error("删除用户失败");
        }
    }
}
