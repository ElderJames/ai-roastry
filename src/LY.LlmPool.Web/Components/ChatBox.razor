@using LY.LlmPool.Web.Data.Entities
@using LY.LlmPool.Web.Models
@using LY.LlmPool.Web.Services
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Http

@inject ChatClientService ChatClientService
@inject MessageService MessageService
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject IHttpContextAccessor HttpContextAccessor

@if (Config == null && Endpoint == null)
{
    <Alert Message="请选择一个模型或终端点" Type="@AlertType.Warning" ShowIcon="true" />
    return;
}

<Card Style="height: 100%;">
    <Body>
        <div class="chat-container">
            <div class="chat-messages" @ref="_messagesContainer">
                @foreach (var message in _messages)
                {
                    <div class="message @(message.Role == "assistant" ? "message-assistant" : "message-user")">
                        <div class="message-content">
                            @if (message.Role == "assistant" && message.IsStreaming)
                            {
                                if (string.IsNullOrEmpty(message.Content))
                                {
                                    <div class="loading-dots">
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                    </div>
                                }
                                else
                                {
                                    <span class="message-text">@message.Content<span class="cursor-effect"></span></span>
                                }
                            }
                            else
                            {
                                @message.Content
                            }
                        </div>
                        <div class="message-time">
                            @message.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                        </div>
                    </div>
                }
            </div>
            <div class="chat-input">
                <div class="chat-input-info">
                    @if (Config != null)
                    {
                        <Tag Color="TagColor.Blue">模型: @Config.Name</Tag>
                    }
                    @if (Endpoint != null)
                    {
                        <Tag Color="TagColor.Green">终端: @Endpoint.Name</Tag>
                    }
                    <Switch Checked="_useStreaming" CheckedChildren="流式响应" UnCheckedChildren="普通响应" OnChange="@(value => _useStreaming = value)" />
                </div>
                <TextArea @bind-Value="@_currentMessage"
                AutoSize="true"
                OnPressEnter="@(async (e) => { if (!e.ShiftKey) { await SendMessage(); } })"
                Placeholder="输入消息，按Enter发送，Shift+Enter换行"
                Disabled="@_isLoading" />
                <Button Type="@ButtonType.Primary" OnClick="SendMessage" Loading="_isLoading">发送</Button>
            </div>
        </div>
    </Body>
</Card>

@code {
    [Parameter]
    public LlmConfig? Config { get; set; }

    [Parameter]
    public LlmEndpoint? Endpoint { get; set; }

    private List<ChatMessage> _messages = new();
    private string _currentMessage = string.Empty;
    private bool _isLoading;
    private bool _useStreaming = true;
    private ElementReference _messagesContainer;



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_messagesContainer.Context != null)
        {
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(10);
            await JS.InvokeVoidAsync("scrollToBottom", _messagesContainer);
        }
        catch { }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_currentMessage) || _isLoading)
            return;

        var userMessage = new ChatMessage
        {
            Role = "user",
            Content = _currentMessage.Trim()
        };

        _messages.Add(userMessage);
        _currentMessage = string.Empty;
        _isLoading = true;

        try
        {
            StateHasChanged();
            await ScrollToBottom();

            if (_useStreaming)
            {
                await SendStreamingMessage();
            }
            else
            {
                await SendNormalMessage();
            }
        }
        catch (Exception ex)
        {
            MessageService.Error(ex.Message);
            AddErrorMessage(ex.Message);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task SendNormalMessage()
    {
        ChatResponse response;
        if (Config != null)
        {
            response = await ChatClientService.SendMessageAsync(Config, _messages);
        }
        else if (Endpoint != null)
        {
            response = await ChatClientService.SendMessageAsync(Endpoint, _messages);
        }
        else
        {
            throw new Exception("未选择模型或终端点");
        }

        if (response.Status == "error")
        {
            throw new Exception(response.Message);
        }

        AddAssistantMessage(response.Message);
    }

    private async Task SendStreamingMessage()
    {
        var assistantMessage = new ChatMessage
        {
            Role = "assistant",
            Content = "",
            IsStreaming = true,
            Timestamp = DateTime.Now
        };
        _messages.Add(assistantMessage);
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            IAsyncEnumerable<string> streamingResult;
            if (Config != null)
            {
                streamingResult = ChatClientService.SendStreamingMessageAsync(Config, _messages);
            }
            else if (Endpoint != null)
            {
                streamingResult = ChatClientService.SendStreamingMessageAsync(Endpoint, _messages);
            }
            else
            {
                throw new Exception("未选择模型或终端点");
            }

            await foreach (var chunk in streamingResult)
            {
                assistantMessage.Content += chunk;
                StateHasChanged();
                await ScrollToBottom();
            }
        }
        finally
        {
            assistantMessage.IsStreaming = false;
            StateHasChanged();
        }
    }

    private void AddAssistantMessage(string content)
    {
        _messages.Add(new ChatMessage
        {
            Role = "assistant",
            Content = content,
            Timestamp = DateTime.Now
        });
    }

    private void AddErrorMessage(string error)
    {
        _messages.Add(new ChatMessage
        {
            Role = "assistant",
            Content = $"错误: {error}",
            Timestamp = DateTime.Now
        });
    }
}

