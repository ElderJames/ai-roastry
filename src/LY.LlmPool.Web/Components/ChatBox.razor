@using LY.LlmPool.Web.Data.Entities
@using LY.LlmPool.Web.Models
@using LY.LlmPool.Web.Services

@inject ChatClientService ChatClientService
@inject MessageService MessageService
@inject IJSRuntime JS

@if (Config == null && Endpoint == null)
{
    <Alert Message="请选择一个模型或终端点" Type="@AlertType.Warning" ShowIcon="true" />
    return;
}

<Card Style="height: 100%;">
    <Body>
        <div class="chat-container">
            <div class="chat-messages" @ref="_messagesContainer">
                @foreach (var message in _messages)
                {
                    <div class="message @(message.Role == "assistant" ? "message-assistant" : "message-user")">
                        <div class="message-content">
                            @message.Content
                        </div>
                        <div class="message-time">
                            @message.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                        </div>
                    </div>
                }
                @if (_isLoading)
                {
                    <div class="message message-assistant">
                        <Spin />
                    </div>
                }
            </div>
            <div class="chat-input">
                <div class="chat-input-info">
                    @if (Config != null)
                    {
                        <Tag Color="TagColor.Blue">模型: @Config.Name</Tag>
                    }
                    @if (Endpoint != null)
                    {
                        <Tag Color="TagColor.Green">终端: @Endpoint.Name</Tag>
                    }
                </div>
                <TextArea @bind-Value="@_currentMessage"
                    AutoSize="true"
                    OnPressEnter="@(async (e) => { if (!e.ShiftKey) { await SendMessage(); } })"
                    Placeholder="输入消息，按Enter发送，Shift+Enter换行" />
                <Button Type="@ButtonType.Primary" OnClick="SendMessage" Loading="_isLoading">发送</Button>
            </div>
        </div>
    </Body>
</Card>

<style>
    .chat-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        gap: 1rem;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .message {
        max-width: 80%;
        padding: 0.5rem 1rem;
        border-radius: 8px;
    }

    .message-user {
        align-self: flex-end;
        background-color: #1677ff;
        color: white;
    }

    .message-assistant {
        align-self: flex-start;
        background-color: #f0f0f0;
        color: black;
    }

    .message-content {
        white-space: pre-wrap;
        word-break: break-word;
    }

    .message-time {
        font-size: 0.8em;
        opacity: 0.8;
        margin-top: 0.25rem;
    }

    .chat-input {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .chat-input-info {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .chat-input-actions {
        display: flex;
        gap: 0.5rem;
        align-items: flex-start;
    }

    .chat-input :deep(.ant-input-textarea) {
        flex: 1;
    }
</style>

@code {
    [Parameter]
    public LlmConfig? Config { get; set; }

    [Parameter]
    public LlmEndpoint? Endpoint { get; set; }

    private List<ChatMessage> _messages = new();
    private string _currentMessage = string.Empty;
    private bool _isLoading;
    private ElementReference _messagesContainer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_messagesContainer.Context != null)
        {
            await _messagesContainer.FocusAsync();
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollToBottom", _messagesContainer);
        }
        catch { }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_currentMessage) || _isLoading)
            return;

        var userMessage = new ChatMessage
        {
            Role = "user",
            Content = _currentMessage.Trim()
        };

        _messages.Add(userMessage);
        _currentMessage = string.Empty;
        _isLoading = true;

        try
        {
            StateHasChanged();
            await ScrollToBottom();

            var chatMessages = _messages.Select(m => new ChatMessage
            {
                Role = m.Role switch
                {
                    "system" => "system",
                    "assistant" => "assistant",
                    _ => "user"
                },
                Content = m.Content
            }).ToList();

            ChatResponse response;
            if (Config != null)
            {
                response = await ChatClientService.SendMessageAsync(Config, chatMessages);
            }
            else if (Endpoint != null)
            {
                response = await ChatClientService.SendMessageAsync(Endpoint, chatMessages);
            }
            else
            {
                throw new Exception("未选择模型或终端点");
            }

            if (response.Status == "error")
            {
                throw new Exception(response.Message);
            }

            var assistantMessage = new ChatMessage
            {
                Role = "assistant",
                Content = response.GetMessage()
            };

            _messages.Add(assistantMessage);
        }
        catch (Exception ex)
        {
            await MessageService.Error(ex.Message);
            var errorMessage = new ChatMessage
            {
                Role = "assistant",
                Content = $"错误: {ex.Message}"
            };
            _messages.Add(errorMessage);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }
} 