@using LY.LlmPool.Web.Data.Entities
@using LY.LlmPool.Web.Models
@using LY.LlmPool.Web.Services
@using LY.LlmPool.Client
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Http
@using Microsoft.SemanticKernel.ChatCompletion
@using Microsoft.SemanticKernel.Connectors.OpenAI
@using Microsoft.SemanticKernel
@using System.Text
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel
@using System.Text.Json

@inject ChatClientService ChatClientService
@inject IServiceProvider Services
@inject LlmPoolService LlmPoolService
@inject MessageService MessageService
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject IHttpContextAccessor HttpContextAccessor

@if (string.IsNullOrEmpty(ModelName))
{
    <Alert Message="请选择一个模型、终端点或应用" Type="@AlertType.Warning" ShowIcon="true" />
    return;
}
<InputFile hidden id="inputfile" OnChange="OnImageUpload" multiple accept="image/*" />
<Card Style="height: 100%;" BodyStyle="height: 100%;">
    <Body>
        <div class="chat-container" style="display:flex; gap:16px; height:100%;">
            <div class="chat-messages" style="flex:1;" @ref="_messagesContainer">
                @for (var index = 0; index < _messages.Count; index++)
                {
                    var messageIndex = index;
                    var message = _messages[messageIndex];
                    var isAssistant = string.Equals(message.Role, "assistant", StringComparison.OrdinalIgnoreCase);
                    var isStreaming = isAssistant && message.IsStreaming;
                    var segments = ParseMessageSegments(message.Content);

                    <div class="message @(isAssistant ? "message-assistant" : "message-user")">
                        <div class="message-content">
                            @if (isStreaming && string.IsNullOrEmpty(message.Content))
                            {
                                <div class="loading-dots">
                                    <span class="dot"></span>
                                    <span class="dot"></span>
                                    <span class="dot"></span>
                                </div>
                            }
                            else if (message.ContentItems != null && message.ContentItems.Count > 0)
                            {
                                foreach (var item in message.ContentItems)
                                {
                                    if (item is TextContent textContent)
                                    {
                                        var itemSegments = ParseMessageSegments(textContent.Text);
                                        if (itemSegments.HasThinking)
                                        {
                                            var expanded = IsThinkingExpanded(messageIndex);
                                            <div class="thinking-section">
                                                <div class="thinking-header">
                                                    <Tag Color="TagColor.Orange">思维链</Tag>
                                                    <Button Type="ButtonType.Link" Size="ButtonSize.Small" OnClick="@(() => ToggleThinking(messageIndex))">
                                                        @(expanded ? "收起" : "展开")
                                                    </Button>
                                                </div>
                                                @if (expanded)
                                                {
                                                    <pre class="thinking-content">@itemSegments.Thinking</pre>
                                                }
                                            </div>
                                        }

                                        if (!string.IsNullOrEmpty(itemSegments.Visible))
                                        {
                                            <div class="message-text">@itemSegments.Visible</div>
                                        }
                                    }
                                    else if (item is ImageContent imageContent && !string.IsNullOrEmpty(imageContent.Uri?.ToString()))
                                    {
                                        <div class="message-image">
                                            <img src="@imageContent.Uri" alt="用户上传的图片" style="max-width: 300px; max-height: 300px; border-radius: 8px;" />
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                if (segments.HasThinking)
                                {
                                    var expanded = IsThinkingExpanded(messageIndex);
                                    <div class="thinking-section">
                                        <div class="thinking-header">
                                            <Tag Color="TagColor.Orange">思维链</Tag>
                                            <Button Type="ButtonType.Link" Size="ButtonSize.Small" OnClick="@(() => ToggleThinking(messageIndex))">
                                                @(expanded ? "收起" : "展开")
                                            </Button>
                                        </div>
                                        @if (expanded)
                                        {
                                            <pre class="thinking-content">@segments.Thinking</pre>
                                        }
                                    </div>
                                }

                                if (!string.IsNullOrEmpty(segments.Visible))
                                {
                                    <div class="message-text">
                                        @segments.Visible
                                        @if (isStreaming)
                                        {
                                            <span class="cursor-effect"></span>
                                        }
                                    </div>
                                }
                                else if (isStreaming)
                                {
                                    <span class="cursor-effect"></span>
                                }
                            }
                        </div>
                        <div class="message-time">
                            @message.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                        </div>
                    </div>
                }
            </div>
            <div class="chat-input">
                <div class="chat-input-info">
                    @if (!string.IsNullOrEmpty(ModelName))
                    {
                        <Tag Color="TagColor.Blue">model Name: @ModelName</Tag>
                    }
                    <Switch Checked="_useStreaming" CheckedChildren="流式响应" UnCheckedChildren="普通响应" OnChange="@(value => _useStreaming = value)" />
                    <Switch Checked="_useAnthropicApi" CheckedChildren="Anthropic API" UnCheckedChildren="直接调用" OnChange="@(value => _useAnthropicApi = value)" />
                    <Switch Checked="_simulateTools" CheckedChildren="模拟工具调用" UnCheckedChildren="无工具" OnChange="@(value => _simulateTools = value)" />
                </div>
                
                <!-- 图片预览区域 -->
                @if (_selectedImages.Count > 0)
                {
                    <div class="image-preview-container">
                        @foreach (var image in _selectedImages)
                        {
                            <div class="image-preview-item">
                                <img src="@image.DataUrl" alt="@image.FileName" />
                                <Button Size="@ButtonSize.Small" Icon="close" OnClick="@(() => RemoveImage(image))" />
                                <span class="image-name">@image.FileName</span>
                            </div>
                        }
                    </div>
                }
                
                @if (_appParameters.Count > 0)
                {
                    <Collapse DefaultActiveKey="@(new[] { "1" })"  Animation>
                        <Panel Header="参数设置" Key="1">
                            @foreach (var param in _appParameters)
                            {
                                <div style="margin-bottom: 8px;display: flex; align-items: center;">
                                    <Text Strong="true" style="margin-right: 8px;">@param.Key:</Text>
                                    <TextArea Rows=1 AutoSize=true @bind-Value="@param.Value" Placeholder="@($"请输入{param.Key}的值")" style="flex: 1;" />
                                </div>
                            }
                        </Panel>
                    </Collapse>
                }
                
                <div class="chat-input-row">
                    <Upload Name="images" 
                            Multiple="true" 
                            Accept="image/*"
                            ShowUploadList="false"
                            BeforeUpload="@OnBeforeUpload">
                        <label for="inputfile" class="upload-label">
                            选择图片
                        </label>
                    </Upload>
                    
                    <TextArea @bind-Value="@_currentMessage"
                            AutoSize="true"
                            OnPressEnter="@(async (e) => { if (!e.ShiftKey) { await SendMessage(); } })"
                            Placeholder="输入消息，按Enter发送，Shift+Enter换行"
                            Disabled="@_isLoading"
                            Style="flex: 1; margin: 0 8px;" />
                    
                    <Button Type="@ButtonType.Primary" OnClick="SendMessage" Loading="_isLoading">发送</Button>
                </div>
            </div>

            <!-- 工具调用过程面板 -->
            <div class="tool-calls-panel" style="width:320px; min-width:280px; max-height:100%; display:flex; flex-direction:column;">
                <Card Title="工具调用" Size="CardSize.Small" Style="flex:1; overflow:auto;">
                    <Body>
                        @if (_toolEvents.Count == 0)
                        {
                            <Empty Description="@("无工具调用")" />
                        }
                        else
                        {
                            <Space Direction="SpaceDirection.Vertical" Size="SpaceSize.Small" Style="width:100%">
                                @foreach (var ev in _toolEvents)
                                {
                                    <Card Size="CardSize.Small" Hoverable>
                                        <Body>
                                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                                <span style="font-weight:600;">@ev.Name</span>
                                                <Tag>@ev.Time.ToLocalTime().ToString("HH:mm:ss")</Tag>
                                            </div>
                                            <div style="margin-top:6px;">
                                                <Text Type="TextElementType.Secondary">参数</Text>
                                                <pre style="white-space:pre-wrap; word-break:break-word; background:#fafafa; padding:6px; border-radius:4px;">@ev.Arguments</pre>
                                            </div>
                                            <div style="margin-top:6px;">
                                                <Text Type="TextElementType.Secondary">结果</Text>
                                                @if (string.IsNullOrEmpty(ev.Result))
                                                {
                                                    <div style="display:flex; align-items:center; gap:6px;">
                                                        <Spin Size="SpinSize.Small" />
                                                        <span>等待结果…</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <pre style="white-space:pre-wrap; word-break:break-word; background:#f6ffed; padding:6px; border-radius:4px;">@ev.Result</pre>
                                                }
                                            </div>
                                        </Body>
                                    </Card>
                                }
                            </Space>
                        }
                    </Body>
                    <Extra>
                        <Space>
                            <Button Size="ButtonSize.Small" OnClick="@(() => _toolEvents.Clear())">清空</Button>
                        </Space>
                    </Extra>
                </Card>
            </div>
        </div>
    </Body>
</Card>

@code {
    [Parameter]
    public string? ModelName { get; set; }

    [Parameter]
    public string? SystemPrompt { get; set; } = string.Empty;

    [Parameter]
    public string[]? Parameters { get; set; }

    private List<ChatMessage> _messages = new();
    private string _currentMessage = string.Empty;
    private bool _isLoading;
    private bool _useStreaming = true;
    private bool _useAnthropicApi = false;
    private bool _simulateTools = false;
    private HashSet<int> _expandedThinking = new();
    private ElementReference _messagesContainer;
    private List<SelectedImage> _selectedImages = new();
    private List<AppParameter> _appParameters = new();
    private List<ToolCallView> _toolEvents = new();

    private class ToolCallView
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Arguments { get; set; } = string.Empty;
        public string? Result { get; set; }
        public DateTime Time { get; set; } = DateTime.Now;
    }

    private sealed class MessageSegments
    {
        public string Thinking { get; set; } = string.Empty;
        public string Visible { get; set; } = string.Empty;
        public bool HasThinking => !string.IsNullOrWhiteSpace(Thinking);
    }

    private MessageSegments ParseMessageSegments(string? content)
    {
        if (string.IsNullOrEmpty(content))
        {
            return new MessageSegments { Visible = string.Empty };
        }

        const string startTag = "<think>";
        const string endTag = "</think>";

        var text = content;
        var startIdx = text.IndexOf(startTag, StringComparison.OrdinalIgnoreCase);
        var endIdx = text.IndexOf(endTag, StringComparison.OrdinalIgnoreCase);

        string thinking = string.Empty;
        string visible;

        if (startIdx >= 0 && endIdx > startIdx)
        {
            var before = text.Substring(0, startIdx);
            var start = startIdx + startTag.Length;
            thinking = text.Substring(start, endIdx - start);
            visible = before + text.Substring(endIdx + endTag.Length);
        }
        else if (startIdx >= 0 && (endIdx == -1 || endIdx < startIdx))
        {
            var before = text.Substring(0, startIdx);
            var start = startIdx + startTag.Length;
            thinking = text.Substring(start);
            visible = before;
        }
        else if (startIdx == -1 && endIdx >= 0)
        {
            thinking = text.Substring(0, endIdx);
            visible = text.Substring(endIdx + endTag.Length);
        }
        else
        {
            visible = text;
        }

        thinking = thinking
            .Replace(startTag, string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace(endTag, string.Empty, StringComparison.OrdinalIgnoreCase)
            .Trim('\r', '\n');

        visible = visible
            .Replace(startTag, string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace(endTag, string.Empty, StringComparison.OrdinalIgnoreCase)
            .TrimStart('\r', '\n');

        return new MessageSegments
        {
            Thinking = thinking,
            Visible = visible
        };
    }

    private bool IsThinkingExpanded(int index) => _expandedThinking.Contains(index);

    private void ToggleThinking(int index)
    {
        if (_expandedThinking.Contains(index))
        {
            _expandedThinking.Remove(index);
        }
        else
        {
            _expandedThinking.Add(index);
        }

        InvokeAsync(StateHasChanged);
    }


    public class SelectedImage
    {
        public string FileName { get; set; } = string.Empty;
        public string DataUrl { get; set; } = string.Empty;
        public byte[] Data { get; set; } = Array.Empty<byte>();
        public string MimeType { get; set; } = string.Empty;
    }

    public class AppParameter
    {
        public string Key { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Parameters?.Any() == true)
        {
            _appParameters = Parameters.Length > 0
                ? Parameters.Select(p => new AppParameter { Key = p, Value = string.Empty }).ToList()
				: new List<AppParameter>();
        }
        else if (_appParameters.Count > 0)
        {
            _appParameters.Clear();
        }
    }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(SystemPrompt))
        {
            _messages.Add(new ChatMessage
            {
                Role = "system",
                Content = SystemPrompt,
                Timestamp = DateTime.Now
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_messagesContainer.Context != null)
        {
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(10);
            await JS.InvokeVoidAsync("scrollToBottom", _messagesContainer);
        }
        catch { }
    }

    private async Task SendMessage()
    {
        if ((string.IsNullOrWhiteSpace(_currentMessage) && _selectedImages.Count == 0) || _isLoading)
            return;

        var userMessage = new ChatMessage
        {
            Role = "user",
            Timestamp = DateTime.Now
        };

        // 如果有图片，创建多媒体内容
        if (_selectedImages.Count > 0)
        {
            var contentItems = new ChatMessageContentItemCollection();

            // 添加文本内容（如果有）
            if (!string.IsNullOrWhiteSpace(_currentMessage))
            {
                contentItems.Add(new TextContent(_currentMessage.Trim()));
            }

            // 添加图片内容
            foreach (var image in _selectedImages)
            {
                contentItems.Add(new ImageContent(image.Data, image.MimeType));
            }

            userMessage.ContentItems = contentItems;
            // 不设置 Content 属性，避免冲突
        }
        else
        {
            // 只有文本时，使用传统的 Content 属性
            userMessage.Content = _currentMessage.Trim();
        }

        _messages.Add(userMessage);

        // 不再在组件内注入 tools，仅在调用服务时传入包含 KernelFunction 的对象
        _currentMessage = string.Empty;
        _selectedImages.Clear();
        _isLoading = true;
        _toolEvents.Clear();

        try
        {
            StateHasChanged();
            await ScrollToBottom();

            if (_useStreaming)
            {
                await SendStreamingMessage();
            }
            else
            {
                await SendNormalMessage();
            }
        }
        catch (Exception ex)
        {
            MessageService.Error(ex.Message);
            AddErrorMessage(ex.Message);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task SendNormalMessage()
    {
        ChatResponse response;
        var toolObjects = _simulateTools ? new object[] { this } : Array.Empty<object>();

        var model = ModelName;
        if (string.IsNullOrEmpty(model)) throw new Exception("未选择模型、终端点或应用");

        var http = HttpClientFactory.CreateClient("LlmPoolApi");
        var client = new LY.LlmPool.Client.LlmPoolClient(http, "kk");
        var msgs = _messages.Select(m => new LY.LlmPool.Client.ClientMessage
            {
                Role = m.Role,
                Content = m.Content,
                ContentItems = m.ContentItems
            }).ToList();
        var parms = _appParameters.Any(p => !string.IsNullOrEmpty(p.Value))
             ? _appParameters.Where(p => !string.IsNullOrEmpty(p.Value)).ToDictionary(p => p.Key, p => (object)p.Value)
             : null;
        var chatOptions = new LY.LlmPool.Client.ChatOptions
            {
                Temperature = 0.7,
                MaxTokens = 10000,
                TopP = null
            };

        var text = await client.ChatAsync(model!, msgs, parms, toolObjects, chatOptions);
        AddAssistantMessage(text);
    }

    private async Task SendStreamingMessage()
    {
        var assistantMessage = new ChatMessage
        {
            Role = "assistant",
            Content = "",
            IsStreaming = true,
            Timestamp = DateTime.Now
        };
        
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            IAsyncEnumerable<string> streamingResult;
            var toolObjects = _simulateTools ? new object[] { this } : Array.Empty<object>();
            var model = ModelName;
            if (string.IsNullOrEmpty(model)) throw new Exception("未选择模型、终端点或应用");

            var http = HttpClientFactory.CreateClient("LlmPoolApi");
            var client = new LY.LlmPool.Client.LlmPoolClient(http, "xx");
            var msgs = _messages.Select(m => new LY.LlmPool.Client.ClientMessage
            {
                Role = m.Role,
                Content = m.Content,
                ContentItems = m.ContentItems
            }).ToList();

            var chatOptions = new LY.LlmPool.Client.ChatOptions
            {
                Temperature = 0.7,
                MaxTokens = 10000,
                TopP = null
            };
            var parms = _appParameters.Any(p => !string.IsNullOrEmpty(p.Value))
                  ? _appParameters.Where(p => !string.IsNullOrEmpty(p.Value)).ToDictionary(p => p.Key, p => (object)p.Value)
                  : null;
            var stream = client.ChatStreamAsync(model!, msgs, parms, toolObjects, chatOptions);
            _messages.Add(assistantMessage);
            await foreach (var chunk in stream)
            {
                if (!string.IsNullOrEmpty(chunk.Content))
                {
                    assistantMessage.Content += chunk.Content;
                }
                StateHasChanged();
                await ScrollToBottom();
            }
        }
        finally
        {
            assistantMessage.IsStreaming = false;
            StateHasChanged();
        }
    }

        

    private void AddAssistantMessage(string content)
    {
        _messages.Add(new ChatMessage
        {
            Role = "assistant",
            Content = content,
            Timestamp = DateTime.Now
        });
    }

    private void AddErrorMessage(string error)
    {
        _messages.Add(new ChatMessage
        {
            Role = "assistant",
            Content = $"错误: {error}",
            Timestamp = DateTime.Now
        });
    }

    // 图片处理方法
    private bool OnBeforeUpload(UploadFileItem file)
    {
        // 限制图片大小 (5MB)
        if (file.Size > 5 * 1024 * 1024)
        {
            MessageService.Error($"图片 {file.FileName} 超过5MB限制");
            return false;
        }

        // 限制图片数量
        if (_selectedImages.Count >= 5)
        {
            MessageService.Error("最多只能上传5张图片");
            return false;
        }

        return true;
    }

    private async Task OnImageUpload(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            try
            {
                // 限制文件大小 (10MB)
                if (file.Size > 10 * 1024 * 1024)
                {
                    MessageService.Warning($"文件 {file.Name} 太大，请选择小于 10MB 的图片");
                    continue;
                }

                // 使用 Stream 读取文件内容
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                var buffer = new byte[stream.Length];
                await stream.ReadAsync(buffer, 0, (int)stream.Length);
                
                var base64String = Convert.ToBase64String(buffer);
                var dataUrl = $"data:{file.ContentType};base64,{base64String}";
                
                var selectedImage = new SelectedImage
                {
                    FileName = file.Name,
                    DataUrl = dataUrl,
                    Data = buffer,
                    MimeType = file.ContentType
                };

                _selectedImages.Add(selectedImage);
            }
            catch (Exception ex)
            {
                MessageService.Error($"图片上传失败: {ex.Message}");
            }
        }
        StateHasChanged();
    }

    private void RemoveImage(SelectedImage image)
    {
        _selectedImages.Remove(image);
        StateHasChanged();
    }

    // 示例工具方法：在模拟工具调用时，会通过 ChatClientService 注册为 Kernel 插件
    [KernelFunction("echo")]
    [Description("回显输入的文本")]
    public string Echo([Description("要回显的内容")] string text)
    {
        return text;
    }

    [KernelFunction("get_time")]
    [Description("返回当前时间，可选格式化")]
    public string GetTime([Description(".NET 日期时间格式化字符串")] string? format = "yyyy-MM-dd HH:mm:ss")
    {
        var fmt = string.IsNullOrWhiteSpace(format) ? "yyyy-MM-dd HH:mm:ss" : format;
        return DateTime.Now.ToString(fmt);
    }

    [KernelFunction("sum")]
    [Description("计算两个整数的和")]
    public int Sum(
        [Description("加数 A")] int a = 0,
        [Description("加数 B")] int b = 0)
    {
        return a + b;
    }
}

