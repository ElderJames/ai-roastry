@using LY.LlmPool.Web.Data.Entities
@using LY.LlmPool.Web.Models
@using LY.LlmPool.Web.Services
@using LY.LlmPool.Client
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Http
@using Microsoft.SemanticKernel.ChatCompletion
@using Microsoft.SemanticKernel.Connectors.OpenAI
@using Microsoft.SemanticKernel
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel
@using System.Text.Json

@inject ChatClientService ChatClientService
@inject IServiceProvider Services
@inject LlmPoolService LlmPoolService
@inject MessageService MessageService
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject IHttpContextAccessor HttpContextAccessor

@if (Config == null && Endpoint == null && App == null)
{
    <Alert Message="请选择一个模型、终端点或应用" Type="@AlertType.Warning" ShowIcon="true" />
    return;
}
<InputFile hidden id="inputfile" OnChange="OnImageUpload" multiple accept="image/*" />
<Card Style="height: 100%;">
    <Body>
        <div class="chat-container">
            <div class="chat-messages" @ref="_messagesContainer">
                @foreach (var message in _messages)
                {
                    <div class="message @(message.Role == "assistant" ? "message-assistant" : "message-user")">
                        <div class="message-content">
                            @if (message.Role == "assistant" && message.IsStreaming)
                            {
                                if (string.IsNullOrEmpty(message.Content))
                                {
                                    <div class="loading-dots">
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                    </div>
                                }
                                else
                                {
                                    <span class="message-text">@message.Content<span class="cursor-effect"></span></span>
                                }
                            }
                            else
                            {
                                @if (message.ContentItems != null && message.ContentItems.Count > 0)
                                {
                                    @foreach (var item in message.ContentItems)
                                    {
                                        @if (item is TextContent textContent)
                                        {
                                            <div class="message-text">@textContent.Text</div>
                                        }
                                        else if (item is ImageContent imageContent && !string.IsNullOrEmpty(imageContent.Uri?.ToString()))
                                        {
                                            <div class="message-image">
                                                <img src="@imageContent.Uri" alt="用户上传的图片" style="max-width: 300px; max-height: 300px; border-radius: 8px;" />
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    @message.Content
                                }
                            }
                        </div>
                        <div class="message-time">
                            @message.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                        </div>
                    </div>
                }
            </div>
            <div class="chat-input">
                <div class="chat-input-info">
                    @if (Config != null)
                    {
                        <Tag Color="TagColor.Blue">模型: @Config.Name</Tag>
                    }
                    @if (Endpoint != null)
                    {
                        <Tag Color="TagColor.Green">终端: @Endpoint.Name</Tag>
                    }
                    <Switch Checked="_useStreaming" CheckedChildren="流式响应" UnCheckedChildren="普通响应" OnChange="@(value => _useStreaming = value)" />
                    <Switch Checked="_useAnthropicApi" CheckedChildren="Anthropic API" UnCheckedChildren="直接调用" OnChange="@(value => _useAnthropicApi = value)" />
                    <Switch Checked="_simulateTools" CheckedChildren="模拟工具调用" UnCheckedChildren="无工具" OnChange="@(value => _simulateTools = value)" />
                </div>
                
                <!-- 图片预览区域 -->
                @if (_selectedImages.Count > 0)
                {
                    <div class="image-preview-container">
                        @foreach (var image in _selectedImages)
                        {
                            <div class="image-preview-item">
                                <img src="@image.DataUrl" alt="@image.FileName" />
                                <Button Size="@ButtonSize.Small" Icon="close" OnClick="@(() => RemoveImage(image))" />
                                <span class="image-name">@image.FileName</span>
                            </div>
                        }
                    </div>
                }
                
                @if (App != null && _appParameters.Count > 0)
                {
                    <div class="parameters-input" style="margin-bottom: 16px; border: 1px solid #d9d9d9; border-radius: 6px; padding: 12px;">
                        <div style="margin-bottom: 8px; font-weight: 500;">参数设置</div>
                        @foreach (var param in _appParameters)
                        {
                            <div style="margin-bottom: 8px;">
                                <Text Strong="true" style="margin-right: 8px;">@param.Key:</Text>
                                <Input @bind-Value="@param.Value" Placeholder="@($"请输入{param.Key}的值")" Style="width: 200px;" />
                            </div>
                        }
                    </div>
                }
                
                <div class="chat-input-row">
                    <Upload Name="images" 
                            Multiple="true" 
                            Accept="image/*"
                            ShowUploadList="false"
                            BeforeUpload="@OnBeforeUpload">
                        <label for="inputfile" class="upload-label">
                            选择图片
                        </label>
                    </Upload>
                    
                    <TextArea @bind-Value="@_currentMessage"
                            AutoSize="true"
                            OnPressEnter="@(async (e) => { if (!e.ShiftKey) { await SendMessage(); } })"
                            Placeholder="输入消息，按Enter发送，Shift+Enter换行"
                            Disabled="@_isLoading"
                            Style="flex: 1; margin: 0 8px;" />
                    
                    <Button Type="@ButtonType.Primary" OnClick="SendMessage" Loading="_isLoading">发送</Button>
                </div>
            </div>
        </div>
    </Body>
</Card>

@code {
    [Parameter]
    public LlmConfig? Config { get; set; }

    [Parameter]
    public LlmEndpoint? Endpoint { get; set; }

    [Parameter]
    public LlmApp? App { get; set; }

    [Parameter]
    public string? SystemPrompt { get; set; }

    private List<ChatMessage> _messages = new();
    private string _currentMessage = string.Empty;
    private bool _isLoading;
    private bool _useStreaming = true;
    private bool _useAnthropicApi = false;
    private bool _simulateTools = false;
    private ElementReference _messagesContainer;
    private List<SelectedImage> _selectedImages = new();
    private List<AppParameter> _appParameters = new();
    
    private List<Tool> BuildSimulatedTools()
    {
        var tools = new List<Tool>();
        if (!_simulateTools) return tools;

        tools.Add(new Tool
        {
            Name = "echo",
            Description = "回显输入的文本",
            InputSchema = new Dictionary<string, object>
            {
                ["type"] = "object",
                ["properties"] = new Dictionary<string, object>
                {
                    ["text"] = new Dictionary<string, object>
                    {
                        ["type"] = "string",
                        ["description"] = "要回显的内容"
                    }
                },
                ["required"] = new[] { "text" }
            }
        });

        tools.Add(new Tool
        {
            Name = "get_time",
            Description = "返回当前时间，可选格式化",
            InputSchema = new Dictionary<string, object>
            {
                ["type"] = "object",
                ["properties"] = new Dictionary<string, object>
                {
                    ["format"] = new Dictionary<string, object>
                    {
                        ["type"] = "string",
                        ["description"] = ".NET 日期时间格式化字符串"
                    }
                }
            }
        });

        tools.Add(new Tool
        {
            Name = "sum",
            Description = "计算两个整数的和",
            InputSchema = new Dictionary<string, object>
            {
                ["type"] = "object",
                ["properties"] = new Dictionary<string, object>
                {
                    ["a"] = new Dictionary<string, object>
                    {
                        ["type"] = "integer",
                        ["description"] = "加数 A"
                    },
                    ["b"] = new Dictionary<string, object>
                    {
                        ["type"] = "integer",
                        ["description"] = "加数 B"
                    }
                },
                ["required"] = new[] { "a", "b" }
            }
        });

        return tools;
    }

    public class SelectedImage
    {
        public string FileName { get; set; } = string.Empty;
        public string DataUrl { get; set; } = string.Empty;
        public byte[] Data { get; set; } = Array.Empty<byte>();
        public string MimeType { get; set; } = string.Empty;
    }

    public class AppParameter
    {
        public string Key { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (App != null && !string.IsNullOrEmpty(App.PromptId))
        {
            await LoadAppParameters();
        }
    }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(SystemPrompt))
        {
            _messages.Add(new ChatMessage
            {
                Role = "system",
                Content = SystemPrompt,
                Timestamp = DateTime.Now
            });
        }
    }

    private async Task LoadAppParameters()
    {
        try
        {
            var prompt = await LlmPoolService.GetPromptByIdAsync(App!.PromptId!);
            if (prompt != null)
            {
                // 使用PromptParameterService提取参数
                var promptParameterService = new PromptParameterService();
                var paramNames = promptParameterService.ExtractParameterNames(prompt.Content);

                _appParameters.Clear();
                foreach (var paramName in paramNames)
                {
                    _appParameters.Add(new AppParameter 
                    { 
                        Key = paramName, 
                        Value = string.Empty 
                    });
                }

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            MessageService.Error($"加载应用参数失败: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_messagesContainer.Context != null)
        {
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(10);
            await JS.InvokeVoidAsync("scrollToBottom", _messagesContainer);
        }
        catch { }
    }

    private async Task SendMessage()
    {
        if ((string.IsNullOrWhiteSpace(_currentMessage) && _selectedImages.Count == 0) || _isLoading)
            return;

        var userMessage = new ChatMessage
        {
            Role = "user",
            Timestamp = DateTime.Now
        };

        // 如果有图片，创建多媒体内容
        if (_selectedImages.Count > 0)
        {
            var contentItems = new ChatMessageContentItemCollection();

            // 添加文本内容（如果有）
            if (!string.IsNullOrWhiteSpace(_currentMessage))
            {
                contentItems.Add(new TextContent(_currentMessage.Trim()));
            }

            // 添加图片内容
            foreach (var image in _selectedImages)
            {
                contentItems.Add(new ImageContent(image.Data, image.MimeType));
            }

            userMessage.ContentItems = contentItems;
            // 不设置 Content 属性，避免冲突
        }
        else
        {
            // 只有文本时，使用传统的 Content 属性
            userMessage.Content = _currentMessage.Trim();
        }

        _messages.Add(userMessage);

        // 不再在组件内注入 tools，仅在调用服务时传入包含 KernelFunction 的对象
        _currentMessage = string.Empty;
        _selectedImages.Clear();
        _isLoading = true;

        try
        {
            StateHasChanged();
            await ScrollToBottom();

            if (_useAnthropicApi)
            {
                await SendAnthropicApiMessage();
            }
            else
            {
                if (_useStreaming)
                {
                    await SendStreamingMessage();
                }
                else
                {
                    await SendNormalMessage();
                }
            }
        }
        catch (Exception ex)
        {
            MessageService.Error(ex.Message);
            AddErrorMessage(ex.Message);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task SendNormalMessage()
    {
        ChatResponse response;
        var toolObjects = _simulateTools ? new object[] { this } : Array.Empty<object>();
        if (_useAnthropicApi)
        {
            // 保持 Anthropic 走原服务
            if (Config != null)
            {
                response = await ChatClientService.SendMessageAsync(Config, _messages, toolObjects);
            }
            else if (Endpoint != null)
            {
                response = await ChatClientService.SendMessageAsync(Endpoint, _messages, toolObjects);
            }
            else if (App != null)
            {
                var parameters = _appParameters.Any(p => !string.IsNullOrEmpty(p.Value)) 
                    ? _appParameters.Where(p => !string.IsNullOrEmpty(p.Value))
                                  .ToDictionary(p => p.Key, p => (object)p.Value)
                    : null;
                response = await ChatClientService.SendMessageAsyncByAppName(App.Name, _messages, parameters, toolObjects);
            }
            else
            {
                throw new Exception("未选择模型、终端点或应用");
            }

            if (response.Status == "error") throw new Exception(response.Message);
            AddAssistantMessage(response.Message);
            return;
        }

        // App 流程：使用客户端 SDK 的 ChatAppAsync，可靠透传 parameters
        var baseUrl = HttpContextAccessor.HttpContext != null
            ? $"{HttpContextAccessor.HttpContext.Request.Scheme}://{HttpContextAccessor.HttpContext.Request.Host}/v1"
            : string.Empty;
        var isApp = App != null;
        var apiKey = isApp
            ? "app-temp-key"
            : (Config != null ? (Config.Id ?? Config.ApiKey) : (Endpoint?.Id)) ?? "app-temp-key";
    var model = isApp ? App!.Name : (Config?.Name ?? Endpoint?.Name);
        if (string.IsNullOrEmpty(model)) throw new Exception("未选择模型、终端点或应用");

        if (isApp)
        {
            var parms = _appParameters.Any(p => !string.IsNullOrEmpty(p.Value))
                ? _appParameters.Where(p => !string.IsNullOrEmpty(p.Value)).ToDictionary(p => p.Key, p => (object)p.Value)
                : null;
            var client = new LY.LlmPool.Client.LlmPoolClient(baseUrl, apiKey);
            var msgs = _messages.Select(m => new LY.LlmPool.Client.ClientMessage
            {
                Role = m.Role,
                Content = m.Content,
                ContentItems = m.ContentItems
            }).ToList();
            var clientTools = _simulateTools
                ? BuildSimulatedTools().Select(t => new LY.LlmPool.Client.ClientTool
                {
                    Name = t.Name,
                    Description = t.Description,
                    InputSchema = t.InputSchema
                }).ToList()
                : null;
            var toolChoice = _simulateTools ? new Dictionary<string, object> { ["type"] = "auto" } : null;
            var settings = new OpenAIPromptExecutionSettings();
            if (Config != null)
            {
                settings.Temperature = Config.Temperature;
                settings.MaxTokens = Config.MaxTokens;
            }
            var text = await client.ChatAppAsync(model!, msgs, parms, clientTools, toolChoice, settings);
            AddAssistantMessage(text);
        }
        else
        {
            // 非 App：改为使用 LlmPoolClient（经 SK 调用 openai controller）
            var client = new LY.LlmPool.Client.LlmPoolClient(baseUrl, apiKey);
            var toolObjects2 = _simulateTools ? new object[] { this } : Array.Empty<object>();
            var msgs = _messages.Select(m => new LY.LlmPool.Client.ClientMessage
            {
                Role = m.Role,
                Content = m.Content,
                ContentItems = m.ContentItems
            }).ToList();

            var chatOptions = new LY.LlmPool.Client.ChatOptions
            {
                Temperature = Config?.Temperature,
                MaxTokens = Config?.MaxTokens,
                TopP = null
            };

            var text = await client.ChatAsync(model!, msgs, null, toolObjects2, chatOptions);
            AddAssistantMessage(text);
        }
    }

    private async Task SendStreamingMessage()
    {
        var assistantMessage = new ChatMessage
        {
            Role = "assistant",
            Content = "",
            IsStreaming = true,
            Timestamp = DateTime.Now
        };
        _messages.Add(assistantMessage);
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            IAsyncEnumerable<string> streamingResult;
            var toolObjects = _simulateTools ? new object[] { this } : Array.Empty<object>();
            if (_useAnthropicApi)
            {
                if (Config != null)
                {
                    streamingResult = ChatClientService.SendStreamingMessageAsync(Config, _messages, toolObjects);
                }
                else if (Endpoint != null)
                {
                    streamingResult = ChatClientService.SendStreamingMessageAsync(Endpoint, _messages, toolObjects);
                }
                else if (App != null)
                {
                    var parameters = _appParameters.Any(p => !string.IsNullOrEmpty(p.Value))
                        ? _appParameters.Where(p => !string.IsNullOrEmpty(p.Value)).ToDictionary(p => p.Key, p => (object)p.Value)
                        : null;
                    streamingResult = ChatClientService.SendStreamingMessageAsyncByAppName(App.Name, _messages, parameters, toolObjects);
                }
                else
                {
                    throw new Exception("未选择模型、终端点或应用");
                }
            }
            else
            {
                var isApp = App != null;
                var originBase = HttpContextAccessor.HttpContext != null
                    ? $"{HttpContextAccessor.HttpContext.Request.Scheme}://{HttpContextAccessor.HttpContext.Request.Host}/v1"
                    : string.Empty;
                var apiKey = isApp
                    ? "app-temp-key"
                    : (Config != null ? (Config.Id ?? Config.ApiKey) : (Endpoint?.Id)) ?? "app-temp-key";
                var model = isApp ? App!.Name : (Config?.Name ?? Endpoint?.Name);
                if (string.IsNullOrEmpty(model)) throw new Exception("未选择模型、终端点或应用");

                if (isApp)
                {
                    var parms = _appParameters.Any(p => !string.IsNullOrEmpty(p.Value))
                        ? _appParameters.Where(p => !string.IsNullOrEmpty(p.Value)).ToDictionary(p => p.Key, p => (object)p.Value)
                        : null;
                    var client = new LY.LlmPool.Client.LlmPoolClient(originBase, apiKey);
                    var msgs = _messages.Select(m => new LY.LlmPool.Client.ClientMessage
                    {
                        Role = m.Role,
                        Content = m.Content,
                        ContentItems = m.ContentItems
                    }).ToList();
                    var clientTools = _simulateTools
                        ? BuildSimulatedTools().Select(t => new LY.LlmPool.Client.ClientTool
                        {
                            Name = t.Name,
                            Description = t.Description,
                            InputSchema = t.InputSchema
                        }).ToList()
                        : null;
                    var toolChoice = _simulateTools ? new Dictionary<string, object> { ["type"] = "auto" } : null;
                    var settings = new OpenAIPromptExecutionSettings();
                    if (Config != null)
                    {
                        settings.Temperature = Config.Temperature;
                        settings.MaxTokens = Config.MaxTokens;
                    }
                    streamingResult = client.ChatAppStreamAsync(model!, msgs, parms, clientTools, toolChoice, settings);
                }
                else
                {
                    // 非 App：使用 LlmPoolClient 进行流式（经 SK）
                    var client = new LY.LlmPool.Client.LlmPoolClient(originBase, apiKey);
                    var toolObjects2 = _simulateTools ? new object[] { this } : Array.Empty<object>();
                    var msgs = _messages.Select(m => new LY.LlmPool.Client.ClientMessage
                    {
                        Role = m.Role,
                        Content = m.Content,
                        ContentItems = m.ContentItems
                    }).ToList();

                    var chatOptions = new LY.LlmPool.Client.ChatOptions
                    {
                        Temperature = Config?.Temperature,
                        MaxTokens = Config?.MaxTokens,
                        TopP = null
                    };

                    streamingResult = client.ChatStreamAsync(model!, msgs, null, toolObjects2, chatOptions);
                }
            }

            await foreach (var chunk in streamingResult)
            {
                assistantMessage.Content += chunk;
                StateHasChanged();
                await ScrollToBottom();
            }
        }
        finally
        {
            assistantMessage.IsStreaming = false;
            StateHasChanged();
        }
    }

        

    private void AddAssistantMessage(string content)
    {
        _messages.Add(new ChatMessage
        {
            Role = "assistant",
            Content = content,
            Timestamp = DateTime.Now
        });
    }

    private void AddErrorMessage(string error)
    {
        _messages.Add(new ChatMessage
        {
            Role = "assistant",
            Content = $"错误: {error}",
            Timestamp = DateTime.Now
        });
    }

    // 图片处理方法
    private bool OnBeforeUpload(UploadFileItem file)
    {
        // 限制图片大小 (5MB)
        if (file.Size > 5 * 1024 * 1024)
        {
            MessageService.Error($"图片 {file.FileName} 超过5MB限制");
            return false;
        }

        // 限制图片数量
        if (_selectedImages.Count >= 5)
        {
            MessageService.Error("最多只能上传5张图片");
            return false;
        }

        return true;
    }

    private async Task OnImageUpload(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            try
            {
                // 限制文件大小 (10MB)
                if (file.Size > 10 * 1024 * 1024)
                {
                    MessageService.Warning($"文件 {file.Name} 太大，请选择小于 10MB 的图片");
                    continue;
                }

                // 使用 Stream 读取文件内容
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                var buffer = new byte[stream.Length];
                await stream.ReadAsync(buffer, 0, (int)stream.Length);
                
                var base64String = Convert.ToBase64String(buffer);
                var dataUrl = $"data:{file.ContentType};base64,{base64String}";
                
                var selectedImage = new SelectedImage
                {
                    FileName = file.Name,
                    DataUrl = dataUrl,
                    Data = buffer,
                    MimeType = file.ContentType
                };

                _selectedImages.Add(selectedImage);
            }
            catch (Exception ex)
            {
                MessageService.Error($"图片上传失败: {ex.Message}");
            }
        }
        StateHasChanged();
    }

    private void RemoveImage(SelectedImage image)
    {
        _selectedImages.Remove(image);
        StateHasChanged();
    }

    // Anthropic API 调用方法
    private async Task SendAnthropicApiMessage()
    {
        try
        {
            if (_useStreaming)
            {
                await HandleAnthropicStreamingResponse();
            }
            else
            {
                await HandleAnthropicNormalResponse();
            }
        }
        catch (Exception ex)
        {
            MessageService.Error($"Anthropic API 调用失败: {ex.Message}");
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleAnthropicNormalResponse()
    {
        ChatResponse response;
        
        if (Config != null)
        {
            response = await ChatClientService.SendAnthropicMessageAsync(Config, _messages);
        }
        else if (Endpoint != null)
        {
            response = await ChatClientService.SendAnthropicMessageAsync(Endpoint, _messages);
        }
        else
        {
            throw new Exception("未配置模型或终端点");
        }

        if (response.Status == "success")
        {
            AddAssistantMessage(response.Message);
        }
        else
        {
            throw new Exception(response.Message);
        }
    }

    private async Task HandleAnthropicStreamingResponse()
    {
        var assistantMessage = new ChatMessage
        {
            Role = "assistant",
            Content = "",
            IsStreaming = true,
            Timestamp = DateTime.Now
        };
        _messages.Add(assistantMessage);
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            IAsyncEnumerable<string> streamingResults;
            
            if (Config != null)
            {
                streamingResults = ChatClientService.SendAnthropicStreamingMessageAsync(Config, _messages);
            }
            else if (Endpoint != null)
            {
                streamingResults = ChatClientService.SendAnthropicStreamingMessageAsync(Endpoint, _messages);
            }
            else
            {
                throw new Exception("未配置模型或终端点");
            }

            await foreach (var chunk in streamingResults)
            {
                assistantMessage.Content += chunk;
                StateHasChanged();
                await ScrollToBottom();
            }
        }
        finally
        {
            assistantMessage.IsStreaming = false;
            StateHasChanged();
        }
    }

    // 示例工具方法：在模拟工具调用时，会通过 ChatClientService 注册为 Kernel 插件
    [KernelFunction("echo")]
    [Description("回显输入的文本")]
    public string Echo([Description("要回显的内容")] string text)
    {
        return text;
    }

    [KernelFunction("get_time")]
    [Description("返回当前时间，可选格式化")]
    public string GetTime([Description(".NET 日期时间格式化字符串")] string? format = "yyyy-MM-dd HH:mm:ss")
    {
        var fmt = string.IsNullOrWhiteSpace(format) ? "yyyy-MM-dd HH:mm:ss" : format;
        return DateTime.Now.ToString(fmt);
    }

    [KernelFunction("sum")]
    [Description("计算两个整数的和")]
    public int Sum(
        [Description("加数 A")] int a,
        [Description("加数 B")] int b)
    {
        return a + b;
    }
}

